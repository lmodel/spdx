             <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/firmware>
             <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/framework>
             <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/install>
             <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/library>
             <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/manifest>
             <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/model>
             <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/module>
             <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/operatingSystem>
             <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/other>
             <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/patch>
             <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/platform>
             <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/requirement>
             <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/source>
             <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/specification>
             <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/test> ] * ;
          spdx_software:attributionText @linkml:String * ;
          spdx_software:contentIdentifier @<ContentIdentifier> * ;
          spdx_software:copyrightText @linkml:String ? ;
          spdx_software:primaryPurpose [ <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/application>
             <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/archive>
             <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/bom>
             <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/configuration>
             <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/container>
             <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/data>
             <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/device>
             <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/deviceDriver>
             <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/diskImage>
             <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/documentation>
             <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/evidence>
             <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/executable>
             <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/file>
             <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/filesystemImage>
             <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/firmware>
             <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/framework>
             <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/install>
             <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/library>
             <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/manifest>
             <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/model>
             <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/module>
             <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/operatingSystem>
             <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/other>
             <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/patch>
             <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/platform>
             <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/requirement>
             <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/source>
             <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/specification>
             <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/test> ] ?
       ) ;
       rdf:type [ spdx_software:SoftwareArtifact ]
    )
}

<SpdxDocument> CLOSED {
    (  $<SpdxDocument_tes> (  &<ElementCollection_tes> ;
          rdf:type [ spdx_core:ElementCollection ] ? ;
          spdx_core:dataLicense @<AnyLicenseInfo> ? ;
          spdx_core:import @<ExternalMap> * ;
          spdx_core:namespaceMap @<NamespaceMap> *
       ) ;
       rdf:type [ spdx_core:SpdxDocument ]
    )
}

<SsvcVulnAssessmentRelationship> CLOSED {
    (  $<SsvcVulnAssessmentRelationship_tes> (  &<VulnAssessmentRelationship_tes> ;
          rdf:type [ spdx_security:VulnAssessmentRelationship ] ? ;
          spdx_security:decisionType [ <https://spdx.org/rdf/3.0.1/terms/Security/SsvcDecisionType/act>
             <https://spdx.org/rdf/3.0.1/terms/Security/SsvcDecisionType/attend>
             <https://spdx.org/rdf/3.0.1/terms/Security/SsvcDecisionType/track>
             <https://spdx.org/rdf/3.0.1/terms/Security/SsvcDecisionType/trackStar> ]
       ) ;
       rdf:type [ spdx_security:SsvcVulnAssessmentRelationship ]
    )
}

<Tool> CLOSED {
    (  $<Tool_tes> (  &<Element_tes> ;
          rdf:type [ spdx_core:Element ] ?
       ) ;
       rdf:type [ spdx_core:Tool ]
    )
}

<VexAffectedVulnAssessmentRelationship> CLOSED {
    (  $<VexAffectedVulnAssessmentRelationship_tes> (  &<VexVulnAssessmentRelationship_tes> ;
          rdf:type [ spdx_security:VexVulnAssessmentRelationship ] ? ;
          spdx_security:actionStatement @linkml:String ;
          spdx_security:actionStatementTime @<DateTimeStamp> ?
       ) ;
       rdf:type [ spdx_security:VexAffectedVulnAssessmentRelationship ]
    )
}

<VexFixedVulnAssessmentRelationship> CLOSED {
    (  $<VexFixedVulnAssessmentRelationship_tes> (  &<VexVulnAssessmentRelationship_tes> ;
          rdf:type [ spdx_security:VexVulnAssessmentRelationship ] ?
       ) ;
       rdf:type [ spdx_security:VexFixedVulnAssessmentRelationship ]
    )
}

<VexNotAffectedVulnAssessmentRelationship> CLOSED {
    (  $<VexNotAffectedVulnAssessmentRelationship_tes> (  &<VexVulnAssessmentRelationship_tes> ;
          rdf:type [ spdx_security:VexVulnAssessmentRelationship ] ? ;
          spdx_security:impactStatement @linkml:String ? ;
          spdx_security:impactStatementTime @<DateTimeStamp> ? ;
          spdx_security:justificationType [ <https://spdx.org/rdf/3.0.1/terms/Security/VexJustificationType/componentNotPresent>
             <https://spdx.org/rdf/3.0.1/terms/Security/VexJustificationType/inlineMitigationsAlreadyExist>
             <https://spdx.org/rdf/3.0.1/terms/Security/VexJustificationType/vulnerableCodeCannotBeControlledByAdversary>
             <https://spdx.org/rdf/3.0.1/terms/Security/VexJustificationType/vulnerableCodeNotInExecutePath>
             <https://spdx.org/rdf/3.0.1/terms/Security/VexJustificationType/vulnerableCodeNotPresent> ] ?
       ) ;
       rdf:type [ spdx_security:VexNotAffectedVulnAssessmentRelationship ]
    )
}

<VexUnderInvestigationVulnAssessmentRelationship> CLOSED {
    (  $<VexUnderInvestigationVulnAssessmentRelationship_tes> (  &<VexVulnAssessmentRelationship_tes> ;
          rdf:type [ spdx_security:VexVulnAssessmentRelationship ] ?
       ) ;
       rdf:type [ spdx_security:VexUnderInvestigationVulnAssessmentRelationship ]
    )
}

<VexVulnAssessmentRelationship>  (
    @<VexAffectedVulnAssessmentRelationship> OR @<VexFixedVulnAssessmentRelationship> OR
    @<VexNotAffectedVulnAssessmentRelationship> OR @<VexUnderInvestigationVulnAssessmentRelationship>
)

<VexVulnAssessmentRelationship_struct> {
    (  $<VexVulnAssessmentRelationship_tes> (  &<VulnAssessmentRelationship_tes> ;
          rdf:type [ spdx_security:VulnAssessmentRelationship ] ? ;
          spdx_security:statusNotes @linkml:String ? ;
          spdx_security:vexVersion @linkml:String ?
       ) ;
       rdf:type [ spdx_security:VexVulnAssessmentRelationship ]
    )
}

<VulnAssessmentRelationship>  (
    @<CvssV2VulnAssessmentRelationship> OR @<CvssV3VulnAssessmentRelationship> OR @<CvssV4VulnAssessmentRelationship> OR
    @<EpssVulnAssessmentRelationship> OR @<ExploitCatalogVulnAssessmentRelationship> OR @<SsvcVulnAssessmentRelationship> OR
    @<VexVulnAssessmentRelationship>
)

<VulnAssessmentRelationship_struct> {
    (  $<VulnAssessmentRelationship_tes> (  &<Relationship_tes> ;
          rdf:type [ spdx_core:Relationship ] ? ;
          spdx_security:assessedElement @<SoftwareArtifact> ? ;
          spdx_security:modifiedTime @<DateTimeStamp> ? ;
          spdx_security:publishedTime @<DateTimeStamp> ? ;
          spdx_core:suppliedBy @<Agent> ? ;
          spdx_security:withdrawnTime @<DateTimeStamp> ?
       ) ;
       rdf:type [ spdx_security:VulnAssessmentRelationship ]
    )
}

<Vulnerability> CLOSED {
    (  $<Vulnerability_tes> (  &<Artifact_tes> ;
          rdf:type [ spdx_core:Artifact ] ? ;
          spdx_security:modifiedTime @<DateTimeStamp> ? ;
          spdx_security:publishedTime @<DateTimeStamp> ? ;
          spdx_security:withdrawnTime @<DateTimeStamp> ?
       ) ;
       rdf:type [ spdx_security:Vulnerability ]
    )
}

<WithAdditionOperator> CLOSED {
    (  $<WithAdditionOperator_tes> (  &<AnyLicenseInfo_tes> ;
          rdf:type [ spdx_simple_licensing:AnyLicenseInfo ] ? ;
          spdx_expanded_licensing:subjectAddition @<LicenseAddition> ;
          spdx_expanded_licensing:subjectExtendableLicense @<ExtendableLicense>
       ) ;
       rdf:type [ spdx_expanded_licensing:WithAdditionOperator ]
    )
}
