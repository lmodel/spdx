# metamodel_version: 1.12.0
# version: 3.0.1
BASE <https://w3id.org/lmodel/spdx/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX spdx_core: <https://spdx.org/rdf/3.0.1/terms/Core/>
PREFIX spdx_software: <https://spdx.org/rdf/3.0.1/terms/Software/>
PREFIX spdx_security: <https://spdx.org/rdf/3.0.1/terms/Security/>
PREFIX spdx_simple_licensing: <https://spdx.org/rdf/3.0.1/terms/SimpleLicensing/>
PREFIX spdx_expanded_licensing: <https://spdx.org/rdf/3.0.1/terms/ExpandedLicensing/>
PREFIX spdx_ai: <https://spdx.org/rdf/3.0.1/terms/AI/>
PREFIX spdx_dataset: <https://spdx.org/rdf/3.0.1/terms/Dataset/>
PREFIX spdx_build: <https://spdx.org/rdf/3.0.1/terms/Build/>
PREFIX spdx_extension: <https://spdx.org/rdf/3.0.1/terms/Extension/>
PREFIX linkml: <https://w3id.org/linkml/>


linkml:String xsd:string

linkml:Integer xsd:integer

linkml:Boolean xsd:boolean

linkml:Float xsd:float

linkml:Double xsd:double

linkml:Decimal xsd:decimal

linkml:Time xsd:time

linkml:Date xsd:date

linkml:Datetime xsd:dateTime

linkml:DateOrDatetime linkml:DateOrDatetime

linkml:Uriorcurie IRI

linkml:Curie xsd:string

linkml:Uri IRI

linkml:Ncname xsd:string

linkml:Objectidentifier IRI

linkml:Nodeidentifier NONLITERAL

linkml:Jsonpointer xsd:string

linkml:Jsonpath xsd:string

linkml:Sparqlpath xsd:string

<DateTimeStamp> xsd:dateTimeStamp

<MediaType> xsd:string

<Semver> xsd:string

<PositiveInteger> xsd:positiveInteger

<NonNegativeInteger> xsd:nonNegativeInteger

<Agent>  (
    CLOSED {
       (  $<Agent_tes> (  &<Element_tes> ;
             rdf:type [ spdx_core:Element ] ?
          ) ;
          rdf:type [ spdx_core:Agent ]
       )
    } OR @<Organization> OR @<Person> OR @<SoftwareAgent>
)

<AIPackage> CLOSED {
    (  $<AIPackage_tes> (  &<Package_tes> ;
          rdf:type [ spdx_software:Package ] ? ;
          spdx_ai:autonomyType [ <https://spdx.org/rdf/3.0.1/terms/Core/PresenceType/no>
             <https://spdx.org/rdf/3.0.1/terms/Core/PresenceType/noAssertion>
             <https://spdx.org/rdf/3.0.1/terms/Core/PresenceType/yes> ] ? ;
          spdx_ai:domain @linkml:String * ;
          spdx_ai:energyConsumption @<EnergyConsumption> ? ;
          spdx_ai:hyperparameter @<DictionaryEntry> * ;
          spdx_ai:informationAboutApplication @linkml:String ? ;
          spdx_ai:informationAboutTraining @linkml:String ? ;
          spdx_ai:limitation @linkml:String ? ;
          spdx_ai:metric @<DictionaryEntry> * ;
          spdx_ai:metricDecisionThreshold @<DictionaryEntry> * ;
          spdx_ai:modelDataPreprocessing @linkml:String * ;
          spdx_ai:modelExplainability @linkml:String * ;
          spdx_ai:safetyRiskAssessment [ <https://spdx.org/rdf/3.0.1/terms/AI/SafetyRiskAssessmentType/high>
             <https://spdx.org/rdf/3.0.1/terms/AI/SafetyRiskAssessmentType/low>
             <https://spdx.org/rdf/3.0.1/terms/AI/SafetyRiskAssessmentType/medium>
             <https://spdx.org/rdf/3.0.1/terms/AI/SafetyRiskAssessmentType/serious> ] ? ;
          spdx_ai:standardCompliance @linkml:String * ;
          spdx_ai:typeOfModel @linkml:String * ;
          spdx_ai:useSensitivePersonalInformation [ <https://spdx.org/rdf/3.0.1/terms/Core/PresenceType/no>
             <https://spdx.org/rdf/3.0.1/terms/Core/PresenceType/noAssertion>
             <https://spdx.org/rdf/3.0.1/terms/Core/PresenceType/yes> ] ?
       ) ;
       rdf:type [ spdx_ai:AIPackage ]
    )
}

<Annotation> CLOSED {
    (  $<Annotation_tes> (  &<Element_tes> ;
          rdf:type [ spdx_core:Element ] ? ;
          spdx_core:annotationType [ <https://spdx.org/rdf/3.0.1/terms/Core/AnnotationType/other>
             <https://spdx.org/rdf/3.0.1/terms/Core/AnnotationType/review> ] ;
          spdx_core:contentType @<MediaType> ? ;
          spdx_core:statement @linkml:String ? ;
          spdx_core:subject @<Element>
       ) ;
       rdf:type [ spdx_core:Annotation ]
    )
}

<AnyLicenseInfo>  (
    @<ConjunctiveLicenseSet> OR @<DisjunctiveLicenseSet> OR @<ExtendableLicense> OR @<IndividualLicensingInfo> OR
    @<LicenseExpression> OR @<WithAdditionOperator>
)

<AnyLicenseInfo_struct> {
    (  $<AnyLicenseInfo_tes> (  &<Element_tes> ;
          rdf:type [ spdx_core:Element ] ?
       ) ;
       rdf:type [ spdx_simple_licensing:AnyLicenseInfo ]
    )
}

<Artifact>  (
    @<SoftwareArtifact> OR @<Vulnerability>
)

<Artifact_struct> {
    (  $<Artifact_tes> (  &<Element_tes> ;
          rdf:type [ spdx_core:Element ] ? ;
          spdx_core:builtTime @<DateTimeStamp> ? ;
          spdx_core:originatedBy @<Agent> * ;
          spdx_core:releaseTime @<DateTimeStamp> ? ;
          spdx_core:standardName @linkml:String * ;
          spdx_core:suppliedBy @<Agent> ? ;
          spdx_core:supportLevel [ <https://spdx.org/rdf/3.0.1/terms/Core/SupportType/deployed>
             <https://spdx.org/rdf/3.0.1/terms/Core/SupportType/development>
             <https://spdx.org/rdf/3.0.1/terms/Core/SupportType/endOfSupport>
             <https://spdx.org/rdf/3.0.1/terms/Core/SupportType/limitedSupport>
             <https://spdx.org/rdf/3.0.1/terms/Core/SupportType/noAssertion>
             <https://spdx.org/rdf/3.0.1/terms/Core/SupportType/noSupport>
             <https://spdx.org/rdf/3.0.1/terms/Core/SupportType/support> ] * ;
          spdx_core:validUntilTime @<DateTimeStamp> ?
       ) ;
       rdf:type [ spdx_core:Artifact ]
    )
}

<Bom>  (
    CLOSED {
       (  $<Bom_tes> (  &<Bundle_tes> ;
             rdf:type [ spdx_core:Bundle ] ?
          ) ;
          rdf:type [ spdx_core:Bom ]
       )
    } OR @<Sbom>
)

<Build> CLOSED {
    (  $<Build_tes> (  &<Element_tes> ;
          rdf:type [ spdx_core:Element ] ? ;
          spdx_build:buildEndTime @<DateTimeStamp> ? ;
          spdx_build:buildId @linkml:String ? ;
          spdx_build:buildStartTime @<DateTimeStamp> ? ;
          spdx_build:buildType @linkml:Uri ;
          spdx_build:configSourceDigest @<Hash> * ;
          spdx_build:configSourceEntrypoint @linkml:String * ;
          spdx_build:configSourceUri @linkml:Uri * ;
          spdx_build:environment @<DictionaryEntry> * ;
          spdx_build:parameter @<DictionaryEntry> *
       ) ;
       rdf:type [ spdx_build:Build ]
    )
}

<Bundle>  (
    CLOSED {
       (  $<Bundle_tes> (  &<ElementCollection_tes> ;
             rdf:type [ spdx_core:ElementCollection ] ? ;
             spdx_core:context @linkml:String ?
          ) ;
          rdf:type [ spdx_core:Bundle ]
       )
    } OR @<Bom>
)

<CdxPropertiesExtension> CLOSED {
    (  $<CdxPropertiesExtension_tes> (  &<Extension_tes> ;
          rdf:type [ spdx_extension:Extension ] ? ;
          spdx_extension:cdxProperty @<CdxPropertyEntry> +
       ) ;
       rdf:type [ spdx_extension:CdxPropertiesExtension ] ?
    )
}

<CdxPropertyEntry> CLOSED {
    (  $<CdxPropertyEntry_tes> (  rdf:type @linkml:Uriorcurie ? ;
          spdx_extension:cdxPropName @linkml:String ;
          spdx_extension:cdxPropValue @linkml:String ?
       ) ;
       rdf:type [ spdx_extension:CdxPropertyEntry ] ?
    )
}

<ConjunctiveLicenseSet> CLOSED {
    (  $<ConjunctiveLicenseSet_tes> (  &<AnyLicenseInfo_tes> ;
          rdf:type [ spdx_simple_licensing:AnyLicenseInfo ] ? ;
          spdx_expanded_licensing:member @<AnyLicenseInfo> +
       ) ;
       rdf:type [ spdx_expanded_licensing:ConjunctiveLicenseSet ]
    )
}

<ContentIdentifier> CLOSED {
    (  $<ContentIdentifier_tes> (  &<IntegrityMethod_tes> ;
          rdf:type [ spdx_core:IntegrityMethod ] ? ;
          spdx_software:contentIdentifierType [ <https://spdx.org/rdf/3.0.1/terms/Software/ContentIdentifierType/gitoid>
             <https://spdx.org/rdf/3.0.1/terms/Software/ContentIdentifierType/swhid> ] ;
          spdx_software:contentIdentifierValue @linkml:Uri
       ) ;
       rdf:type [ spdx_software:ContentIdentifier ] ?
    )
}

<CreationInfo> CLOSED {
    (  $<CreationInfo_tes> (  rdf:type @linkml:Uriorcurie ? ;
          spdx_core:comment @linkml:String ? ;
          spdx_core:created @<DateTimeStamp> ;
          spdx_core:createdBy @<Agent> + ;
          spdx_core:createdUsing @<Tool> * ;
          spdx_core:specVersion @<Semver>
       ) ;
       rdf:type [ spdx_core:CreationInfo ] ?
    )
}

<CustomLicense> CLOSED {
    (  $<CustomLicense_tes> (  &<License_tes> ;
          rdf:type [ spdx_expanded_licensing:License ] ?
       ) ;
       rdf:type [ spdx_expanded_licensing:CustomLicense ]
    )
}

<CustomLicenseAddition> CLOSED {
    (  $<CustomLicenseAddition_tes> (  &<LicenseAddition_tes> ;
          rdf:type [ spdx_expanded_licensing:LicenseAddition ] ?
       ) ;
       rdf:type [ spdx_expanded_licensing:CustomLicenseAddition ]
    )
}

<CvssV2VulnAssessmentRelationship> CLOSED {
    (  $<CvssV2VulnAssessmentRelationship_tes> (  &<VulnAssessmentRelationship_tes> ;
          rdf:type [ spdx_security:VulnAssessmentRelationship ] ? ;
          spdx_security:score @linkml:Decimal ;
          spdx_security:vectorString @linkml:String
       ) ;
       rdf:type [ spdx_security:CvssV2VulnAssessmentRelationship ]
    )
}

<CvssV3VulnAssessmentRelationship> CLOSED {
    (  $<CvssV3VulnAssessmentRelationship_tes> (  &<VulnAssessmentRelationship_tes> ;
          rdf:type [ spdx_security:VulnAssessmentRelationship ] ? ;
          spdx_security:score @linkml:Decimal ;
          spdx_security:severity [ <https://spdx.org/rdf/3.0.1/terms/Security/CvssSeverityType/critical>
             <https://spdx.org/rdf/3.0.1/terms/Security/CvssSeverityType/high>
             <https://spdx.org/rdf/3.0.1/terms/Security/CvssSeverityType/low>
             <https://spdx.org/rdf/3.0.1/terms/Security/CvssSeverityType/medium>
             <https://spdx.org/rdf/3.0.1/terms/Security/CvssSeverityType/none> ] ;
          spdx_security:vectorString @linkml:String
       ) ;
       rdf:type [ spdx_security:CvssV3VulnAssessmentRelationship ]
    )
}

<CvssV4VulnAssessmentRelationship> CLOSED {
    (  $<CvssV4VulnAssessmentRelationship_tes> (  &<VulnAssessmentRelationship_tes> ;
          rdf:type [ spdx_security:VulnAssessmentRelationship ] ? ;
          spdx_security:score @linkml:Decimal ;
          spdx_security:severity [ <https://spdx.org/rdf/3.0.1/terms/Security/CvssSeverityType/critical>
             <https://spdx.org/rdf/3.0.1/terms/Security/CvssSeverityType/high>
             <https://spdx.org/rdf/3.0.1/terms/Security/CvssSeverityType/low>
             <https://spdx.org/rdf/3.0.1/terms/Security/CvssSeverityType/medium>
             <https://spdx.org/rdf/3.0.1/terms/Security/CvssSeverityType/none> ] ;
          spdx_security:vectorString @linkml:String
       ) ;
       rdf:type [ spdx_security:CvssV4VulnAssessmentRelationship ]
    )
}

<DatasetPackage> CLOSED {
    (  $<DatasetPackage_tes> (  &<Package_tes> ;
          rdf:type [ spdx_software:Package ] ? ;
          spdx_dataset:anonymizationMethodUsed @linkml:String * ;
          spdx_dataset:confidentialityLevel [ <https://spdx.org/rdf/3.0.1/terms/Dataset/ConfidentialityLevelType/amber>
             <https://spdx.org/rdf/3.0.1/terms/Dataset/ConfidentialityLevelType/clear>
             <https://spdx.org/rdf/3.0.1/terms/Dataset/ConfidentialityLevelType/green>
             <https://spdx.org/rdf/3.0.1/terms/Dataset/ConfidentialityLevelType/red> ] ? ;
          spdx_dataset:dataCollectionProcess @linkml:String ? ;
          spdx_dataset:dataPreprocessing @linkml:String * ;
          spdx_dataset:datasetAvailability [ <https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetAvailabilityType/clickthrough>
             <https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetAvailabilityType/directDownload>
             <https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetAvailabilityType/query>
             <https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetAvailabilityType/registration>
             <https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetAvailabilityType/scrapingScript> ] ? ;
          spdx_dataset:datasetNoise @linkml:String ? ;
          spdx_dataset:datasetSize @<NonNegativeInteger> ? ;
          spdx_dataset:datasetType [ <https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetType/audio>
             <https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetType/categorical>
             <https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetType/graph>
             <https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetType/image>
             <https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetType/noAssertion>
             <https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetType/numeric>
             <https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetType/other>
             <https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetType/sensor>
             <https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetType/structured>
             <https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetType/syntactic>
             <https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetType/text>
             <https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetType/timeseries>
             <https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetType/timestamp>
             <https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetType/video> ] + ;
          spdx_dataset:datasetUpdateMechanism @linkml:String ? ;
          spdx_dataset:hasSensitivePersonalInformation [ <https://spdx.org/rdf/3.0.1/terms/Core/PresenceType/no>
             <https://spdx.org/rdf/3.0.1/terms/Core/PresenceType/noAssertion>
             <https://spdx.org/rdf/3.0.1/terms/Core/PresenceType/yes> ] ? ;
          spdx_dataset:intendedUse @linkml:String ? ;
          spdx_dataset:knownBias @linkml:String * ;
          spdx_dataset:sensor @<DictionaryEntry> *
       ) ;
       rdf:type [ spdx_dataset:DatasetPackage ]
    )
}

<DictionaryEntry> CLOSED {
    (  $<DictionaryEntry_tes> (  rdf:type @linkml:Uriorcurie ? ;
          spdx_core:key @linkml:String ;
          spdx_core:value @linkml:String ?
       ) ;
       rdf:type [ spdx_core:DictionaryEntry ] ?
    )
}

<DisjunctiveLicenseSet> CLOSED {
    (  $<DisjunctiveLicenseSet_tes> (  &<AnyLicenseInfo_tes> ;
          rdf:type [ spdx_simple_licensing:AnyLicenseInfo ] ? ;
          spdx_expanded_licensing:member @<AnyLicenseInfo> +
       ) ;
       rdf:type [ spdx_expanded_licensing:DisjunctiveLicenseSet ]
    )
}

<Element>  (
    @<Agent> OR @<Annotation> OR @<AnyLicenseInfo> OR @<Artifact> OR @<Build> OR @<ElementCollection> OR @<IndividualElement> OR
    @<LicenseAddition> OR @<Relationship> OR @<SimpleLicensingText> OR @<Tool>
)

<Element_struct> {
    (  $<Element_tes> (  rdf:type @linkml:Uriorcurie ? ;
          spdx_core:comment @linkml:String ? ;
          spdx_core:creationInfo @<CreationInfo> ;
          spdx_core:description @linkml:String ? ;
          spdx_core:extension @<Extension> * ;
          spdx_core:externalIdentifier @<ExternalIdentifier> * ;
          spdx_core:externalRef @<ExternalRef> * ;
          spdx_core:name @linkml:String ? ;
          spdx_core:summary @linkml:String ? ;
          spdx_core:verifiedUsing @<IntegrityMethod> *
       ) ;
       rdf:type [ spdx_core:Element ]
    )
}

<ElementCollection>  (
    @<Bundle> OR @<SpdxDocument>
)

<ElementCollection_struct> {
    (  $<ElementCollection_tes> (  &<Element_tes> ;
          rdf:type [ spdx_core:Element ] ? ;
          spdx_core:element @<Element> * ;
          spdx_core:profileConformance [ <https://spdx.org/rdf/3.0.1/terms/Core/ProfileIdentifierType/ai>
             <https://spdx.org/rdf/3.0.1/terms/Core/ProfileIdentifierType/build>
             <https://spdx.org/rdf/3.0.1/terms/Core/ProfileIdentifierType/core>
             <https://spdx.org/rdf/3.0.1/terms/Core/ProfileIdentifierType/dataset>
             <https://spdx.org/rdf/3.0.1/terms/Core/ProfileIdentifierType/expandedLicensing>
             <https://spdx.org/rdf/3.0.1/terms/Core/ProfileIdentifierType/extension>
             <https://spdx.org/rdf/3.0.1/terms/Core/ProfileIdentifierType/lite>
             <https://spdx.org/rdf/3.0.1/terms/Core/ProfileIdentifierType/security>
             <https://spdx.org/rdf/3.0.1/terms/Core/ProfileIdentifierType/simpleLicensing>
             <https://spdx.org/rdf/3.0.1/terms/Core/ProfileIdentifierType/software> ] * ;
          spdx_core:rootElement @<Element> *
       ) ;
       rdf:type [ spdx_core:ElementCollection ]
    )
}

<EnergyConsumption> CLOSED {
    (  $<EnergyConsumption_tes> (  rdf:type @linkml:Uriorcurie ? ;
          spdx_ai:finetuningEnergyConsumption @<EnergyConsumptionDescription> * ;
          spdx_ai:inferenceEnergyConsumption @<EnergyConsumptionDescription> * ;
          spdx_ai:trainingEnergyConsumption @<EnergyConsumptionDescription> *
       ) ;
       rdf:type [ spdx_ai:EnergyConsumption ] ?
    )
}

<EnergyConsumptionDescription> CLOSED {
    (  $<EnergyConsumptionDescription_tes> (  rdf:type @linkml:Uriorcurie ? ;
          spdx_ai:energyQuantity @linkml:Decimal ;
          spdx_ai:energyUnit [ <https://spdx.org/rdf/3.0.1/terms/AI/EnergyUnitType/kilowattHour>
             <https://spdx.org/rdf/3.0.1/terms/AI/EnergyUnitType/megajoule>
             <https://spdx.org/rdf/3.0.1/terms/AI/EnergyUnitType/other> ]
       ) ;
       rdf:type [ spdx_ai:EnergyConsumptionDescription ] ?
    )
}

<EpssVulnAssessmentRelationship> CLOSED {
    (  $<EpssVulnAssessmentRelationship_tes> (  &<VulnAssessmentRelationship_tes> ;
          rdf:type [ spdx_security:VulnAssessmentRelationship ] ? ;
          spdx_security:percentile @linkml:Decimal ;
          spdx_security:probability @linkml:Decimal
       ) ;
       rdf:type [ spdx_security:EpssVulnAssessmentRelationship ]
    )
}

<ExploitCatalogVulnAssessmentRelationship> CLOSED {
    (  $<ExploitCatalogVulnAssessmentRelationship_tes> (  &<VulnAssessmentRelationship_tes> ;
          rdf:type [ spdx_security:VulnAssessmentRelationship ] ? ;
          spdx_security:catalogType [ <https://spdx.org/rdf/3.0.1/terms/Security/ExploitCatalogType/kev>
             <https://spdx.org/rdf/3.0.1/terms/Security/ExploitCatalogType/other> ] ;
          spdx_security:exploited @linkml:Boolean ;
          spdx_security:locator @linkml:Uri
       ) ;
       rdf:type [ spdx_security:ExploitCatalogVulnAssessmentRelationship ]
    )
}

<ExtendableLicense>  (
    @<License> OR @<OrLaterOperator>
)

<ExtendableLicense_struct> {
    (  $<ExtendableLicense_tes> (  &<AnyLicenseInfo_tes> ;
          rdf:type [ spdx_simple_licensing:AnyLicenseInfo ] ?
       ) ;
       rdf:type [ spdx_expanded_licensing:ExtendableLicense ]
    )
}

<Extension>  (
    {
       (  $<Extension_tes> rdf:type @linkml:Uriorcurie ? ;
          rdf:type [ spdx_extension:Extension ] ?
       )
    } OR @<CdxPropertiesExtension>
)

<ExternalIdentifier> CLOSED {
    (  $<ExternalIdentifier_tes> (  rdf:type @linkml:Uriorcurie ? ;
          spdx_core:comment @linkml:String ? ;
          spdx_core:externalIdentifierType [ <https://spdx.org/rdf/3.0.1/terms/Core/ExternalIdentifierType/cpe22>
             <https://spdx.org/rdf/3.0.1/terms/Core/ExternalIdentifierType/cpe23>
             <https://spdx.org/rdf/3.0.1/terms/Core/ExternalIdentifierType/cve>
             <https://spdx.org/rdf/3.0.1/terms/Core/ExternalIdentifierType/email>
             <https://spdx.org/rdf/3.0.1/terms/Core/ExternalIdentifierType/gitoid>
             <https://spdx.org/rdf/3.0.1/terms/Core/ExternalIdentifierType/other>
             <https://spdx.org/rdf/3.0.1/terms/Core/ExternalIdentifierType/packageUrl>
             <https://spdx.org/rdf/3.0.1/terms/Core/ExternalIdentifierType/securityOther>
             <https://spdx.org/rdf/3.0.1/terms/Core/ExternalIdentifierType/swhid>
             <https://spdx.org/rdf/3.0.1/terms/Core/ExternalIdentifierType/swid>
             <https://spdx.org/rdf/3.0.1/terms/Core/ExternalIdentifierType/urlScheme> ] ;
          spdx_core:identifier @linkml:String ;
          spdx_core:identifierLocator @linkml:Uri * ;
          spdx_core:issuingAuthority @linkml:String ?
       ) ;
       rdf:type [ spdx_core:ExternalIdentifier ] ?
    )
}

<ExternalMap> CLOSED {
    (  $<ExternalMap_tes> (  rdf:type @linkml:Uriorcurie ? ;
          spdx_core:definingArtifact @<Artifact> ? ;
          spdx_core:externalSpdxId @linkml:Uri ;
          spdx_core:locationHint @linkml:Uri ? ;
          spdx_core:verifiedUsing @<IntegrityMethod> *
       ) ;
       rdf:type [ spdx_core:ExternalMap ] ?
    )
}

<ExternalRef> CLOSED {
    (  $<ExternalRef_tes> (  rdf:type @linkml:Uriorcurie ? ;
          spdx_core:comment @linkml:String ? ;
          spdx_core:contentType @<MediaType> ? ;
          spdx_core:externalRefType [ <https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/altDownloadLocation>
             <https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/altWebPage>
             <https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/binaryArtifact>
             <https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/bower>
             <https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/buildMeta>
             <https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/buildSystem>
             <https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/certificationReport>
             <https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/chat>
             <https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/componentAnalysisReport>
             <https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/cwe>
