<https://spdx.org/rdf/3.0.1/terms/Core/RelationshipType/publishedBy> a owl:Class ;
    rdfs:label "publishedBy" ;
    rdfs:subClassOf core:RelationshipType ;
    skos:definition "Designates a `from` Vulnerability was made available for public use or reference by each `to` Agent." .

<https://spdx.org/rdf/3.0.1/terms/Core/RelationshipType/reportedBy> a owl:Class ;
    rdfs:label "reportedBy" ;
    rdfs:subClassOf core:RelationshipType ;
    skos:definition "Designates a `from` Vulnerability was first reported to a project, vendor, or tracking database for formal identification by each `to` Agent." .

<https://spdx.org/rdf/3.0.1/terms/Core/RelationshipType/republishedBy> a owl:Class ;
    rdfs:label "republishedBy" ;
    rdfs:subClassOf core:RelationshipType ;
    skos:definition "Designates a `from` Vulnerability's details were tracked, aggregated, and/or enriched to improve context (i.e. NVD) by each `to` Agent." .

<https://spdx.org/rdf/3.0.1/terms/Core/RelationshipType/serializedInArtifact> a owl:Class ;
    rdfs:label "serializedInArtifact" ;
    rdfs:subClassOf core:RelationshipType ;
    skos:definition "The `from` SpdxDocument can be found in a serialized form in each `to` Artifact." .

<https://spdx.org/rdf/3.0.1/terms/Core/RelationshipType/testedOn> a owl:Class ;
    rdfs:label "testedOn" ;
    rdfs:subClassOf core:RelationshipType ;
    skos:definition "The `from` Element has been tested on the `to` Element(s)." .

<https://spdx.org/rdf/3.0.1/terms/Core/RelationshipType/trainedOn> a owl:Class ;
    rdfs:label "trainedOn" ;
    rdfs:subClassOf core:RelationshipType ;
    skos:definition "The `from` Element has been trained on the `to` Element(s)." .

<https://spdx.org/rdf/3.0.1/terms/Core/RelationshipType/underInvestigationFor> a owl:Class ;
    rdfs:label "underInvestigationFor" ;
    rdfs:subClassOf core:RelationshipType ;
    skos:definition "The `from` Vulnerability impact is being investigated for each `to` Element. The use of the `underInvestigationFor` type is constrained to `VexUnderInvestigationVulnAssessmentRelationship` classed relationships." .

<https://spdx.org/rdf/3.0.1/terms/Core/RelationshipType/usesTool> a owl:Class ;
    rdfs:label "usesTool" ;
    rdfs:subClassOf core:RelationshipType ;
    skos:definition "The `from` Element uses each `to` Element as a tool, during a LifecycleScopeType period." .

<https://spdx.org/rdf/3.0.1/terms/Core/SupportType/deployed> a owl:Class ;
    rdfs:label "deployed" ;
    rdfs:subClassOf core:SupportType ;
    skos:definition "in addition to being supported by the supplier, the software is known to have been deployed and is in use.  For a software as a service provider, this implies the software is now available as a service." .

<https://spdx.org/rdf/3.0.1/terms/Core/SupportType/development> a owl:Class ;
    rdfs:label "development" ;
    rdfs:subClassOf core:SupportType ;
    skos:definition "the artifact is in active development and is not considered ready for formal support from the supplier." .

<https://spdx.org/rdf/3.0.1/terms/Core/SupportType/endOfSupport> a owl:Class ;
    rdfs:label "endOfSupport" ;
    rdfs:subClassOf core:SupportType ;
    skos:definition "there is a defined end of support for the artifact from the supplier.  This may also be referred to as end of life. There is a validUntilDate that can be used to signal when support ends for the artifact." .

<https://spdx.org/rdf/3.0.1/terms/Core/SupportType/limitedSupport> a owl:Class ;
    rdfs:label "limitedSupport" ;
    rdfs:subClassOf core:SupportType ;
    skos:definition "the artifact has been released, and there is limited support available from the supplier. There is a validUntilDate that can provide additional information about the duration of support." .

<https://spdx.org/rdf/3.0.1/terms/Core/SupportType/noAssertion> a owl:Class ;
    rdfs:label "noAssertion" ;
    rdfs:subClassOf core:SupportType ;
    skos:definition "no assertion about the type of support is made.   This is considered the default if no other support type is used." .

<https://spdx.org/rdf/3.0.1/terms/Core/SupportType/noSupport> a owl:Class ;
    rdfs:label "noSupport" ;
    rdfs:subClassOf core:SupportType ;
    skos:definition "there is no support for the artifact from the supplier, consumer assumes any support obligations." .

<https://spdx.org/rdf/3.0.1/terms/Core/SupportType/support> a owl:Class ;
    rdfs:label "support" ;
    rdfs:subClassOf core:SupportType ;
    skos:definition "the artifact has been released, and is supported from the supplier.   There is a validUntilDate that can provide additional information about the duration of support." .

spdx:CreationInfo a owl:Class ;
    rdfs:label "CreationInfo" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:createdUsing ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty spdx:specVersion ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:comment ],
        [ a owl:Restriction ;
            owl:allValuesFrom spdx:Tool ;
            owl:onProperty spdx:createdUsing ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:comment ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty spdx:createdBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spdx:comment ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:created ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty spdx:created ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:dateTime [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^\\d\\d\\d\\d-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$" ] ) ] ) ] ;
            owl:onProperty spdx:created ],
        [ a owl:Restriction ;
            owl:allValuesFrom spdx:Agent ;
            owl:onProperty spdx:createdBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$" ] ) ] ) ] ;
            owl:onProperty spdx:specVersion ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:specVersion ] ;
    skos:definition "Provides information about the creation of the Element." ;
    skos:exactMatch core:CreationInfo ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_node_kind "sh:BlankNodeOrIRI" .

<https://spdx.org/rdf/3.0.1/terms/Dataset/ConfidentialityLevelType/amber> a owl:Class ;
    rdfs:label "amber" ;
    rdfs:subClassOf dataset:ConfidentialityLevelType ;
    skos:definition "Data points in the dataset can be shared only with specific organizations and their clients on a need to know basis." .

<https://spdx.org/rdf/3.0.1/terms/Dataset/ConfidentialityLevelType/clear> a owl:Class ;
    rdfs:label "clear" ;
    rdfs:subClassOf dataset:ConfidentialityLevelType ;
    skos:definition "Dataset may be distributed freely, without restriction." .

<https://spdx.org/rdf/3.0.1/terms/Dataset/ConfidentialityLevelType/green> a owl:Class ;
    rdfs:label "green" ;
    rdfs:subClassOf dataset:ConfidentialityLevelType ;
    skos:definition "Dataset can be shared within a community of peers and partners." .

<https://spdx.org/rdf/3.0.1/terms/Dataset/ConfidentialityLevelType/red> a owl:Class ;
    rdfs:label "red" ;
    rdfs:subClassOf dataset:ConfidentialityLevelType ;
    skos:definition "Data points in the dataset are highly confidential and can only be shared with named recipients." .

<https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetAvailabilityType/clickthrough> a owl:Class ;
    rdfs:label "clickthrough" ;
    rdfs:subClassOf dataset:DatasetAvailabilityType ;
    skos:definition "the dataset is not publicly available and can only be accessed after affirmatively accepting terms on a clickthrough webpage." .

<https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetAvailabilityType/directDownload> a owl:Class ;
    rdfs:label "directDownload" ;
    rdfs:subClassOf dataset:DatasetAvailabilityType ;
    skos:definition "the dataset is publicly available and can be downloaded directly." .

<https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetAvailabilityType/query> a owl:Class ;
    rdfs:label "query" ;
    rdfs:subClassOf dataset:DatasetAvailabilityType ;
    skos:definition "the dataset is publicly available, but not all at once, and can only be accessed through queries which return parts of the dataset." .

<https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetAvailabilityType/registration> a owl:Class ;
    rdfs:label "registration" ;
    rdfs:subClassOf dataset:DatasetAvailabilityType ;
    skos:definition "the dataset is not publicly available and an email registration is required before accessing the dataset, although without an affirmative acceptance of terms." .

<https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetAvailabilityType/scrapingScript> a owl:Class ;
    rdfs:label "scrapingScript" ;
    rdfs:subClassOf dataset:DatasetAvailabilityType ;
    skos:definition "the dataset provider is not making available the underlying data and the dataset must be reassembled, typically using the provided script for scraping the data." .

<https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetType/audio> a owl:Class ;
    rdfs:label "audio" ;
    rdfs:subClassOf dataset:DatasetType ;
    skos:definition "data is audio based, such as a collection of music from the 80s." .

<https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetType/categorical> a owl:Class ;
    rdfs:label "categorical" ;
    rdfs:subClassOf dataset:DatasetType ;
    skos:definition "data that is classified into a discrete number of categories, such as the eye color of a population of people." .

<https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetType/graph> a owl:Class ;
    rdfs:label "graph" ;
    rdfs:subClassOf dataset:DatasetType ;
    skos:definition "data is in the form of a graph where entries are somehow related to each other through edges, such a social network of friends." .

<https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetType/image> a owl:Class ;
    rdfs:label "image" ;
    rdfs:subClassOf dataset:DatasetType ;
    skos:definition "data is a collection of images such as pictures of animals." .

<https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetType/noAssertion> a owl:Class ;
    rdfs:label "noAssertion" ;
    rdfs:subClassOf dataset:DatasetType ;
    skos:definition "data type is not known." .

<https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetType/numeric> a owl:Class ;
    rdfs:label "numeric" ;
    rdfs:subClassOf dataset:DatasetType ;
    skos:definition "data consists only of numeric entries." .

<https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetType/other> a owl:Class ;
    rdfs:label "other" ;
    rdfs:subClassOf dataset:DatasetType ;
    skos:definition "data is of a type not included in this list." .

<https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetType/sensor> a owl:Class ;
    rdfs:label "sensor" ;
    rdfs:subClassOf dataset:DatasetType ;
    skos:definition "data is recorded from a physical sensor, such as a thermometer reading or biometric device." .

<https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetType/structured> a owl:Class ;
    rdfs:label "structured" ;
    rdfs:subClassOf dataset:DatasetType ;
    skos:definition "data is stored in tabular format or retrieved from a relational database." .

<https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetType/syntactic> a owl:Class ;
    rdfs:label "syntactic" ;
    rdfs:subClassOf dataset:DatasetType ;
    skos:definition "data describes the syntax or semantics of a language or text, such as a parse tree used for natural language processing." .

<https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetType/text> a owl:Class ;
    rdfs:label "text" ;
    rdfs:subClassOf dataset:DatasetType ;
    skos:definition "data consists of unstructured text, such as a book, Wikipedia article (without images), or transcript." .

<https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetType/timeseries> a owl:Class ;
    rdfs:label "timeseries" ;
    rdfs:subClassOf dataset:DatasetType ;
    skos:definition "data is recorded in an ordered sequence of timestamped entries, such as the price of a stock over the course of a day." .

<https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetType/timestamp> a owl:Class ;
    rdfs:label "timestamp" ;
    rdfs:subClassOf dataset:DatasetType ;
    skos:definition "data is recorded with a timestamp for each entry, but not necessarily ordered or at specific intervals, such as when a taxi ride starts and ends." .

<https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetType/video> a owl:Class ;
    rdfs:label "video" ;
    rdfs:subClassOf dataset:DatasetType ;
    skos:definition "data is video based, such as a collection of movie clips featuring Tom Hanks." .

spdx:ElementCollection a owl:Class ;
    rdfs:label "ElementCollection" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom core:ProfileIdentifierType ;
            owl:onProperty spdx:profileConformance ],
        [ a owl:Restriction ;
            owl:allValuesFrom spdx:Element ;
            owl:onProperty spdx:element ],
        [ a owl:Restriction ;
            owl:allValuesFrom spdx:Element ;
            owl:onProperty spdx:rootElement ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:profileConformance ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:element ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:rootElement ],
        spdx:Element ;
    skos:definition "A collection of Elements, not necessarily with unifying context." ;
    skos:exactMatch core:ElementCollection ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_message "https://spdx.org/rdf/3.0.1/terms/Core/ElementCollection is an abstract class and should not be instantiated directly. Instantiate a subclass instead." ;
    spdx:shacl_node_kind "sh:IRI" ;
    spdx:shacl_not "{ sh:hasValue core:ElementCollection }" .

spdx:EnergyConsumption a owl:Class ;
    rdfs:label "EnergyConsumption" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom spdx:EnergyConsumptionDescription ;
            owl:onProperty spdx:finetuningEnergyConsumption ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:inferenceEnergyConsumption ],
        [ a owl:Restriction ;
            owl:allValuesFrom spdx:EnergyConsumptionDescription ;
            owl:onProperty spdx:inferenceEnergyConsumption ],
        [ a owl:Restriction ;
            owl:allValuesFrom spdx:EnergyConsumptionDescription ;
            owl:onProperty spdx:trainingEnergyConsumption ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:finetuningEnergyConsumption ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:trainingEnergyConsumption ] ;
    skos:definition """A class for describing the energy consumption incurred by an AI model in
different stages of its lifecycle.""" ;
    skos:exactMatch ai:EnergyConsumption ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_node_kind "sh:BlankNodeOrIRI" .

spdx:ExternalIdentifier a owl:Class ;
    rdfs:label "ExternalIdentifier" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:identifier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:externalIdentifierType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:issuingAuthority ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty spdx:identifierLocator ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spdx:identifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spdx:issuingAuthority ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:issuingAuthority ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:comment ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty spdx:externalIdentifierType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:comment ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:unionOf ( core:ExternalIdentifierType xsd:string ) ] ;
            owl:onProperty spdx:externalIdentifierType ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty spdx:identifier ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:identifierLocator ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spdx:comment ] ;
    skos:definition "A reference to a resource identifier defined outside the scope of SPDX-3.0 content that uniquely identifies an Element." ;
    skos:exactMatch core:ExternalIdentifier ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_node_kind "sh:BlankNodeOrIRI" .

spdx:ExternalMap a owl:Class ;
    rdfs:label "ExternalMap" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty spdx:externalSpdxId ],
        [ a owl:Restriction ;
            owl:allValuesFrom spdx:IntegrityMethod ;
            owl:onProperty spdx:verifiedUsing ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:locationHint ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:definingArtifact ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty spdx:externalSpdxId ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:verifiedUsing ],
        [ a owl:Restriction ;
            owl:allValuesFrom spdx:Artifact ;
            owl:onProperty spdx:definingArtifact ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty spdx:locationHint ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:externalSpdxId ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:locationHint ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:definingArtifact ] ;
    skos:definition """A map of Element identifiers that are used within an SpdxDocument but defined
external to that SpdxDocument.""" ;
    skos:exactMatch core:ExternalMap ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_node_kind "sh:BlankNodeOrIRI" .

spdx:ExternalRef a owl:Class ;
    rdfs:label "ExternalRef" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spdx:core_locator ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:contentType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:contentType ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:unionOf ( core:ExternalRefType xsd:string ) ] ;
            owl:onProperty spdx:externalRefType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:comment ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^[^\\/]+\\/[^\\/]+$" ] ) ] ) ] ;
            owl:onProperty spdx:contentType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:comment ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:core_locator ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:externalRefType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:externalRefType ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spdx:comment ] ;
    skos:definition "A reference to a resource outside the scope of SPDX-3.0 content related to an Element." ;
    skos:exactMatch core:ExternalRef ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_node_kind "sh:BlankNodeOrIRI" .

spdx:File a owl:Class ;
    rdfs:label "File" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^[^\\/]+\\/[^\\/]+$" ] ) ] ) ] ;
            owl:onProperty spdx:contentType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:fileKind ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:contentType ],
        [ a owl:Restriction ;
            owl:allValuesFrom software:FileKindType ;
            owl:onProperty spdx:fileKind ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:contentType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:fileKind ],
        spdx:SoftwareArtifact ;
    skos:definition "Refers to any object that stores content on a computer." ;
    skos:exactMatch software:File ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_node_kind "sh:IRI" .

spdx:Hash a owl:Class ;
    rdfs:label "Hash" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:unionOf ( core:HashAlgorithm xsd:string ) ] ;
            owl:onProperty spdx:algorithm ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty spdx:algorithm ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:hashValue ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:algorithm ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spdx:hashValue ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty spdx:hashValue ],
        spdx:IntegrityMethod ;
    skos:definition "A mathematically calculated representation of a grouping of data." ;
    skos:exactMatch core:Hash ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_node_kind "sh:BlankNodeOrIRI" .

spdx:NamespaceMap a owl:Class ;
    rdfs:label "NamespaceMap" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:prefix ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty spdx:prefix ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty spdx:namespace ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spdx:prefix ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:namespace ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty spdx:namespace ] ;
    skos:definition "A mapping between prefixes and namespace partial URIs." ;
    skos:exactMatch core:NamespaceMap ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_node_kind "sh:BlankNodeOrIRI" .

spdx:Package a owl:Class ;
    rdfs:label "Package" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spdx:sourceInfo ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:packageVersion ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:sourceInfo ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:packageVersion ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:packageUrl ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:sourceInfo ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:packageUrl ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty spdx:downloadLocation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:homePage ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty spdx:homePage ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:downloadLocation ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty spdx:packageUrl ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:downloadLocation ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spdx:packageVersion ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:homePage ],
        spdx:SoftwareArtifact ;
    skos:definition """Refers to any unit of content that can be associated with a distribution of
software.""" ;
    skos:exactMatch software:Package ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_node_kind "sh:IRI" .

spdx:Relationship a owl:Class ;
    rdfs:label "Relationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:completeness ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty spdx:to ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:unionOf ( core:RelationshipType xsd:string ) ] ;
            owl:onProperty spdx:relationshipType ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty spdx:relationshipType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:relationshipType ],
        [ a owl:Restriction ;
            owl:allValuesFrom spdx:Element ;
            owl:onProperty spdx:from ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:from ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:endTime ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:completeness ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty spdx:from ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:startTime ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:startTime ],
        [ a owl:Restriction ;
            owl:allValuesFrom core:RelationshipCompleteness ;
            owl:onProperty spdx:completeness ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:endTime ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:dateTime [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^\\d\\d\\d\\d-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$" ] ) ] ) ] ;
            owl:onProperty spdx:startTime ],
        [ a owl:Restriction ;
            owl:allValuesFrom spdx:Element ;
            owl:onProperty spdx:to ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:dateTime [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^\\d\\d\\d\\d-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$" ] ) ] ) ] ;
            owl:onProperty spdx:endTime ],
        spdx:Element ;
    skos:definition "Describes a relationship between one or more elements." ;
    skos:exactMatch core:Relationship ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_node_kind "sh:IRI" .

<https://spdx.org/rdf/3.0.1/terms/Security/CvssSeverityType/critical> a owl:Class ;
    rdfs:label "critical" ;
    rdfs:subClassOf security:CvssSeverityType ;
    skos:definition "When a CVSS score is between 9.0 - 10.0" .

<https://spdx.org/rdf/3.0.1/terms/Security/CvssSeverityType/high> a owl:Class ;
    rdfs:label "high" ;
    rdfs:subClassOf security:CvssSeverityType ;
    skos:definition "When a CVSS score is between 7.0 - 8.9" .

<https://spdx.org/rdf/3.0.1/terms/Security/CvssSeverityType/low> a owl:Class ;
    rdfs:label "low" ;
    rdfs:subClassOf security:CvssSeverityType ;
    skos:definition "When a CVSS score is between 0.1 - 3.9" .

<https://spdx.org/rdf/3.0.1/terms/Security/CvssSeverityType/medium> a owl:Class ;
    rdfs:label "medium" ;
    rdfs:subClassOf security:CvssSeverityType ;
    skos:definition "When a CVSS score is between 4.0 - 6.9" .

<https://spdx.org/rdf/3.0.1/terms/Security/CvssSeverityType/none> a owl:Class ;
    rdfs:label "none" ;
    rdfs:subClassOf security:CvssSeverityType ;
    skos:definition "When a CVSS score is 0.0" .

<https://spdx.org/rdf/3.0.1/terms/Security/ExploitCatalogType/kev> a owl:Class ;
    rdfs:label "kev" ;
    rdfs:subClassOf security:ExploitCatalogType ;
    skos:definition "CISA's Known Exploited Vulnerability (KEV) Catalog" .

<https://spdx.org/rdf/3.0.1/terms/Security/ExploitCatalogType/other> a owl:Class ;
    rdfs:label "other" ;
    rdfs:subClassOf security:ExploitCatalogType ;
    skos:definition "Other exploit catalogs" .

<https://spdx.org/rdf/3.0.1/terms/Security/SsvcDecisionType/act> a owl:Class ;
    rdfs:label "act" ;
    rdfs:subClassOf security:SsvcDecisionType ;
    skos:definition "The vulnerability requires attention from the organization's internal, supervisory-level and leadership-level individuals. Necessary actions include requesting assistance or information about the vulnerability, as well as publishing a notification either internally and/or externally. Typically, internal groups would meet to determine the overall response and then execute agreed upon actions. CISA recommends remediating Act vulnerabilities as soon as possible." .

<https://spdx.org/rdf/3.0.1/terms/Security/SsvcDecisionType/attend> a owl:Class ;
    rdfs:label "attend" ;
    rdfs:subClassOf security:SsvcDecisionType ;
    skos:definition "The vulnerability requires attention from the organization's internal, supervisory-level individuals. Necessary actions include requesting assistance or information about the vulnerability, and may involve publishing a notification either internally and/or externally. CISA recommends remediating Attend vulnerabilities sooner than standard update timelines." .

<https://spdx.org/rdf/3.0.1/terms/Security/SsvcDecisionType/track> a owl:Class ;
    rdfs:label "track" ;
    rdfs:subClassOf security:SsvcDecisionType ;
    skos:definition "The vulnerability does not require action at this time. The organization would continue to track the vulnerability and reassess it if new information becomes available. CISA recommends remediating Track vulnerabilities within standard update timelines." .

<https://spdx.org/rdf/3.0.1/terms/Security/SsvcDecisionType/trackStar> a owl:Class ;
    rdfs:label "trackStar" ;
    rdfs:subClassOf security:SsvcDecisionType ;
    skos:definition "(\"Track\\*\" in the SSVC spec) The vulnerability contains specific characteristics that may require closer monitoring for changes. CISA recommends remediating Track\\* vulnerabilities within standard update timelines." .

<https://spdx.org/rdf/3.0.1/terms/Security/VexJustificationType/componentNotPresent> a owl:Class ;
    rdfs:label "componentNotPresent" ;
    rdfs:subClassOf security:VexJustificationType ;
    skos:definition "The software is not affected because the vulnerable component is not in the product." .

<https://spdx.org/rdf/3.0.1/terms/Security/VexJustificationType/inlineMitigationsAlreadyExist> a owl:Class ;
    rdfs:label "inlineMitigationsAlreadyExist" ;
    rdfs:subClassOf security:VexJustificationType ;
    skos:definition "Built-in inline controls or mitigations prevent an adversary from leveraging the vulnerability." .

<https://spdx.org/rdf/3.0.1/terms/Security/VexJustificationType/vulnerableCodeCannotBeControlledByAdversary> a owl:Class ;
    rdfs:label "vulnerableCodeCannotBeControlledByAdversary" ;
    rdfs:subClassOf security:VexJustificationType ;
    skos:definition "The vulnerable component is present, and the component contains the vulnerable code. However, vulnerable code is used in such a way that an attacker cannot mount any anticipated attack." .

<https://spdx.org/rdf/3.0.1/terms/Security/VexJustificationType/vulnerableCodeNotInExecutePath> a owl:Class ;
    rdfs:label "vulnerableCodeNotInExecutePath" ;
    rdfs:subClassOf security:VexJustificationType ;
    skos:definition "The affected code is not reachable through the execution of the code, including non-anticipated states of the product." .

<https://spdx.org/rdf/3.0.1/terms/Security/VexJustificationType/vulnerableCodeNotPresent> a owl:Class ;
    rdfs:label "vulnerableCodeNotPresent" ;
    rdfs:subClassOf security:VexJustificationType ;
    skos:definition "The product is not affected because the code underlying the vulnerability is not present in the product." .

<https://spdx.org/rdf/3.0.1/terms/Software/ContentIdentifierType/gitoid> a owl:Class ;
    rdfs:label "gitoid" ;
    rdfs:subClassOf software:ContentIdentifierType ;
    skos:definition "[Gitoid](https://www.iana.org/assignments/uri-schemes/prov/gitoid), stands for [Git Object ID](https://git-scm.com/book/en/v2/Git-Internals-Git-Objects). A gitoid of type blob is a unique hash of a binary artifact. A gitoid may represent either an [Artifact Identifier](https://github.com/omnibor/spec/blob/eb1ee5c961c16215eb8709b2975d193a2007a35d/spec/SPEC.md#artifact-identifier-types) for the software artifact or an [Input Manifest Identifier](https://github.com/omnibor/spec/blob/eb1ee5c961c16215eb8709b2975d193a2007a35d/spec/SPEC.md#input-manifest-identifier) for the software artifact's associated [Artifact Input Manifest](https://github.com/omnibor/spec/blob/eb1ee5c961c16215eb8709b2975d193a2007a35d/spec/SPEC.md#artifact-input-manifest); this ambiguity exists because the Artifact Input Manifest is itself an artifact, and the gitoid of that artifact is its valid identifier. Gitoids calculated on software artifacts (Snippet, File, or Package Elements) should be recorded in the SPDX 3.0 SoftwareArtifact's contentIdentifier property. Gitoids calculated on the Artifact Input Manifest (Input Manifest Identifier) should be recorded in the SPDX 3.0 Element's externalIdentifier property. See [OmniBOR Specification](https://github.com/omnibor/spec/), a minimalistic specification for describing software [Artifact Dependency Graphs](https://github.com/omnibor/spec/blob/eb1ee5c961c16215eb8709b2975d193a2007a35d/spec/SPEC.md#artifact-dependency-graph-adg)." .

<https://spdx.org/rdf/3.0.1/terms/Software/ContentIdentifierType/swhid> a owl:Class ;
    rdfs:label "swhid" ;
    rdfs:subClassOf software:ContentIdentifierType ;
    skos:definition "SoftWare Hash IDentifier, a persistent intrinsic identifier for digital artifacts, such as files, trees (also known as directories or folders), commits, and other objects typically found in version control systems. The format of the identifiers is defined in the [SWHID specification](https://www.swhid.org/specification/v1.1/4.Syntax) (ISO/IEC DIS 18670). They typically look like `swh:1:cnt:94a9ed024d3859793618152ea559a168bbcbb5e2`." .

<https://spdx.org/rdf/3.0.1/terms/Software/FileKindType/directory> a owl:Class ;
    rdfs:label "directory" ;
    rdfs:subClassOf software:FileKindType ;
    skos:definition "The file represents a directory and all content stored in that directory." .

<https://spdx.org/rdf/3.0.1/terms/Software/FileKindType/file> a owl:Class ;
    rdfs:label "file" ;
    rdfs:subClassOf software:FileKindType ;
    skos:definition "The file represents a single file (default)." .

<https://spdx.org/rdf/3.0.1/terms/Software/SbomType/analyzed> a owl:Class ;
    rdfs:label "analyzed" ;
    rdfs:subClassOf software:SbomType ;
    skos:definition "SBOM generated through analysis of artifacts (e.g., executables, packages, containers, and virtual machine images) after its build. Such analysis generally requires a variety of heuristics. In some contexts, this may also be referred to as a \"3rd party\" SBOM." .

<https://spdx.org/rdf/3.0.1/terms/Software/SbomType/build> a owl:Class ;
    rdfs:label "build" ;
    rdfs:subClassOf software:SbomType ;
    skos:definition "SBOM generated as part of the process of building the software to create a releasable artifact (e.g., executable or package) from data such as source files, dependencies, built components, build process ephemeral data, and other SBOMs." .

<https://spdx.org/rdf/3.0.1/terms/Software/SbomType/deployed> a owl:Class ;
    rdfs:label "deployed" ;
    rdfs:subClassOf software:SbomType ;
    skos:definition "SBOM provides an inventory of software that is present on a system. This may be an assembly of other SBOMs that combines analysis of configuration options, and examination of execution behavior in a (potentially simulated) deployment environment." .

<https://spdx.org/rdf/3.0.1/terms/Software/SbomType/design> a owl:Class ;
    rdfs:label "design" ;
    rdfs:subClassOf software:SbomType ;
    skos:definition "SBOM of intended, planned software project or product with included components (some of which may not yet exist) for a new software artifact." .

<https://spdx.org/rdf/3.0.1/terms/Software/SbomType/runtime> a owl:Class ;
    rdfs:label "runtime" ;
    rdfs:subClassOf software:SbomType ;
    skos:definition "SBOM generated through instrumenting the system running the software, to capture only components present in the system, as well as external call-outs or dynamically loaded components. In some contexts, this may also be referred to as an \"Instrumented\" or \"Dynamic\" SBOM." .

<https://spdx.org/rdf/3.0.1/terms/Software/SbomType/source> a owl:Class ;
    rdfs:label "source" ;
    rdfs:subClassOf software:SbomType ;
    skos:definition "SBOM created directly from the development environment, source files, and included dependencies used to build an product artifact." .

<https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/application> a owl:Class ;
    rdfs:label "application" ;
    rdfs:subClassOf software:SoftwarePurpose ;
    skos:definition "The Element is a software application." .

<https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/archive> a owl:Class ;
    rdfs:label "archive" ;
    rdfs:subClassOf software:SoftwarePurpose ;
    skos:definition "The Element is an archived collection of one or more files (.tar, .zip, etc.)." .

<https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/bom> a owl:Class ;
    rdfs:label "bom" ;
    rdfs:subClassOf software:SoftwarePurpose ;
    skos:definition "The Element is a bill of materials." .

<https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/configuration> a owl:Class ;
    rdfs:label "configuration" ;
    rdfs:subClassOf software:SoftwarePurpose ;
    skos:definition "The Element is configuration data." .

<https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/container> a owl:Class ;
    rdfs:label "container" ;
    rdfs:subClassOf software:SoftwarePurpose ;
    skos:definition "The Element is a container image which can be used by a container runtime application." .

<https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/data> a owl:Class ;
    rdfs:label "data" ;
    rdfs:subClassOf software:SoftwarePurpose ;
    skos:definition "The Element is data." .

<https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/device> a owl:Class ;
    rdfs:label "device" ;
    rdfs:subClassOf software:SoftwarePurpose ;
    skos:definition "The Element refers to a chipset, processor, or electronic board." .

<https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/deviceDriver> a owl:Class ;
    rdfs:label "deviceDriver" ;
    rdfs:subClassOf software:SoftwarePurpose ;
    skos:definition "The Element represents software that controls hardware devices." .

<https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/diskImage> a owl:Class ;
    rdfs:label "diskImage" ;
    rdfs:subClassOf software:SoftwarePurpose ;
    skos:definition "The Element refers to a disk image that can be written to a disk, booted in a VM, etc. A disk image typically contains most or all of the components necessary to boot, such as bootloaders, kernels, firmware, userspace, etc." .

<https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/documentation> a owl:Class ;
    rdfs:label "documentation" ;
    rdfs:subClassOf software:SoftwarePurpose ;
    skos:definition "The Element is documentation." .

<https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/evidence> a owl:Class ;
    rdfs:label "evidence" ;
    rdfs:subClassOf software:SoftwarePurpose ;
    skos:definition "The Element is the evidence that a specification or requirement has been fulfilled." .

<https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/executable> a owl:Class ;
    rdfs:label "executable" ;
    rdfs:subClassOf software:SoftwarePurpose ;
    skos:definition "The Element is an Artifact that can be run on a computer." .

<https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/file> a owl:Class ;
    rdfs:label "file" ;
    rdfs:subClassOf software:SoftwarePurpose ;
    skos:definition "The Element is a single file which can be independently distributed (configuration file, statically linked binary, Kubernetes deployment, etc.)." .

<https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/filesystemImage> a owl:Class ;
    rdfs:label "filesystemImage" ;
    rdfs:subClassOf software:SoftwarePurpose ;
    skos:definition "The Element is a file system image that can be written to a disk (or virtual) partition." .

<https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/firmware> a owl:Class ;
    rdfs:label "firmware" ;
    rdfs:subClassOf software:SoftwarePurpose ;
    skos:definition "The Element provides low level control over a device's hardware." .

<https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/framework> a owl:Class ;
    rdfs:label "framework" ;
    rdfs:subClassOf software:SoftwarePurpose ;
    skos:definition "The Element is a software framework." .

<https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/install> a owl:Class ;
    rdfs:label "install" ;
    rdfs:subClassOf software:SoftwarePurpose ;
    skos:definition "The Element is used to install software on disk." .

<https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/library> a owl:Class ;
    rdfs:label "library" ;
    rdfs:subClassOf software:SoftwarePurpose ;
    skos:definition "The Element is a software library." .

<https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/manifest> a owl:Class ;
    rdfs:label "manifest" ;
    rdfs:subClassOf software:SoftwarePurpose ;
    skos:definition "The Element is a software manifest." .

<https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/model> a owl:Class ;
    rdfs:label "model" ;
    rdfs:subClassOf software:SoftwarePurpose ;
    skos:definition "The Element is a machine learning or artificial intelligence model." .

<https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/module> a owl:Class ;
    rdfs:label "module" ;
    rdfs:subClassOf software:SoftwarePurpose ;
    skos:definition "The Element is a module of a piece of software." .

<https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/operatingSystem> a owl:Class ;
    rdfs:label "operatingSystem" ;
    rdfs:subClassOf software:SoftwarePurpose ;
    skos:definition "The Element is an operating system." .

<https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/other> a owl:Class ;
    rdfs:label "other" ;
    rdfs:subClassOf software:SoftwarePurpose ;
    skos:definition "The Element doesn't fit into any of the other categories." .

<https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/patch> a owl:Class ;
    rdfs:label "patch" ;
    rdfs:subClassOf software:SoftwarePurpose ;
    skos:definition "The Element contains a set of changes to update, fix, or improve another Element." .

<https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/platform> a owl:Class ;
    rdfs:label "platform" ;
    rdfs:subClassOf software:SoftwarePurpose ;
    skos:definition "The Element represents a runtime environment." .

<https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/requirement> a owl:Class ;
    rdfs:label "requirement" ;
    rdfs:subClassOf software:SoftwarePurpose ;
    skos:definition "The Element provides a requirement needed as input for another Element." .

<https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/source> a owl:Class ;
    rdfs:label "source" ;
    rdfs:subClassOf software:SoftwarePurpose ;
    skos:definition "The Element is a single or a collection of source files." .

<https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/specification> a owl:Class ;
    rdfs:label "specification" ;
    rdfs:subClassOf software:SoftwarePurpose ;
    skos:definition "The Element is a plan, guideline or strategy how to create, perform or analyze an application." .

<https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/test> a owl:Class ;
    rdfs:label "test" ;
    rdfs:subClassOf software:SoftwarePurpose ;
    skos:definition "The Element is a test used to verify functionality on an software element." .

spdx:Tool a owl:Class ;
    rdfs:label "Tool" ;
    rdfs:subClassOf spdx:Element ;
    skos:definition "An element of hardware and/or software utilized to carry out a particular function." ;
    skos:exactMatch core:Tool ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_node_kind "sh:IRI" .

spdx:additionalPurpose a owl:DatatypeProperty ;
    rdfs:label "additionalPurpose" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:unionOf ( software:SoftwarePurpose xsd:string ) ] ;
    skos:definition "Provides additional purpose information of the software artifact." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:anonymizationMethodUsed a owl:DatatypeProperty ;
    rdfs:label "anonymizationMethodUsed" ;
    rdfs:range xsd:string ;
    skos:definition "Describes the anonymization methods used." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:attributionText a owl:DatatypeProperty ;
    rdfs:label "attributionText" ;
    rdfs:range xsd:string ;
    skos:definition """Provides a place for the SPDX data creator to record acknowledgement text for
a software Package, File or Snippet.""" ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:cdxProperty a owl:ObjectProperty ;
    rdfs:label "cdxProperty" ;
    rdfs:range spdx:CdxPropertyEntry ;
    skos:definition "Provides a map of a property names to a values." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:configSourceDigest a owl:ObjectProperty ;
    rdfs:label "configSourceDigest" ;
    rdfs:range spdx:Hash ;
    skos:definition """Property that describes the digest of the build configuration file used to
invoke a build.""" ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:configSourceEntrypoint a owl:DatatypeProperty ;
    rdfs:label "configSourceEntrypoint" ;
    rdfs:range xsd:string ;
    skos:definition "Property describes the invocation entrypoint of a build." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:configSourceUri a owl:DatatypeProperty ;
    rdfs:label "configSourceUri" ;
    rdfs:range xsd:anyURI ;
    skos:definition "Property that describes the URI of the build configuration source file." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:contentIdentifier a owl:ObjectProperty ;
    rdfs:label "contentIdentifier" ;
    rdfs:range spdx:ContentIdentifier ;
    skos:definition """A canonical, unique, immutable identifier of the artifact content, that may be
used for verifying its identity and/or integrity.""" ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:core_locator a owl:DatatypeProperty ;
    rdfs:label "core_locator" ;
    rdfs:range xsd:string ;
    skos:definition "Provides the location of an external reference." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:createdBy a owl:ObjectProperty ;
    rdfs:label "createdBy" ;
    rdfs:range spdx:Agent ;
    skos:definition "Identifies who or what created the Element." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:createdUsing a owl:ObjectProperty ;
    rdfs:label "createdUsing" ;
    rdfs:range spdx:Tool ;
    skos:definition "Identifies the tooling that was used during the creation of the Element." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:customIdToUri a owl:ObjectProperty ;
    rdfs:label "customIdToUri" ;
    rdfs:range spdx:DictionaryEntry ;
    skos:definition """Maps a LicenseRef or AdditionRef string for a Custom License or a Custom
License Addition to its URI ID.""" ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:dataPreprocessing a owl:DatatypeProperty ;
    rdfs:label "dataPreprocessing" ;
    rdfs:range xsd:string ;
    skos:definition "Describes the preprocessing steps that were applied to the raw data to create the given dataset." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:datasetType a owl:DatatypeProperty ;
    rdfs:label "datasetType" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:unionOf ( dataset:DatasetType xsd:string ) ] ;
    skos:definition "Describes the type of the given dataset." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:domain a owl:DatatypeProperty ;
    rdfs:label "domain" ;
    rdfs:range xsd:string ;
    skos:definition "Captures the domain in which the AI package can be used." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:element a owl:ObjectProperty ;
    rdfs:label "element" ;
    rdfs:range spdx:Element ;
    skos:definition "Refers to one or more Elements that are part of an ElementCollection." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:environment a owl:ObjectProperty ;
    rdfs:label "environment" ;
    rdfs:range spdx:DictionaryEntry ;
    skos:definition "Property describing the session in which a build is invoked." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:extension a owl:ObjectProperty ;
    rdfs:label "extension" ;
    rdfs:range spdx:Extension ;
    skos:definition "Specifies an Extension characterization of some aspect of an Element." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:externalIdentifier a owl:ObjectProperty ;
    rdfs:label "externalIdentifier" ;
    rdfs:range spdx:ExternalIdentifier ;
    skos:definition """Provides a reference to a resource outside the scope of SPDX-3.0 content
that uniquely identifies an Element.""" ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:externalRef a owl:ObjectProperty ;
    rdfs:label "externalRef" ;
    rdfs:range spdx:ExternalRef ;
    skos:definition """Points to a resource outside the scope of the SPDX-3.0 content
that provides additional characteristics of an Element.""" ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:finetuningEnergyConsumption a owl:ObjectProperty ;
    rdfs:label "finetuningEnergyConsumption" ;
    rdfs:range spdx:EnergyConsumptionDescription ;
    skos:definition """Specifies the amount of energy consumed when finetuning the AI model that is
being used in the AI system.""" ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:hyperparameter a owl:ObjectProperty ;
    rdfs:label "hyperparameter" ;
    rdfs:range spdx:DictionaryEntry ;
    skos:definition """Records a hyperparameter used to build the AI model contained in the AI
package.""" ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:identifierLocator a owl:DatatypeProperty ;
    rdfs:label "identifierLocator" ;
    rdfs:range xsd:anyURI ;
    skos:definition "Provides the location for more information regarding an external identifier." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:import a owl:ObjectProperty ;
    rdfs:label "import" ;
    rdfs:range spdx:ExternalMap ;
    skos:definition "Provides an ExternalMap of Element identifiers." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:inferenceEnergyConsumption a owl:ObjectProperty ;
    rdfs:label "inferenceEnergyConsumption" ;
    rdfs:range spdx:EnergyConsumptionDescription ;
    skos:definition """Specifies the amount of energy consumed during inference time by an AI model
that is being used in the AI system.""" ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:knownBias a owl:DatatypeProperty ;
    rdfs:label "knownBias" ;
    rdfs:range xsd:string ;
    skos:definition "Records the biases that the dataset is known to encompass." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:metric a owl:ObjectProperty ;
    rdfs:label "metric" ;
    rdfs:range spdx:DictionaryEntry ;
    skos:definition "Records the measurement of prediction quality of the AI model." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:metricDecisionThreshold a owl:ObjectProperty ;
    rdfs:label "metricDecisionThreshold" ;
    rdfs:range spdx:DictionaryEntry ;
    skos:definition """Captures the threshold that was used for computation of a metric described in
the metric field.""" ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:modelDataPreprocessing a owl:DatatypeProperty ;
    rdfs:label "modelDataPreprocessing" ;
    rdfs:range xsd:string ;
    skos:definition """Describes all the preprocessing steps applied to the training data before the
model training.""" ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:modelExplainability a owl:DatatypeProperty ;
    rdfs:label "modelExplainability" ;
    rdfs:range xsd:string ;
    skos:definition "Describes methods that can be used to explain the results from the AI model." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:namespaceMap a owl:ObjectProperty ;
    rdfs:label "namespaceMap" ;
    rdfs:range spdx:NamespaceMap ;
    skos:definition "Provides a NamespaceMap of prefixes and associated namespace partial URIs applicable to an SpdxDocument and independent of any specific serialization format or instance." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:originatedBy a owl:ObjectProperty ;
    rdfs:label "originatedBy" ;
    rdfs:range spdx:Agent ;
    skos:definition "Identifies from where or whom the Element originally came." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:packageVerificationCodeExcludedFile a owl:DatatypeProperty ;
    rdfs:label "packageVerificationCodeExcludedFile" ;
    rdfs:range xsd:string ;
    skos:definition """The relative file name of a file to be excluded from the
`PackageVerificationCode`.""" ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:parameter a owl:ObjectProperty ;
    rdfs:label "parameter" ;
    rdfs:range spdx:DictionaryEntry ;
    skos:definition "Property describing a parameter used in an instance of a build." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:profileConformance a owl:ObjectProperty ;
    rdfs:label "profileConformance" ;
    rdfs:range core:ProfileIdentifierType ;
    skos:definition """Describes one a profile which the creator of this ElementCollection intends to
conform to.""" ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:rootElement a owl:ObjectProperty ;
    rdfs:label "rootElement" ;
    rdfs:range spdx:Element ;
    skos:definition "This property is used to denote the root Element(s) of a tree of elements contained in a BOM." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:sbomType a owl:ObjectProperty ;
    rdfs:label "sbomType" ;
    rdfs:range software:SbomType ;
    skos:definition "Provides information about the type of an SBOM." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:sensor a owl:ObjectProperty ;
    rdfs:label "sensor" ;
    rdfs:range spdx:DictionaryEntry ;
    skos:definition "Describes a sensor used for collecting the data." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:standardCompliance a owl:DatatypeProperty ;
    rdfs:label "standardCompliance" ;
    rdfs:range xsd:string ;
    skos:definition "Captures a standard that is being complied with." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:standardName a owl:DatatypeProperty ;
    rdfs:label "standardName" ;
    rdfs:range xsd:string ;
    skos:definition "The name of a relevant standard that may apply to an artifact." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:supportLevel a owl:ObjectProperty ;
    rdfs:label "supportLevel" ;
    rdfs:range core:SupportType ;
    skos:definition "Specifies the level of support associated with an artifact." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:to a owl:ObjectProperty ;
    rdfs:label "to" ;
    rdfs:range spdx:Element ;
    skos:definition "References an Element on the right-hand side of a relationship." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:trainingEnergyConsumption a owl:ObjectProperty ;
    rdfs:label "trainingEnergyConsumption" ;
    rdfs:range spdx:EnergyConsumptionDescription ;
    skos:definition """Specifies the amount of energy consumed when training the AI model that is
being used in the AI system.""" ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:typeOfModel a owl:DatatypeProperty ;
    rdfs:label "typeOfModel" ;
    rdfs:range xsd:string ;
    skos:definition "Records the type of the model used in the AI software." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:Extension a owl:Class ;
    rdfs:label "Extension" ;
    skos:definition "A characterization of some aspect of an Element that is associated with the Element in a generalized fashion." ;
    skos:exactMatch extension:Extension ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_node_kind "sh:BlankNodeOrIRI" .

spdx:actionStatement a owl:DatatypeProperty ;
    rdfs:label "actionStatement" ;
    rdfs:range xsd:string ;
    skos:definition """Provides advise on how to mitigate or remediate a vulnerability when a VEX product
is affected by it.""" ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:actionStatementTime a owl:DatatypeProperty ;
    rdfs:label "actionStatementTime" ;
    rdfs:range xsd:dateTime ;
    skos:definition """Records the time when a recommended action was communicated in a VEX statement
to mitigate a vulnerability.""" ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:additionText a owl:DatatypeProperty ;
    rdfs:label "additionText" ;
    rdfs:range xsd:string ;
    skos:definition "Identifies the full text of a LicenseAddition." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:annotationType a owl:DatatypeProperty ;
    rdfs:label "annotationType" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:unionOf ( core:AnnotationType xsd:string ) ] ;
    skos:definition "Describes the type of annotation." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:assessedElement a owl:ObjectProperty ;
    rdfs:label "assessedElement" ;
    rdfs:range spdx:SoftwareArtifact ;
    skos:definition """Specifies an Element contained in a piece of software where a vulnerability was
found.""" ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:autonomyType a owl:ObjectProperty ;
    rdfs:label "autonomyType" ;
    rdfs:range core:PresenceType ;
    skos:definition """Indicates whether the system can perform a decision or action without human
involvement or guidance.""" ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:beginIntegerRange a owl:DatatypeProperty ;
    rdfs:label "beginIntegerRange" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                        owl:onDatatype xsd:integer ;
                        owl:withRestrictions ( [ xsd:minInclusive 1 ] ) ] ) ] ;
    skos:definition "Defines the beginning of a range." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:buildEndTime a owl:DatatypeProperty ;
    rdfs:label "buildEndTime" ;
    rdfs:range xsd:dateTime ;
    skos:definition "Property that describes the time at which a build stops." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:buildId a owl:DatatypeProperty ;
    rdfs:label "buildId" ;
    rdfs:range xsd:string ;
    skos:definition """A buildId is a locally unique identifier used by a builder to identify a unique
instance of a build produced by it.""" ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:buildStartTime a owl:DatatypeProperty ;
    rdfs:label "buildStartTime" ;
    rdfs:range xsd:dateTime ;
    skos:definition "Property describing the start time of a build." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:buildType a owl:DatatypeProperty ;
    rdfs:label "buildType" ;
    rdfs:range xsd:anyURI ;
    skos:definition """A buildType is a hint that is used to indicate the toolchain, platform, or
infrastructure that the build was invoked on.""" ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:builtTime a owl:DatatypeProperty ;
    rdfs:label "builtTime" ;
    rdfs:range xsd:dateTime ;
    skos:definition "Specifies the time an artifact was built." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:byteRange a owl:ObjectProperty ;
    rdfs:label "byteRange" ;
    rdfs:range spdx:PositiveIntegerRange ;
    skos:definition """Defines the byte range in the original host file that the snippet information
applies to.""" ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:catalogType a owl:DatatypeProperty ;
    rdfs:label "catalogType" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:unionOf ( security:ExploitCatalogType xsd:string ) ] ;
    skos:definition "Specifies the exploit catalog type." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:cdxPropName a owl:DatatypeProperty ;
    rdfs:label "cdxPropName" ;
    rdfs:range xsd:string ;
    skos:definition "A name used in a CdxPropertyEntry name-value pair." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:cdxPropValue a owl:DatatypeProperty ;
    rdfs:label "cdxPropValue" ;
    rdfs:range xsd:string ;
    skos:definition "A value used in a CdxPropertyEntry name-value pair." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:completeness a owl:ObjectProperty ;
    rdfs:label "completeness" ;
    rdfs:range core:RelationshipCompleteness ;
    skos:definition "Provides information about the completeness of relationships." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:confidentialityLevel a owl:ObjectProperty ;
    rdfs:label "confidentialityLevel" ;
    rdfs:range dataset:ConfidentialityLevelType ;
    skos:definition "Describes the confidentiality level of the data points contained in the dataset." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:contentIdentifierType a owl:ObjectProperty ;
    rdfs:label "contentIdentifierType" ;
    rdfs:range software:ContentIdentifierType ;
    skos:definition "Specifies the type of the content identifier." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:contentIdentifierValue a owl:DatatypeProperty ;
    rdfs:label "contentIdentifierValue" ;
    rdfs:range xsd:anyURI ;
    skos:definition "Specifies the value of the content identifier." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:context a owl:DatatypeProperty ;
    rdfs:label "context" ;
    rdfs:range xsd:string ;
    skos:definition """Gives information about the circumstances or unifying properties
that Elements of the bundle have been assembled under.""" ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:copyrightText a owl:DatatypeProperty ;
    rdfs:label "copyrightText" ;
    rdfs:range xsd:string ;
    skos:definition """Identifies the text of one or more copyright notices for a software Package,
File or Snippet, if any.""" ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:created a owl:DatatypeProperty ;
    rdfs:label "created" ;
    rdfs:range xsd:dateTime ;
    skos:definition "Identifies when the Element was originally created." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:creationInfo a owl:ObjectProperty ;
    rdfs:label "creationInfo" ;
    rdfs:range spdx:CreationInfo ;
    skos:definition "Provides information about the creation of the Element." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:dataCollectionProcess a owl:DatatypeProperty ;
    rdfs:label "dataCollectionProcess" ;
    rdfs:range xsd:string ;
    skos:definition "Describes how the dataset was collected." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:dataLicense a owl:ObjectProperty ;
    rdfs:label "dataLicense" ;
    rdfs:range spdx:AnyLicenseInfo ;
    skos:definition """Provides the license under which the SPDX documentation of the Element can be
used.""" ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:datasetAvailability a owl:ObjectProperty ;
    rdfs:label "datasetAvailability" ;
    rdfs:range dataset:DatasetAvailabilityType ;
    skos:definition "The field describes the availability of a dataset." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:datasetNoise a owl:DatatypeProperty ;
    rdfs:label "datasetNoise" ;
    rdfs:range xsd:string ;
    skos:definition "Describes potentially noisy elements of the dataset." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:datasetSize a owl:DatatypeProperty ;
    rdfs:label "datasetSize" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                        owl:onDatatype xsd:integer ;
                        owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
    skos:definition "Captures the size of the dataset." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:datasetUpdateMechanism a owl:DatatypeProperty ;
    rdfs:label "datasetUpdateMechanism" ;
    rdfs:range xsd:string ;
    skos:definition "Describes a mechanism to update the dataset." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:decisionType a owl:ObjectProperty ;
    rdfs:label "decisionType" ;
    rdfs:range security:SsvcDecisionType ;
    skos:definition """Provide the enumeration of possible decisions in the
[Stakeholder-Specific Vulnerability Categorization (SSVC) decision tree](https://www.cisa.gov/stakeholder-specific-vulnerability-categorization-ssvc).""" ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:definingArtifact a owl:ObjectProperty ;
    rdfs:label "definingArtifact" ;
    rdfs:range spdx:Artifact ;
    skos:definition """Artifact representing a serialization instance of SPDX data containing the
definition of a particular Element.""" ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:description a owl:DatatypeProperty ;
    rdfs:label "description" ;
    rdfs:range xsd:string ;
    skos:definition "Provides a detailed description of the Element." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:downloadLocation a owl:DatatypeProperty ;
    rdfs:label "downloadLocation" ;
    rdfs:range xsd:anyURI ;
    skos:definition """Identifies the download Uniform Resource Identifier for the package at the time
that the document was created.""" ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:endIntegerRange a owl:DatatypeProperty ;
    rdfs:label "endIntegerRange" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                        owl:onDatatype xsd:integer ;
                        owl:withRestrictions ( [ xsd:minInclusive 1 ] ) ] ) ] ;
    skos:definition "Defines the end of a range." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:endTime a owl:DatatypeProperty ;
    rdfs:label "endTime" ;
    rdfs:range xsd:dateTime ;
    skos:definition "Specifies the time from which an element is no longer applicable / valid." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:energyConsumption a owl:ObjectProperty ;
    rdfs:label "energyConsumption" ;
    rdfs:range spdx:EnergyConsumption ;
    skos:definition "Indicates the amount of energy consumption incurred by an AI model." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:energyQuantity a owl:DatatypeProperty ;
    rdfs:label "energyQuantity" ;
    rdfs:range xsd:decimal ;
    skos:definition "Represents the energy quantity." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:energyUnit a owl:DatatypeProperty ;
    rdfs:label "energyUnit" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:unionOf ( ai:EnergyUnitType xsd:string ) ] ;
    skos:definition "Specifies the unit in which energy is measured." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:exploited a owl:DatatypeProperty ;
    rdfs:label "exploited" ;
    rdfs:range xsd:boolean ;
    skos:definition "Describe that a CVE is known to have an exploit because it's been listed in an exploit catalog." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:externalIdentifierType a owl:DatatypeProperty ;
    rdfs:label "externalIdentifierType" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:unionOf ( core:ExternalIdentifierType xsd:string ) ] ;
    skos:definition "Specifies the type of the external identifier." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:externalRefType a owl:DatatypeProperty ;
    rdfs:label "externalRefType" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:unionOf ( core:ExternalRefType xsd:string ) ] ;
    skos:definition "Specifies the type of the external reference." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:externalSpdxId a owl:DatatypeProperty ;
    rdfs:label "externalSpdxId" ;
    rdfs:range xsd:anyURI ;
    skos:definition """Identifies an external Element used within an SpdxDocument but defined
external to that SpdxDocument.""" ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:fileKind a owl:ObjectProperty ;
    rdfs:label "fileKind" ;
    rdfs:range software:FileKindType ;
    skos:definition "Describes if a given file is a directory or non-directory kind of file." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:from a owl:ObjectProperty ;
    rdfs:label "from" ;
    rdfs:range spdx:Element ;
    skos:definition "References the Element on the left-hand side of a relationship." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:hasSensitivePersonalInformation a owl:ObjectProperty ;
    rdfs:label "hasSensitivePersonalInformation" ;
    rdfs:range core:PresenceType ;
    skos:definition "Describes if any sensitive personal information is present in the dataset." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:homePage a owl:DatatypeProperty ;
    rdfs:label "homePage" ;
    rdfs:range xsd:anyURI ;
    skos:definition """A place for the SPDX document creator to record a website that serves as the
package's home page.""" ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:identifier a owl:DatatypeProperty ;
    rdfs:label "identifier" ;
    rdfs:range xsd:string ;
    skos:definition "Uniquely identifies an external element." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:impactStatement a owl:DatatypeProperty ;
    rdfs:label "impactStatement" ;
    rdfs:range xsd:string ;
    skos:definition """Explains why a VEX product is not affected by a vulnerability. It is an
alternative in VexNotAffectedVulnAssessmentRelationship to the machine-readable
justification label.""" ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:impactStatementTime a owl:DatatypeProperty ;
    rdfs:label "impactStatementTime" ;
    rdfs:range xsd:dateTime ;
    skos:definition "Timestamp of impact statement." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:informationAboutApplication a owl:DatatypeProperty ;
    rdfs:label "informationAboutApplication" ;
    rdfs:range xsd:string ;
    skos:definition """Provides relevant information about the AI software, not including the model
description.""" ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:informationAboutTraining a owl:DatatypeProperty ;
    rdfs:label "informationAboutTraining" ;
    rdfs:range xsd:string ;
    skos:definition "Describes relevant information about different steps of the training process." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:intendedUse a owl:DatatypeProperty ;
    rdfs:label "intendedUse" ;
    rdfs:range xsd:string ;
    skos:definition "Describes what the given dataset should be used for." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:isDeprecatedAdditionId a owl:DatatypeProperty ;
    rdfs:label "isDeprecatedAdditionId" ;
    rdfs:range xsd:boolean ;
    skos:definition "Specifies whether an additional text identifier has been marked as deprecated." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:isDeprecatedLicenseId a owl:DatatypeProperty ;
    rdfs:label "isDeprecatedLicenseId" ;
    rdfs:range xsd:boolean ;
    skos:definition """Specifies whether a license or additional text identifier has been marked as
deprecated.""" ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:isFsfLibre a owl:DatatypeProperty ;
    rdfs:label "isFsfLibre" ;
    rdfs:range xsd:boolean ;
    skos:definition """Specifies whether the License is listed as free by the
Free Software Foundation (FSF).""" ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:isOsiApproved a owl:DatatypeProperty ;
    rdfs:label "isOsiApproved" ;
    rdfs:range xsd:boolean ;
    skos:definition """Specifies whether the License is listed as approved by the
Open Source Initiative (OSI).""" ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:issuingAuthority a owl:DatatypeProperty ;
    rdfs:label "issuingAuthority" ;
    rdfs:range xsd:string ;
    skos:definition "An entity that is authorized to issue identification credentials." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:justificationType a owl:ObjectProperty ;
    rdfs:label "justificationType" ;
    rdfs:range security:VexJustificationType ;
    skos:definition """Impact justification label to be used when linking a vulnerability to an element
representing a VEX product with a VexNotAffectedVulnAssessmentRelationship
relationship.""" ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:key a owl:DatatypeProperty ;
    rdfs:label "key" ;
    rdfs:range xsd:string ;
    skos:definition "A key used in a generic key-value pair." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:licenseExpression a owl:DatatypeProperty ;
    rdfs:label "licenseExpression" ;
    rdfs:range xsd:string ;
    skos:definition "A string in the license expression format." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:licenseListVersion a owl:DatatypeProperty ;
    rdfs:label "licenseListVersion" ;
    rdfs:range xsd:string ;
    skos:definition "The version of the SPDX License List used in the license expression." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:limitation a owl:DatatypeProperty ;
    rdfs:label "limitation" ;
    rdfs:range xsd:string ;
    skos:definition "Captures a limitation of the AI software." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:lineRange a owl:ObjectProperty ;
    rdfs:label "lineRange" ;
    rdfs:range spdx:PositiveIntegerRange ;
    skos:definition """Defines the line range in the original host file that the snippet information
applies to.""" ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:locationHint a owl:DatatypeProperty ;
    rdfs:label "locationHint" ;
    rdfs:range xsd:anyURI ;
    skos:definition "Provides an indication of where to retrieve an external Element." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:name a owl:DatatypeProperty ;
    rdfs:label "name" ;
    rdfs:range xsd:string ;
    skos:definition "Identifies the name of an Element as designated by the creator." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:namespace a owl:DatatypeProperty ;
    rdfs:label "namespace" ;
    rdfs:range xsd:anyURI ;
    skos:definition """Provides an unambiguous mechanism for conveying a URI fragment portion of an
Element ID.""" ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:packageUrl a owl:DatatypeProperty ;
    rdfs:label "packageUrl" ;
    rdfs:range xsd:anyURI ;
    skos:definition """Provides a place for the SPDX data creator to record the package URL string
(in accordance with the Package URL specification) for a software Package.""" ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:packageVersion a owl:DatatypeProperty ;
    rdfs:label "packageVersion" ;
    rdfs:range xsd:string ;
    skos:definition "Identify the version of a package." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:percentile a owl:DatatypeProperty ;
    rdfs:label "percentile" ;
    rdfs:range xsd:decimal ;
    skos:definition "The percentile of the current probability score." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:prefix a owl:DatatypeProperty ;
    rdfs:label "prefix" ;
    rdfs:range xsd:string ;
    skos:definition "A substitute for a URI." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:primaryPurpose a owl:DatatypeProperty ;
    rdfs:label "primaryPurpose" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:unionOf ( software:SoftwarePurpose xsd:string ) ] ;
    skos:definition "Provides information about the primary purpose of the software artifact." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:probability a owl:DatatypeProperty ;
    rdfs:label "probability" ;
    rdfs:range xsd:decimal ;
    skos:definition "A probability score between 0 and 1 of a vulnerability being exploited." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:relationshipType a owl:DatatypeProperty ;
    rdfs:label "relationshipType" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:unionOf ( core:RelationshipType xsd:string ) ] ;
    skos:definition "Information about the relationship between two Elements." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:releaseTime a owl:DatatypeProperty ;
    rdfs:label "releaseTime" ;
    rdfs:range xsd:dateTime ;
    skos:definition "Specifies the time an artifact was released." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:safetyRiskAssessment a owl:ObjectProperty ;
    rdfs:label "safetyRiskAssessment" ;
    rdfs:range ai:SafetyRiskAssessmentType ;
    skos:definition "Records the results of general safety risk assessment of the AI system." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:scope a owl:DatatypeProperty ;
    rdfs:label "scope" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:unionOf ( core:LifecycleScopeType xsd:string ) ] ;
    skos:definition "Capture the scope of information about a specific relationship between elements." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:security_locator a owl:DatatypeProperty ;
    rdfs:label "security_locator" ;
    rdfs:range xsd:anyURI ;
    skos:definition "Provides the location of an exploit catalog." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:snippetFromFile a owl:ObjectProperty ;
    rdfs:label "snippetFromFile" ;
    rdfs:range spdx:File ;
    skos:definition "Defines the original host file that the snippet information applies to." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:sourceInfo a owl:DatatypeProperty ;
    rdfs:label "sourceInfo" ;
    rdfs:range xsd:string ;
    skos:definition """Records any relevant background information or additional comments
about the origin of the package.""" ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:specVersion a owl:DatatypeProperty ;
    rdfs:label "specVersion" ;
    rdfs:range xsd:string ;
    skos:definition """Provides a reference number that can be used to understand how to parse and
interpret an Element.""" ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:standardAdditionTemplate a owl:DatatypeProperty ;
    rdfs:label "standardAdditionTemplate" ;
    rdfs:range xsd:string ;
    skos:definition "Identifies the full text of a LicenseAddition, in SPDX templating format." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:standardLicenseHeader a owl:DatatypeProperty ;
    rdfs:label "standardLicenseHeader" ;
    rdfs:range xsd:string ;
    skos:definition """Provides a License author's preferred text to indicate that a file is covered
by the License.""" ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:standardLicenseTemplate a owl:DatatypeProperty ;
    rdfs:label "standardLicenseTemplate" ;
    rdfs:range xsd:string ;
    skos:definition "Identifies the full text of a License, in SPDX templating format." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:startTime a owl:DatatypeProperty ;
    rdfs:label "startTime" ;
    rdfs:range xsd:dateTime ;
    skos:definition "Specifies the time from which an element is applicable / valid." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:statement a owl:DatatypeProperty ;
    rdfs:label "statement" ;
    rdfs:range xsd:string ;
    skos:definition "Commentary on an assertion that an annotator has made." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:statusNotes a owl:DatatypeProperty ;
    rdfs:label "statusNotes" ;
    rdfs:range xsd:string ;
    skos:definition "Conveys information about how VEX status was determined." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:subject a owl:ObjectProperty ;
    rdfs:label "subject" ;
    rdfs:range spdx:Element ;
    skos:definition "An Element an annotator has made an assertion about." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:subjectAddition a owl:ObjectProperty ;
    rdfs:label "subjectAddition" ;
    rdfs:range spdx:LicenseAddition ;
    skos:definition "A LicenseAddition participating in a 'with addition' model." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:subjectExtendableLicense a owl:ObjectProperty ;
    rdfs:label "subjectExtendableLicense" ;
    rdfs:range spdx:ExtendableLicense ;
    skos:definition "A License participating in a 'with addition' model." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:subjectLicense a owl:ObjectProperty ;
    rdfs:label "subjectLicense" ;
    rdfs:range spdx:License ;
    skos:definition "A License participating in an 'or later' model." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:summary a owl:DatatypeProperty ;
    rdfs:label "summary" ;
    rdfs:range xsd:string ;
    skos:definition "A short description of an Element." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:useSensitivePersonalInformation a owl:ObjectProperty ;
    rdfs:label "useSensitivePersonalInformation" ;
    rdfs:range core:PresenceType ;
    skos:definition """Records if sensitive personal information is used during model training or
could be used during the inference.""" ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:validUntilTime a owl:DatatypeProperty ;
    rdfs:label "validUntilTime" ;
    rdfs:range xsd:dateTime ;
    skos:definition """Specifies until when the artifact can be used before its usage needs to be
reassessed.""" ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:value a owl:DatatypeProperty ;
    rdfs:label "value" ;
    rdfs:range xsd:string ;
    skos:definition "A value used in a generic key-value pair." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:vexVersion a owl:DatatypeProperty ;
    rdfs:label "vexVersion" ;
    rdfs:range xsd:string ;
    skos:definition "Specifies the version of a VEX statement." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:Artifact a owl:Class ;
    rdfs:label "Artifact" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:dateTime [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^\\d\\d\\d\\d-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$" ] ) ] ) ] ;
            owl:onProperty spdx:releaseTime ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:dateTime [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^\\d\\d\\d\\d-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$" ] ) ] ) ] ;
            owl:onProperty spdx:validUntilTime ],
        [ a owl:Restriction ;
            owl:allValuesFrom core:SupportType ;
            owl:onProperty spdx:supportLevel ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:releaseTime ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:supportLevel ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:builtTime ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:builtTime ],
        [ a owl:Restriction ;
            owl:allValuesFrom spdx:Agent ;
            owl:onProperty spdx:suppliedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:dateTime [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^\\d\\d\\d\\d-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$" ] ) ] ) ] ;
            owl:onProperty spdx:builtTime ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:standardName ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:originatedBy ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:suppliedBy ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:releaseTime ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:validUntilTime ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:validUntilTime ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spdx:standardName ],
        [ a owl:Restriction ;
            owl:allValuesFrom spdx:Agent ;
            owl:onProperty spdx:originatedBy ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:suppliedBy ],
        spdx:Element ;
    skos:definition "A distinct article or unit within the digital domain." ;
    skos:exactMatch core:Artifact ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_message "https://spdx.org/rdf/3.0.1/terms/Core/Artifact is an abstract class and should not be instantiated directly. Instantiate a subclass instead." ;
    spdx:shacl_node_kind "sh:IRI" ;
    spdx:shacl_not "{ sh:hasValue core:Artifact }" .

core:AnnotationType a owl:Class ;
    rdfs:label "AnnotationType" ;
    owl:unionOf ( <https://spdx.org/rdf/3.0.1/terms/Core/AnnotationType/other> <https://spdx.org/rdf/3.0.1/terms/Core/AnnotationType/review> ) ;
    skos:definition "Specifies the type of an annotation." ;
    skos:editorialNote "Open/extensible enum: slots using this type allow any string via any_of." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    linkml:permissible_values <https://spdx.org/rdf/3.0.1/terms/Core/AnnotationType/other>,
        <https://spdx.org/rdf/3.0.1/terms/Core/AnnotationType/review> .

spdx:ExtendableLicense a owl:Class ;
    rdfs:label "ExtendableLicense" ;
    rdfs:subClassOf spdx:AnyLicenseInfo ;
    skos:definition "Abstract class representing a License or an OrLaterOperator." ;
    skos:exactMatch expandedlicensing:ExtendableLicense ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_node_kind "sh:IRI" .

spdx:License a owl:Class ;
    rdfs:label "License" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:isOsiApproved ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spdx:standardLicenseHeader ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:standardLicenseHeader ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:licenseText ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:seeAlso ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spdx:standardLicenseTemplate ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spdx:obsoletedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty spdx:isOsiApproved ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:isDeprecatedLicenseId ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:obsoletedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spdx:licenseText ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:isFsfLibre ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:obsoletedBy ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty spdx:licenseText ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:standardLicenseHeader ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty spdx:seeAlso ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:licenseXml ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spdx:licenseXml ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty spdx:isDeprecatedLicenseId ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:isOsiApproved ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:licenseXml ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:isDeprecatedLicenseId ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty spdx:isFsfLibre ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:isFsfLibre ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:standardLicenseTemplate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:standardLicenseTemplate ],
        spdx:ExtendableLicense ;
    skos:definition "Abstract class for the portion of an AnyLicenseInfo representing a license." ;
    skos:exactMatch expandedlicensing:License ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_message "https://spdx.org/rdf/3.0.1/terms/ExpandedLicensing/License is an abstract class and should not be instantiated directly. Instantiate a subclass instead." ;
    spdx:shacl_node_kind "sh:IRI" ;
    spdx:shacl_not "{ sh:hasValue expandedlicensing:License }" .

spdx:LicenseAddition a owl:Class ;
    rdfs:label "LicenseAddition" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:obsoletedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spdx:standardAdditionTemplate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:obsoletedBy ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:licenseXml ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:standardAdditionTemplate ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spdx:obsoletedBy ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:licenseXml ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spdx:licenseXml ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spdx:additionText ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty spdx:additionText ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:isDeprecatedAdditionId ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:seeAlso ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty spdx:seeAlso ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:standardAdditionTemplate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:isDeprecatedAdditionId ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty spdx:isDeprecatedAdditionId ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:additionText ],
        spdx:Element ;
    skos:definition """Abstract class for additional text intended to be added to a License, but
which is not itself a standalone License.""" ;
    skos:exactMatch expandedlicensing:LicenseAddition ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_message "https://spdx.org/rdf/3.0.1/terms/ExpandedLicensing/LicenseAddition is an abstract class and should not be instantiated directly. Instantiate a subclass instead." ;
    spdx:shacl_node_kind "sh:IRI" ;
    spdx:shacl_not "{ sh:hasValue expandedlicensing:LicenseAddition }" .

spdx:PositiveIntegerRange a owl:Class ;
    rdfs:label "PositiveIntegerRange" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:endIntegerRange ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:beginIntegerRange ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty spdx:endIntegerRange ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty spdx:beginIntegerRange ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 1 ] ) ] ) ] ;
            owl:onProperty spdx:endIntegerRange ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 1 ] ) ] ) ] ;
            owl:onProperty spdx:beginIntegerRange ] ;
    skos:definition "A tuple of two positive integers that define a range." ;
    skos:exactMatch core:PositiveIntegerRange ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_node_kind "sh:BlankNodeOrIRI" .

security:ExploitCatalogType a owl:Class ;
    rdfs:label "ExploitCatalogType" ;
    owl:unionOf ( <https://spdx.org/rdf/3.0.1/terms/Security/ExploitCatalogType/kev> <https://spdx.org/rdf/3.0.1/terms/Security/ExploitCatalogType/other> ) ;
    skos:definition "Specifies the exploit catalog type." ;
    skos:editorialNote "Open/extensible enum: slots using this type allow any string via any_of." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    linkml:permissible_values <https://spdx.org/rdf/3.0.1/terms/Security/ExploitCatalogType/kev>,
        <https://spdx.org/rdf/3.0.1/terms/Security/ExploitCatalogType/other> .

software:ContentIdentifierType a owl:Class ;
    rdfs:label "ContentIdentifierType" ;
    owl:unionOf ( <https://spdx.org/rdf/3.0.1/terms/Software/ContentIdentifierType/gitoid> <https://spdx.org/rdf/3.0.1/terms/Software/ContentIdentifierType/swhid> ) ;
    skos:definition "Specifies the type of a content identifier." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    linkml:permissible_values <https://spdx.org/rdf/3.0.1/terms/Software/ContentIdentifierType/gitoid>,
        <https://spdx.org/rdf/3.0.1/terms/Software/ContentIdentifierType/swhid> .

software:FileKindType a owl:Class ;
    rdfs:label "FileKindType" ;
    owl:unionOf ( <https://spdx.org/rdf/3.0.1/terms/Software/FileKindType/directory> <https://spdx.org/rdf/3.0.1/terms/Software/FileKindType/file> ) ;
    skos:definition "Enumeration of the different kinds of SPDX file." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    linkml:permissible_values <https://spdx.org/rdf/3.0.1/terms/Software/FileKindType/directory>,
        <https://spdx.org/rdf/3.0.1/terms/Software/FileKindType/file> .

spdx:VexVulnAssessmentRelationship a owl:Class ;
    rdfs:label "VexVulnAssessmentRelationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spdx:statusNotes ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spdx:vexVersion ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:vexVersion ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:vexVersion ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:statusNotes ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:statusNotes ],
        spdx:VulnAssessmentRelationship ;
    skos:definition "Abstract ancestor class for all VEX relationships" ;
    skos:exactMatch security:VexVulnAssessmentRelationship ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_message "https://spdx.org/rdf/3.0.1/terms/Security/VexVulnAssessmentRelationship is an abstract class and should not be instantiated directly. Instantiate a subclass instead." ;
    spdx:shacl_node_kind "sh:IRI" ;
    spdx:shacl_not "{ sh:hasValue security:VexVulnAssessmentRelationship }" .

spdx:member a owl:ObjectProperty ;
    rdfs:label "member" ;
    rdfs:range spdx:AnyLicenseInfo ;
    skos:definition "A license expression participating in a license set." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:seeAlso a owl:DatatypeProperty ;
    rdfs:label "seeAlso" ;
    rdfs:range xsd:anyURI ;
    skos:definition "Contains a URL where the License or LicenseAddition can be found in use." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:verifiedUsing a owl:ObjectProperty ;
    rdfs:label "verifiedUsing" ;
    rdfs:range spdx:IntegrityMethod ;
    skos:definition """Provides an IntegrityMethod with which the integrity of an Element can be
asserted.""" ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

ai:EnergyUnitType a owl:Class ;
    rdfs:label "EnergyUnitType" ;
    owl:unionOf ( <https://spdx.org/rdf/3.0.1/terms/AI/EnergyUnitType/kilowattHour> <https://spdx.org/rdf/3.0.1/terms/AI/EnergyUnitType/megajoule> <https://spdx.org/rdf/3.0.1/terms/AI/EnergyUnitType/other> ) ;
    skos:definition "Specifies the unit of energy consumption." ;
    skos:editorialNote "Open/extensible enum: slots using this type allow any string via any_of." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    linkml:permissible_values <https://spdx.org/rdf/3.0.1/terms/AI/EnergyUnitType/kilowattHour>,
        <https://spdx.org/rdf/3.0.1/terms/AI/EnergyUnitType/megajoule>,
        <https://spdx.org/rdf/3.0.1/terms/AI/EnergyUnitType/other> .

core:RelationshipCompleteness a owl:Class ;
    rdfs:label "RelationshipCompleteness" ;
    owl:unionOf ( <https://spdx.org/rdf/3.0.1/terms/Core/RelationshipCompleteness/complete> <https://spdx.org/rdf/3.0.1/terms/Core/RelationshipCompleteness/incomplete> <https://spdx.org/rdf/3.0.1/terms/Core/RelationshipCompleteness/noAssertion> ) ;
    skos:definition "Indicates whether a relationship is known to be complete, incomplete, or if no assertion is made with respect to relationship completeness." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    linkml:permissible_values <https://spdx.org/rdf/3.0.1/terms/Core/RelationshipCompleteness/complete>,
        <https://spdx.org/rdf/3.0.1/terms/Core/RelationshipCompleteness/incomplete>,
        <https://spdx.org/rdf/3.0.1/terms/Core/RelationshipCompleteness/noAssertion> .

spdx:SoftwareArtifact a owl:Class ;
    rdfs:label "SoftwareArtifact" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:copyrightText ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:copyrightText ],
        [ a owl:Restriction ;
            owl:allValuesFrom spdx:ContentIdentifier ;
            owl:onProperty spdx:contentIdentifier ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:contentIdentifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spdx:copyrightText ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:attributionText ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spdx:attributionText ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:unionOf ( software:SoftwarePurpose xsd:string ) ] ;
            owl:onProperty spdx:additionalPurpose ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:unionOf ( software:SoftwarePurpose xsd:string ) ] ;
            owl:onProperty spdx:primaryPurpose ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:primaryPurpose ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:additionalPurpose ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:primaryPurpose ],
        spdx:Artifact ;
    skos:definition "A distinct article or unit related to Software." ;
    skos:exactMatch software:SoftwareArtifact ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_message "https://spdx.org/rdf/3.0.1/terms/Software/SoftwareArtifact is an abstract class and should not be instantiated directly. Instantiate a subclass instead." ;
    spdx:shacl_node_kind "sh:IRI" ;
    spdx:shacl_not "{ sh:hasValue software:SoftwareArtifact }" .

ai:SafetyRiskAssessmentType a owl:Class ;
    rdfs:label "SafetyRiskAssessmentType" ;
    owl:unionOf ( <https://spdx.org/rdf/3.0.1/terms/AI/SafetyRiskAssessmentType/high> <https://spdx.org/rdf/3.0.1/terms/AI/SafetyRiskAssessmentType/low> <https://spdx.org/rdf/3.0.1/terms/AI/SafetyRiskAssessmentType/medium> <https://spdx.org/rdf/3.0.1/terms/AI/SafetyRiskAssessmentType/serious> ) ;
    skos:definition "Specifies the safety risk level." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    linkml:permissible_values <https://spdx.org/rdf/3.0.1/terms/AI/SafetyRiskAssessmentType/high>,
        <https://spdx.org/rdf/3.0.1/terms/AI/SafetyRiskAssessmentType/low>,
        <https://spdx.org/rdf/3.0.1/terms/AI/SafetyRiskAssessmentType/medium>,
        <https://spdx.org/rdf/3.0.1/terms/AI/SafetyRiskAssessmentType/serious> .

dataset:ConfidentialityLevelType a owl:Class ;
    rdfs:label "ConfidentialityLevelType" ;
    owl:unionOf ( <https://spdx.org/rdf/3.0.1/terms/Dataset/ConfidentialityLevelType/amber> <https://spdx.org/rdf/3.0.1/terms/Dataset/ConfidentialityLevelType/clear> <https://spdx.org/rdf/3.0.1/terms/Dataset/ConfidentialityLevelType/green> <https://spdx.org/rdf/3.0.1/terms/Dataset/ConfidentialityLevelType/red> ) ;
    skos:definition "Categories of confidentiality level." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    linkml:permissible_values <https://spdx.org/rdf/3.0.1/terms/Dataset/ConfidentialityLevelType/amber>,
        <https://spdx.org/rdf/3.0.1/terms/Dataset/ConfidentialityLevelType/clear>,
        <https://spdx.org/rdf/3.0.1/terms/Dataset/ConfidentialityLevelType/green>,
        <https://spdx.org/rdf/3.0.1/terms/Dataset/ConfidentialityLevelType/red> .

spdx:EnergyConsumptionDescription a owl:Class ;
    rdfs:label "EnergyConsumptionDescription" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty spdx:energyQuantity ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty spdx:energyQuantity ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:energyQuantity ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:unionOf ( ai:EnergyUnitType xsd:string ) ] ;
            owl:onProperty spdx:energyUnit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:energyUnit ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty spdx:energyUnit ] ;
    skos:definition """The class that helps note down the quantity of energy consumption and the unit
used for measurement.""" ;
    skos:exactMatch ai:EnergyConsumptionDescription ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_node_kind "sh:BlankNodeOrIRI" .

spdx:IntegrityMethod a owl:Class ;
    rdfs:label "IntegrityMethod" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spdx:comment ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:comment ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:comment ] ;
    skos:definition "Provides an independently reproducible mechanism that permits verification of a specific Element." ;
    skos:exactMatch core:IntegrityMethod ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_message "https://spdx.org/rdf/3.0.1/terms/Core/IntegrityMethod is an abstract class and should not be instantiated directly. Instantiate a subclass instead." ;
    spdx:shacl_node_kind "sh:BlankNodeOrIRI" ;
    spdx:shacl_not "{ sh:hasValue core:IntegrityMethod }" .

security:SsvcDecisionType a owl:Class ;
    rdfs:label "SsvcDecisionType" ;
    owl:unionOf ( <https://spdx.org/rdf/3.0.1/terms/Security/SsvcDecisionType/act> <https://spdx.org/rdf/3.0.1/terms/Security/SsvcDecisionType/attend> <https://spdx.org/rdf/3.0.1/terms/Security/SsvcDecisionType/track> <https://spdx.org/rdf/3.0.1/terms/Security/SsvcDecisionType/trackStar> ) ;
    skos:definition "Specifies the SSVC decision type." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    linkml:permissible_values <https://spdx.org/rdf/3.0.1/terms/Security/SsvcDecisionType/act>,
        <https://spdx.org/rdf/3.0.1/terms/Security/SsvcDecisionType/attend>,
        <https://spdx.org/rdf/3.0.1/terms/Security/SsvcDecisionType/track>,
        <https://spdx.org/rdf/3.0.1/terms/Security/SsvcDecisionType/trackStar> .

spdx:algorithm a owl:DatatypeProperty ;
    rdfs:label "algorithm" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:unionOf ( core:HashAlgorithm xsd:string ) ] ;
    skos:definition "Specifies the algorithm used for calculating the hash value." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:deprecatedVersion a owl:DatatypeProperty ;
    rdfs:label "deprecatedVersion" ;
    rdfs:range xsd:string ;
    skos:definition """Specifies the SPDX License List version in which this license or exception
identifier was deprecated.""" ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:hashValue a owl:DatatypeProperty ;
    rdfs:label "hashValue" ;
    rdfs:range xsd:string ;
    skos:definition "The result of applying a hash algorithm to an Element." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:licenseText a owl:DatatypeProperty ;
    rdfs:label "licenseText" ;
    rdfs:range xsd:string ;
    skos:definition "Identifies the full text of a License or Addition." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:licenseXml a owl:DatatypeProperty ;
    rdfs:label "licenseXml" ;
    rdfs:range xsd:string ;
    skos:definition """Identifies all the text and metadata associated with a license in the license
XML format.""" ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:listVersionAdded a owl:DatatypeProperty ;
    rdfs:label "listVersionAdded" ;
    rdfs:range xsd:string ;
    skos:definition """Specifies the SPDX License List version in which this ListedLicense or
ListedLicenseException identifier was first added.""" ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:modifiedTime a owl:DatatypeProperty ;
    rdfs:label "modifiedTime" ;
    rdfs:range xsd:dateTime ;
    skos:definition "Specifies a time when a vulnerability assessment was modified" ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:obsoletedBy a owl:DatatypeProperty ;
    rdfs:label "obsoletedBy" ;
    rdfs:range xsd:string ;
    skos:definition """Specifies the licenseId that is preferred to be used in place of a deprecated
License or LicenseAddition.""" ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:publishedTime a owl:DatatypeProperty ;
    rdfs:label "publishedTime" ;
    rdfs:range xsd:dateTime ;
    skos:definition "Specifies the time when a vulnerability was published." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:severity a owl:ObjectProperty ;
    rdfs:label "severity" ;
    rdfs:range security:CvssSeverityType ;
    skos:definition "Specifies the CVSS qualitative severity rating of a vulnerability in relation to a piece of software." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:suppliedBy a owl:ObjectProperty ;
    rdfs:label "suppliedBy" ;
    rdfs:range spdx:Agent ;
    skos:definition """Identifies who or what supplied the artifact or VulnAssessmentRelationship
referenced by the Element.""" ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

spdx:withdrawnTime a owl:DatatypeProperty ;
    rdfs:label "withdrawnTime" ;
    rdfs:range xsd:dateTime ;
    skos:definition "Specified the time and date when a vulnerability was withdrawn." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> .

dataset:DatasetAvailabilityType a owl:Class ;
    rdfs:label "DatasetAvailabilityType" ;
    owl:unionOf ( <https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetAvailabilityType/clickthrough> <https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetAvailabilityType/directDownload> <https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetAvailabilityType/query> <https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetAvailabilityType/registration> <https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetAvailabilityType/scrapingScript> ) ;
    skos:definition "Availability of dataset." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    linkml:permissible_values <https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetAvailabilityType/clickthrough>,
        <https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetAvailabilityType/directDownload>,
        <https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetAvailabilityType/query>,
        <https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetAvailabilityType/registration>,
        <https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetAvailabilityType/scrapingScript> .

security:VexJustificationType a owl:Class ;
    rdfs:label "VexJustificationType" ;
    owl:unionOf ( <https://spdx.org/rdf/3.0.1/terms/Security/VexJustificationType/componentNotPresent> <https://spdx.org/rdf/3.0.1/terms/Security/VexJustificationType/inlineMitigationsAlreadyExist> <https://spdx.org/rdf/3.0.1/terms/Security/VexJustificationType/vulnerableCodeCannotBeControlledByAdversary> <https://spdx.org/rdf/3.0.1/terms/Security/VexJustificationType/vulnerableCodeNotInExecutePath> <https://spdx.org/rdf/3.0.1/terms/Security/VexJustificationType/vulnerableCodeNotPresent> ) ;
    skos:definition "Specifies the VEX justification type." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    linkml:permissible_values <https://spdx.org/rdf/3.0.1/terms/Security/VexJustificationType/componentNotPresent>,
        <https://spdx.org/rdf/3.0.1/terms/Security/VexJustificationType/inlineMitigationsAlreadyExist>,
        <https://spdx.org/rdf/3.0.1/terms/Security/VexJustificationType/vulnerableCodeCannotBeControlledByAdversary>,
        <https://spdx.org/rdf/3.0.1/terms/Security/VexJustificationType/vulnerableCodeNotInExecutePath>,
        <https://spdx.org/rdf/3.0.1/terms/Security/VexJustificationType/vulnerableCodeNotPresent> .

spdx:VulnAssessmentRelationship a owl:Class ;
    rdfs:label "VulnAssessmentRelationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:suppliedBy ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:modifiedTime ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:dateTime [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^\\d\\d\\d\\d-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$" ] ) ] ) ] ;
            owl:onProperty spdx:withdrawnTime ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:assessedElement ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:publishedTime ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:suppliedBy ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:assessedElement ],
        [ a owl:Restriction ;
            owl:allValuesFrom spdx:SoftwareArtifact ;
            owl:onProperty spdx:assessedElement ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:modifiedTime ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:withdrawnTime ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:publishedTime ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:dateTime [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^\\d\\d\\d\\d-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$" ] ) ] ) ] ;
            owl:onProperty spdx:modifiedTime ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:dateTime [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^\\d\\d\\d\\d-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$" ] ) ] ) ] ;
            owl:onProperty spdx:publishedTime ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:withdrawnTime ],
        [ a owl:Restriction ;
            owl:allValuesFrom spdx:Agent ;
            owl:onProperty spdx:suppliedBy ],
        spdx:Relationship ;
    skos:definition "Abstract ancestor class for all vulnerability assessments" ;
    skos:exactMatch security:VulnAssessmentRelationship ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_message "https://spdx.org/rdf/3.0.1/terms/Security/VulnAssessmentRelationship is an abstract class and should not be instantiated directly. Instantiate a subclass instead." ;
    spdx:shacl_node_kind "sh:IRI" ;
    spdx:shacl_not "{ sh:hasValue security:VulnAssessmentRelationship }" .

core:LifecycleScopeType a owl:Class ;
    rdfs:label "LifecycleScopeType" ;
    owl:unionOf ( <https://spdx.org/rdf/3.0.1/terms/Core/LifecycleScopeType/build> <https://spdx.org/rdf/3.0.1/terms/Core/LifecycleScopeType/design> <https://spdx.org/rdf/3.0.1/terms/Core/LifecycleScopeType/development> <https://spdx.org/rdf/3.0.1/terms/Core/LifecycleScopeType/other> <https://spdx.org/rdf/3.0.1/terms/Core/LifecycleScopeType/runtime> <https://spdx.org/rdf/3.0.1/terms/Core/LifecycleScopeType/test> ) ;
    skos:definition "Provide an enumerated set of lifecycle phases that can provide context to relationships." ;
    skos:editorialNote "Open/extensible enum: slots using this type allow any string via any_of." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    linkml:permissible_values <https://spdx.org/rdf/3.0.1/terms/Core/LifecycleScopeType/build>,
        <https://spdx.org/rdf/3.0.1/terms/Core/LifecycleScopeType/design>,
        <https://spdx.org/rdf/3.0.1/terms/Core/LifecycleScopeType/development>,
        <https://spdx.org/rdf/3.0.1/terms/Core/LifecycleScopeType/other>,
        <https://spdx.org/rdf/3.0.1/terms/Core/LifecycleScopeType/runtime>,
        <https://spdx.org/rdf/3.0.1/terms/Core/LifecycleScopeType/test> .

security:CvssSeverityType a owl:Class ;
    rdfs:label "CvssSeverityType" ;
    owl:unionOf ( <https://spdx.org/rdf/3.0.1/terms/Security/CvssSeverityType/critical> <https://spdx.org/rdf/3.0.1/terms/Security/CvssSeverityType/high> <https://spdx.org/rdf/3.0.1/terms/Security/CvssSeverityType/low> <https://spdx.org/rdf/3.0.1/terms/Security/CvssSeverityType/medium> <https://spdx.org/rdf/3.0.1/terms/Security/CvssSeverityType/none> ) ;
    skos:definition "Specifies the CVSS base, temporal, threat, or environmental severity type." ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    linkml:permissible_values <https://spdx.org/rdf/3.0.1/terms/Security/CvssSeverityType/critical>,
        <https://spdx.org/rdf/3.0.1/terms/Security/CvssSeverityType/high>,
        <https://spdx.org/rdf/3.0.1/terms/Security/CvssSeverityType/low>,
        <https://spdx.org/rdf/3.0.1/terms/Security/CvssSeverityType/medium>,
        <https://spdx.org/rdf/3.0.1/terms/Security/CvssSeverityType/none> .

software:SbomType a owl:Class ;
    rdfs:label "SbomType" ;
