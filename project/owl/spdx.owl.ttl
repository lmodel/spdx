@prefix ai: <https://spdx.org/rdf/3.0.1/terms/AI/> .
@prefix build: <https://spdx.org/rdf/3.0.1/terms/Build/> .
@prefix core: <https://spdx.org/rdf/3.0.1/terms/Core/> .
@prefix dataset: <https://spdx.org/rdf/3.0.1/terms/Dataset/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix expandedlicensing: <https://spdx.org/rdf/3.0.1/terms/ExpandedLicensing/> .
@prefix extension: <https://spdx.org/rdf/3.0.1/terms/Extension/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pav: <http://purl.org/pav/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix security: <https://spdx.org/rdf/3.0.1/terms/Security/> .
@prefix simplelicensing: <https://spdx.org/rdf/3.0.1/terms/SimpleLicensing/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix software: <https://spdx.org/rdf/3.0.1/terms/Software/> .
@prefix spdx: <https://spdx.org/rdf/3.0.1/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

spdx:AIPackage a owl:Class ;
    rdfs:label "AIPackage" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spdx:standardCompliance ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:modelExplainability ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spdx:modelExplainability ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spdx:informationAboutTraining ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:informationAboutApplication ],
        [ a owl:Restriction ;
            owl:allValuesFrom spdx:EnergyConsumption ;
            owl:onProperty spdx:energyConsumption ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spdx:limitation ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spdx:domain ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:domain ],
        [ a owl:Restriction ;
            owl:allValuesFrom spdx:DictionaryEntry ;
            owl:onProperty spdx:metricDecisionThreshold ],
        [ a owl:Restriction ;
            owl:allValuesFrom core:PresenceType ;
            owl:onProperty spdx:autonomyType ],
        [ a owl:Restriction ;
            owl:allValuesFrom spdx:DictionaryEntry ;
            owl:onProperty spdx:hyperparameter ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:autonomyType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:limitation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:safetyRiskAssessment ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:useSensitivePersonalInformation ],
        [ a owl:Restriction ;
            owl:allValuesFrom ai:SafetyRiskAssessmentType ;
            owl:onProperty spdx:safetyRiskAssessment ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:metric ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:modelDataPreprocessing ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:energyConsumption ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:metricDecisionThreshold ],
        [ a owl:Restriction ;
            owl:allValuesFrom spdx:DictionaryEntry ;
            owl:onProperty spdx:metric ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:informationAboutTraining ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:informationAboutTraining ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:useSensitivePersonalInformation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:energyConsumption ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spdx:informationAboutApplication ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:informationAboutApplication ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:autonomyType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:limitation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:typeOfModel ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:hyperparameter ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spdx:modelDataPreprocessing ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spdx:typeOfModel ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:safetyRiskAssessment ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:standardCompliance ],
        [ a owl:Restriction ;
            owl:allValuesFrom core:PresenceType ;
            owl:onProperty spdx:useSensitivePersonalInformation ],
        spdx:Package ;
    skos:definition "Specifies an AI package and its associated information." ;
    skos:exactMatch ai:AIPackage ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_node_kind "sh:IRI" .

spdx:Annotation a owl:Class ;
    rdfs:label "Annotation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty spdx:annotationType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:annotationType ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:unionOf ( core:AnnotationType xsd:string ) ] ;
            owl:onProperty spdx:annotationType ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty spdx:subject ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:statement ],
        [ a owl:Restriction ;
            owl:allValuesFrom spdx:Element ;
            owl:onProperty spdx:subject ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:contentType ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spdx:statement ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:subject ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^[^\\/]+\\/[^\\/]+$" ] ) ] ) ] ;
            owl:onProperty spdx:contentType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:contentType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:statement ],
        spdx:Element ;
    skos:definition "An assertion made in relation to one or more elements." ;
    skos:exactMatch core:Annotation ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_node_kind "sh:IRI" .

spdx:Build a owl:Class ;
    rdfs:label "Build" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:configSourceEntrypoint ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:buildEndTime ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:buildId ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:buildStartTime ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spdx:configSourceEntrypoint ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty spdx:buildType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:buildEndTime ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty spdx:configSourceUri ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:buildType ],
        [ a owl:Restriction ;
            owl:allValuesFrom spdx:DictionaryEntry ;
            owl:onProperty spdx:environment ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:configSourceUri ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:configSourceDigest ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:buildId ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:dateTime [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^\\d\\d\\d\\d-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$" ] ) ] ) ] ;
            owl:onProperty spdx:buildStartTime ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:environment ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty spdx:buildType ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spdx:buildId ],
        [ a owl:Restriction ;
            owl:allValuesFrom spdx:Hash ;
            owl:onProperty spdx:configSourceDigest ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:dateTime [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^\\d\\d\\d\\d-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$" ] ) ] ) ] ;
            owl:onProperty spdx:buildEndTime ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:buildStartTime ],
        [ a owl:Restriction ;
            owl:allValuesFrom spdx:DictionaryEntry ;
            owl:onProperty spdx:parameter ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:parameter ],
        spdx:Element ;
    skos:definition "Class that describes a build instance of software/artifacts." ;
    skos:exactMatch build:Build ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_node_kind "sh:IRI" .

spdx:CdxPropertiesExtension a owl:Class ;
    rdfs:label "CdxPropertiesExtension" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom spdx:CdxPropertyEntry ;
            owl:onProperty spdx:cdxProperty ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty spdx:cdxProperty ],
        spdx:Extension ;
    skos:definition "A type of extension consisting of a list of name value pairs." ;
    skos:exactMatch extension:CdxPropertiesExtension ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_node_kind "sh:BlankNodeOrIRI" .

spdx:ConjunctiveLicenseSet a owl:Class ;
    rdfs:label "ConjunctiveLicenseSet" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty spdx:member ],
        [ a owl:Restriction ;
            owl:allValuesFrom spdx:AnyLicenseInfo ;
            owl:onProperty spdx:member ],
        spdx:AnyLicenseInfo ;
    skos:definition """Portion of an AnyLicenseInfo representing a set of licensing information
where all elements apply.""" ;
    skos:exactMatch expandedlicensing:ConjunctiveLicenseSet ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_node_kind "sh:IRI" .

spdx:CustomLicense a owl:Class ;
    rdfs:label "CustomLicense" ;
    rdfs:subClassOf spdx:License ;
    skos:definition "A license that is not listed on the SPDX License List." ;
    skos:exactMatch expandedlicensing:CustomLicense ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_node_kind "sh:IRI" .

spdx:CustomLicenseAddition a owl:Class ;
    rdfs:label "CustomLicenseAddition" ;
    rdfs:subClassOf spdx:LicenseAddition ;
    skos:definition "A license addition that is not listed on the SPDX Exceptions List." ;
    skos:exactMatch expandedlicensing:CustomLicenseAddition ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_node_kind "sh:IRI" .

spdx:CvssV2VulnAssessmentRelationship a owl:Class ;
    rdfs:label "CvssV2VulnAssessmentRelationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty spdx:score ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty spdx:vectorString ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:vectorString ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty spdx:score ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:score ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spdx:vectorString ],
        spdx:VulnAssessmentRelationship ;
    skos:definition "Provides a CVSS version 2.0 assessment for a vulnerability." ;
    skos:exactMatch security:CvssV2VulnAssessmentRelationship ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_node_kind "sh:IRI" .

spdx:CvssV3VulnAssessmentRelationship a owl:Class ;
    rdfs:label "CvssV3VulnAssessmentRelationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty spdx:vectorString ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty spdx:score ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:vectorString ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spdx:vectorString ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:severity ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:score ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty spdx:severity ],
        [ a owl:Restriction ;
            owl:allValuesFrom security:CvssSeverityType ;
            owl:onProperty spdx:severity ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty spdx:score ],
        spdx:VulnAssessmentRelationship ;
    skos:definition "Provides a CVSS version 3 assessment for a vulnerability." ;
    skos:exactMatch security:CvssV3VulnAssessmentRelationship ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_node_kind "sh:IRI" .

spdx:CvssV4VulnAssessmentRelationship a owl:Class ;
    rdfs:label "CvssV4VulnAssessmentRelationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:score ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty spdx:severity ],
        [ a owl:Restriction ;
            owl:allValuesFrom security:CvssSeverityType ;
            owl:onProperty spdx:severity ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty spdx:score ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spdx:vectorString ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:severity ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty spdx:vectorString ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty spdx:score ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:vectorString ],
        spdx:VulnAssessmentRelationship ;
    skos:definition "Provides a CVSS version 4 assessment for a vulnerability." ;
    skos:exactMatch security:CvssV4VulnAssessmentRelationship ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_node_kind "sh:IRI" .

spdx:DatasetPackage a owl:Class ;
    rdfs:label "DatasetPackage" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:hasSensitivePersonalInformation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:datasetAvailability ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:datasetAvailability ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:datasetUpdateMechanism ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:datasetUpdateMechanism ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:datasetNoise ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:intendedUse ],
        [ a owl:Restriction ;
            owl:allValuesFrom dataset:ConfidentialityLevelType ;
            owl:onProperty spdx:confidentialityLevel ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spdx:anonymizationMethodUsed ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:datasetSize ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:datasetNoise ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty spdx:datasetType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:dataCollectionProcess ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:sensor ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:knownBias ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:confidentialityLevel ],
        [ a owl:Restriction ;
            owl:allValuesFrom core:PresenceType ;
            owl:onProperty spdx:hasSensitivePersonalInformation ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spdx:intendedUse ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spdx:dataPreprocessing ],
        [ a owl:Restriction ;
            owl:allValuesFrom dataset:DatasetAvailabilityType ;
            owl:onProperty spdx:datasetAvailability ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:anonymizationMethodUsed ],
        [ a owl:Restriction ;
            owl:allValuesFrom spdx:DictionaryEntry ;
            owl:onProperty spdx:sensor ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:dataPreprocessing ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:dataCollectionProcess ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:confidentialityLevel ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spdx:dataCollectionProcess ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
            owl:onProperty spdx:datasetSize ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:datasetSize ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:intendedUse ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spdx:knownBias ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spdx:datasetUpdateMechanism ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:unionOf ( dataset:DatasetType xsd:string ) ] ;
            owl:onProperty spdx:datasetType ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spdx:datasetNoise ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:hasSensitivePersonalInformation ],
        spdx:Package ;
    skos:definition "Specifies a data package and its associated information." ;
    skos:exactMatch dataset:DatasetPackage ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_node_kind "sh:IRI" .

spdx:DisjunctiveLicenseSet a owl:Class ;
    rdfs:label "DisjunctiveLicenseSet" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty spdx:member ],
        [ a owl:Restriction ;
            owl:allValuesFrom spdx:AnyLicenseInfo ;
            owl:onProperty spdx:member ],
        spdx:AnyLicenseInfo ;
    skos:definition """Portion of an AnyLicenseInfo representing a set of licensing information where
only one of the elements applies.""" ;
    skos:exactMatch expandedlicensing:DisjunctiveLicenseSet ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_node_kind "sh:IRI" .

spdx:EpssVulnAssessmentRelationship a owl:Class ;
    rdfs:label "EpssVulnAssessmentRelationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:percentile ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty spdx:percentile ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty spdx:probability ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty spdx:percentile ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:probability ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty spdx:probability ],
        spdx:VulnAssessmentRelationship ;
    skos:definition "Provides an EPSS assessment for a vulnerability." ;
    skos:exactMatch security:EpssVulnAssessmentRelationship ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_node_kind "sh:IRI" .

spdx:ExploitCatalogVulnAssessmentRelationship a owl:Class ;
    rdfs:label "ExploitCatalogVulnAssessmentRelationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty spdx:exploited ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty spdx:security_locator ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty spdx:security_locator ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:catalogType ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty spdx:exploited ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:exploited ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:security_locator ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty spdx:catalogType ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:unionOf ( security:ExploitCatalogType xsd:string ) ] ;
            owl:onProperty spdx:catalogType ],
        spdx:VulnAssessmentRelationship ;
    skos:definition "Provides an exploit assessment of a vulnerability." ;
    skos:exactMatch security:ExploitCatalogVulnAssessmentRelationship ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_node_kind "sh:IRI" .

spdx:IndividualElement a owl:Class ;
    rdfs:label "IndividualElement" ;
    rdfs:subClassOf spdx:Element ;
    skos:definition """A concrete subclass of Element used by Individuals in the
Core profile.""" ;
    skos:exactMatch core:IndividualElement ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_node_kind "sh:IRI" .

spdx:IndividualLicensingInfo a owl:Class ;
    rdfs:label "IndividualLicensingInfo" ;
    rdfs:subClassOf spdx:AnyLicenseInfo ;
    skos:definition """A concrete subclass of AnyLicenseInfo used by Individuals in the
ExpandedLicensing profile.""" ;
    skos:exactMatch expandedlicensing:IndividualLicensingInfo ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_node_kind "sh:IRI" .

spdx:LicenseExpression a owl:Class ;
    rdfs:label "LicenseExpression" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:licenseListVersion ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty spdx:licenseExpression ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spdx:licenseExpression ],
        [ a owl:Restriction ;
            owl:allValuesFrom spdx:DictionaryEntry ;
            owl:onProperty spdx:customIdToUri ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$" ] ) ] ) ] ;
            owl:onProperty spdx:licenseListVersion ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:licenseExpression ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:licenseListVersion ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:customIdToUri ],
        spdx:AnyLicenseInfo ;
    skos:definition "An SPDX Element containing an SPDX license expression string." ;
    skos:exactMatch simplelicensing:LicenseExpression ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_node_kind "sh:IRI" .

spdx:LifecycleScopedRelationship a owl:Class ;
    rdfs:label "LifecycleScopedRelationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:unionOf ( core:LifecycleScopeType xsd:string ) ] ;
            owl:onProperty spdx:scope ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:scope ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:scope ],
        spdx:Relationship ;
    skos:definition "Provide context for a relationship that occurs in the lifecycle." ;
    skos:exactMatch core:LifecycleScopedRelationship ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_node_kind "sh:IRI" .

spdx:ListedLicense a owl:Class ;
    rdfs:label "ListedLicense" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spdx:listVersionAdded ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:deprecatedVersion ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:deprecatedVersion ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:listVersionAdded ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spdx:deprecatedVersion ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:listVersionAdded ],
        spdx:License ;
    skos:definition "A license that is listed on the SPDX License List." ;
    skos:exactMatch expandedlicensing:ListedLicense ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_node_kind "sh:IRI" .

spdx:ListedLicenseException a owl:Class ;
    rdfs:label "ListedLicenseException" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:listVersionAdded ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spdx:listVersionAdded ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spdx:deprecatedVersion ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:deprecatedVersion ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:deprecatedVersion ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:listVersionAdded ],
        spdx:LicenseAddition ;
    skos:definition "A license exception that is listed on the SPDX Exceptions list." ;
    skos:exactMatch expandedlicensing:ListedLicenseException ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_node_kind "sh:IRI" .

spdx:OrLaterOperator a owl:Class ;
    rdfs:label "OrLaterOperator" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom spdx:License ;
            owl:onProperty spdx:subjectLicense ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:subjectLicense ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty spdx:subjectLicense ],
        spdx:ExtendableLicense ;
    skos:definition """Portion of an AnyLicenseInfo representing this version, or any later version,
of the indicated License.""" ;
    skos:exactMatch expandedlicensing:OrLaterOperator ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_node_kind "sh:IRI" .

spdx:Organization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:subClassOf spdx:Agent ;
    skos:definition "A group of people who work together in an organized way for a shared purpose." ;
    skos:exactMatch core:Organization ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_node_kind "sh:IRI" .

spdx:PackageVerificationCode a owl:Class ;
    rdfs:label "PackageVerificationCode" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:algorithm ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty spdx:algorithm ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spdx:packageVerificationCodeExcludedFile ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:unionOf ( core:HashAlgorithm xsd:string ) ] ;
            owl:onProperty spdx:algorithm ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spdx:hashValue ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:packageVerificationCodeExcludedFile ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:hashValue ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty spdx:hashValue ],
        spdx:IntegrityMethod ;
    skos:definition "An SPDX version 2.X compatible verification method for software packages." ;
    skos:exactMatch core:PackageVerificationCode ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_node_kind "sh:BlankNodeOrIRI" .

spdx:Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:subClassOf spdx:Agent ;
    skos:definition "An individual human being." ;
    skos:exactMatch core:Person ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_node_kind "sh:IRI" .

spdx:Sbom a owl:Class ;
    rdfs:label "Sbom" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:sbomType ],
        [ a owl:Restriction ;
            owl:allValuesFrom software:SbomType ;
            owl:onProperty spdx:sbomType ],
        spdx:Bom ;
    skos:definition "A collection of SPDX Elements describing a single package." ;
    skos:exactMatch software:Sbom ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_node_kind "sh:IRI" .

spdx:SimpleLicensingText a owl:Class ;
    rdfs:label "SimpleLicensingText" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:licenseText ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spdx:licenseText ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty spdx:licenseText ],
        spdx:Element ;
    skos:definition "A license or addition that is not listed on the SPDX License List." ;
    skos:exactMatch simplelicensing:SimpleLicensingText ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_node_kind "sh:IRI" .

spdx:Snippet a owl:Class ;
    rdfs:label "Snippet" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom spdx:File ;
            owl:onProperty spdx:snippetFromFile ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:byteRange ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:lineRange ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:lineRange ],
        [ a owl:Restriction ;
            owl:allValuesFrom spdx:PositiveIntegerRange ;
            owl:onProperty spdx:byteRange ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:snippetFromFile ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty spdx:snippetFromFile ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:byteRange ],
        [ a owl:Restriction ;
            owl:allValuesFrom spdx:PositiveIntegerRange ;
            owl:onProperty spdx:lineRange ],
        spdx:SoftwareArtifact ;
    skos:definition "Describes a certain part of a file." ;
    skos:exactMatch software:Snippet ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_node_kind "sh:IRI" .

spdx:SoftwareAgent a owl:Class ;
    rdfs:label "SoftwareAgent" ;
    rdfs:subClassOf spdx:Agent ;
    skos:definition "A software agent." ;
    skos:exactMatch core:SoftwareAgent ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_node_kind "sh:IRI" .

spdx:SpdxDocument a owl:Class ;
    rdfs:label "SpdxDocument" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:dataLicense ],
        [ a owl:Restriction ;
            owl:allValuesFrom spdx:AnyLicenseInfo ;
            owl:onProperty spdx:dataLicense ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:namespaceMap ],
        [ a owl:Restriction ;
            owl:allValuesFrom spdx:NamespaceMap ;
            owl:onProperty spdx:namespaceMap ],
        [ a owl:Restriction ;
            owl:allValuesFrom spdx:ExternalMap ;
            owl:onProperty spdx:import ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:dataLicense ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:import ],
        spdx:ElementCollection ;
    skos:definition "A collection of SPDX Elements that could potentially be serialized." ;
    skos:exactMatch core:SpdxDocument ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_node_kind "sh:IRI" .

spdx:SsvcVulnAssessmentRelationship a owl:Class ;
    rdfs:label "SsvcVulnAssessmentRelationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty spdx:decisionType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:decisionType ],
        [ a owl:Restriction ;
            owl:allValuesFrom security:SsvcDecisionType ;
            owl:onProperty spdx:decisionType ],
        spdx:VulnAssessmentRelationship ;
    skos:definition "Provides an SSVC assessment for a vulnerability." ;
    skos:exactMatch security:SsvcVulnAssessmentRelationship ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_node_kind "sh:IRI" .

spdx:VexAffectedVulnAssessmentRelationship a owl:Class ;
    rdfs:label "VexAffectedVulnAssessmentRelationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty spdx:actionStatement ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:actionStatementTime ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:actionStatementTime ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:actionStatement ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spdx:actionStatement ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:dateTime [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^\\d\\d\\d\\d-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$" ] ) ] ) ] ;
            owl:onProperty spdx:actionStatementTime ],
        spdx:VexVulnAssessmentRelationship ;
    skos:definition """Connects a vulnerability and an element designating the element as a product
affected by the vulnerability.""" ;
    skos:exactMatch security:VexAffectedVulnAssessmentRelationship ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_node_kind "sh:IRI" .

spdx:VexFixedVulnAssessmentRelationship a owl:Class ;
    rdfs:label "VexFixedVulnAssessmentRelationship" ;
    rdfs:subClassOf spdx:VexVulnAssessmentRelationship ;
    skos:definition """Links a vulnerability and elements representing products (in the VEX sense) where
a fix has been applied and are no longer affected.""" ;
    skos:exactMatch security:VexFixedVulnAssessmentRelationship ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_node_kind "sh:IRI" .

spdx:VexNotAffectedVulnAssessmentRelationship a owl:Class ;
    rdfs:label "VexNotAffectedVulnAssessmentRelationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:impactStatement ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:justificationType ],
        [ a owl:Restriction ;
            owl:allValuesFrom security:VexJustificationType ;
            owl:onProperty spdx:justificationType ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:dateTime [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^\\d\\d\\d\\d-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$" ] ) ] ) ] ;
            owl:onProperty spdx:impactStatementTime ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:impactStatementTime ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:impactStatement ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spdx:impactStatement ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:impactStatementTime ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:justificationType ],
        spdx:VexVulnAssessmentRelationship ;
    skos:definition """Links a vulnerability and one or more elements designating the latter as products
not affected by the vulnerability.""" ;
    skos:exactMatch security:VexNotAffectedVulnAssessmentRelationship ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_node_kind "sh:IRI" .

spdx:VexUnderInvestigationVulnAssessmentRelationship a owl:Class ;
    rdfs:label "VexUnderInvestigationVulnAssessmentRelationship" ;
    rdfs:subClassOf spdx:VexVulnAssessmentRelationship ;
    skos:definition """Designates elements as products where the impact of a vulnerability is being
investigated.""" ;
    skos:exactMatch security:VexUnderInvestigationVulnAssessmentRelationship ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_node_kind "sh:IRI" .

spdx:Vulnerability a owl:Class ;
    rdfs:label "Vulnerability" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:publishedTime ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:withdrawnTime ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:dateTime [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^\\d\\d\\d\\d-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$" ] ) ] ) ] ;
            owl:onProperty spdx:withdrawnTime ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:dateTime [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^\\d\\d\\d\\d-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$" ] ) ] ) ] ;
            owl:onProperty spdx:modifiedTime ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:withdrawnTime ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:publishedTime ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:modifiedTime ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:modifiedTime ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:dateTime [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^\\d\\d\\d\\d-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$" ] ) ] ) ] ;
            owl:onProperty spdx:publishedTime ],
        spdx:Artifact ;
    skos:definition "Specifies a vulnerability and its associated information." ;
    skos:exactMatch security:Vulnerability ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_node_kind "sh:IRI" .

spdx:WithAdditionOperator a owl:Class ;
    rdfs:label "WithAdditionOperator" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty spdx:subjectAddition ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty spdx:subjectExtendableLicense ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:subjectExtendableLicense ],
        [ a owl:Restriction ;
            owl:allValuesFrom spdx:LicenseAddition ;
            owl:onProperty spdx:subjectAddition ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:subjectAddition ],
        [ a owl:Restriction ;
            owl:allValuesFrom spdx:ExtendableLicense ;
            owl:onProperty spdx:subjectExtendableLicense ],
        spdx:AnyLicenseInfo ;
    skos:definition """Portion of an AnyLicenseInfo representing a License which has additional
text applied to it.""" ;
    skos:exactMatch expandedlicensing:WithAdditionOperator ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_node_kind "sh:IRI" .

<https://w3id.org/lmodel/spdx.owl.ttl> a owl:Ontology ;
    rdfs:label "spdx" ;
    dcterms:license "Apache-2.0" ;
    dcterms:source <https://spdx.github.io/spdx-spec/v3.0/rdf/spdx-model.ttl> ;
    dcterms:title "spdx" ;
    pav:version "3.0.1" ;
    rdfs:seeAlso <https://lmodel.github.io/spdx>,
        <https://spdx.dev/specifications/> ;
    skos:definition "System Package Data Exchange (SPDX), LinkML schema" ;
    skos:note "This ontology defines the terms and relationships used in the SPDX specification to describe system packages" .

spdx:Bom a owl:Class ;
    rdfs:label "Bom" ;
    rdfs:subClassOf spdx:Bundle ;
    skos:definition """A container for a grouping of SPDX-3.0 content characterizing details
(provenence, composition, licensing, etc.) about a product.""" ;
    skos:exactMatch core:Bom ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_node_kind "sh:IRI" .

spdx:Bundle a owl:Class ;
    rdfs:label "Bundle" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:context ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spdx:context ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:context ],
        spdx:ElementCollection ;
    skos:definition "A collection of Elements that have a shared context." ;
    skos:exactMatch core:Bundle ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_node_kind "sh:IRI" .

<https://spdx.org/rdf/3.0.1/terms/AI/EnergyUnitType/kilowattHour> a owl:Class ;
    rdfs:label "kilowattHour" ;
    rdfs:subClassOf ai:EnergyUnitType ;
    skos:definition "Kilowatt-hour." .

<https://spdx.org/rdf/3.0.1/terms/AI/EnergyUnitType/megajoule> a owl:Class ;
    rdfs:label "megajoule" ;
    rdfs:subClassOf ai:EnergyUnitType ;
    skos:definition "Megajoule." .

<https://spdx.org/rdf/3.0.1/terms/AI/EnergyUnitType/other> a owl:Class ;
    rdfs:label "other" ;
    rdfs:subClassOf ai:EnergyUnitType ;
    skos:definition "Any other units of energy measurement." .

<https://spdx.org/rdf/3.0.1/terms/AI/SafetyRiskAssessmentType/high> a owl:Class ;
    rdfs:label "high" ;
    rdfs:subClassOf ai:SafetyRiskAssessmentType ;
    skos:definition "The second-highest level of risk posed by an AI system." .

<https://spdx.org/rdf/3.0.1/terms/AI/SafetyRiskAssessmentType/low> a owl:Class ;
    rdfs:label "low" ;
    rdfs:subClassOf ai:SafetyRiskAssessmentType ;
    skos:definition "Low/no risk is posed by an AI system." .

<https://spdx.org/rdf/3.0.1/terms/AI/SafetyRiskAssessmentType/medium> a owl:Class ;
    rdfs:label "medium" ;
    rdfs:subClassOf ai:SafetyRiskAssessmentType ;
    skos:definition "The third-highest level of risk posed by an AI system." .

<https://spdx.org/rdf/3.0.1/terms/AI/SafetyRiskAssessmentType/serious> a owl:Class ;
    rdfs:label "serious" ;
    rdfs:subClassOf ai:SafetyRiskAssessmentType ;
    skos:definition "The highest level of risk posed by an AI system." .

spdx:CdxPropertyEntry a owl:Class ;
    rdfs:label "CdxPropertyEntry" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:cdxPropName ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spdx:cdxPropValue ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty spdx:cdxPropName ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spdx:cdxPropName ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:cdxPropValue ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:cdxPropValue ] ;
    skos:definition "A property name with an associated value." ;
    skos:exactMatch extension:CdxPropertyEntry ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_node_kind "sh:BlankNodeOrIRI" .

spdx:ContentIdentifier a owl:Class ;
    rdfs:label "ContentIdentifier" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:contentIdentifierValue ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty spdx:contentIdentifierValue ],
        [ a owl:Restriction ;
            owl:allValuesFrom software:ContentIdentifierType ;
            owl:onProperty spdx:contentIdentifierType ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty spdx:contentIdentifierType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:contentIdentifierType ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty spdx:contentIdentifierValue ],
        spdx:IntegrityMethod ;
    skos:definition "A canonical, unique, immutable identifier" ;
    skos:exactMatch software:ContentIdentifier ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_node_kind "sh:BlankNodeOrIRI" .

<https://spdx.org/rdf/3.0.1/terms/Core/AnnotationType/other> a owl:Class ;
    rdfs:label "other" ;
    rdfs:subClassOf core:AnnotationType ;
    skos:definition "Used to store extra information about an Element which is not part of a review (e.g. extra information provided during the creation of the Element)." .

<https://spdx.org/rdf/3.0.1/terms/Core/AnnotationType/review> a owl:Class ;
    rdfs:label "review" ;
    rdfs:subClassOf core:AnnotationType ;
    skos:definition "Used when someone reviews the Element." .

<https://spdx.org/rdf/3.0.1/terms/Core/ExternalIdentifierType/cpe22> a owl:Class ;
    rdfs:label "cpe22" ;
    rdfs:subClassOf core:ExternalIdentifierType ;
    skos:definition "[Common Platform Enumeration Specification 2.2](https://cpe.mitre.org/files/cpe-specification_2.2.pdf)" .

<https://spdx.org/rdf/3.0.1/terms/Core/ExternalIdentifierType/cpe23> a owl:Class ;
    rdfs:label "cpe23" ;
    rdfs:subClassOf core:ExternalIdentifierType ;
    skos:definition "[Common Platform Enumeration: Naming Specification Version 2.3](https://csrc.nist.gov/publications/detail/nistir/7695/final)" .

<https://spdx.org/rdf/3.0.1/terms/Core/ExternalIdentifierType/cve> a owl:Class ;
    rdfs:label "cve" ;
    rdfs:subClassOf core:ExternalIdentifierType ;
    skos:definition "Common Vulnerabilities and Exposures identifiers, an identifier for a specific software flaw defined within the official CVE Dictionary and that conforms to the [CVE specification](https://csrc.nist.gov/glossary/term/cve_id)." .

<https://spdx.org/rdf/3.0.1/terms/Core/ExternalIdentifierType/email> a owl:Class ;
    rdfs:label "email" ;
    rdfs:subClassOf core:ExternalIdentifierType ;
    skos:definition "Email address, as defined in [RFC 3696](https://datatracker.ietf.org/doc/rfc3986/) Section 3." .

<https://spdx.org/rdf/3.0.1/terms/Core/ExternalIdentifierType/gitoid> a owl:Class ;
    rdfs:label "gitoid" ;
    rdfs:subClassOf core:ExternalIdentifierType ;
    skos:definition "[Gitoid](https://www.iana.org/assignments/uri-schemes/prov/gitoid), stands for [Git Object ID](https://git-scm.com/book/en/v2/Git-Internals-Git-Objects). A gitoid of type blob is a unique hash of a binary artifact. A gitoid may represent either an [Artifact Identifier](https://github.com/omnibor/spec/blob/eb1ee5c961c16215eb8709b2975d193a2007a35d/spec/SPEC.md#artifact-identifier-types) for the software artifact or an [Input Manifest Identifier](https://github.com/omnibor/spec/blob/eb1ee5c961c16215eb8709b2975d193a2007a35d/spec/SPEC.md#input-manifest-identifier) for the software artifact's associated [Artifact Input Manifest](https://github.com/omnibor/spec/blob/eb1ee5c961c16215eb8709b2975d193a2007a35d/spec/SPEC.md#artifact-input-manifest); this ambiguity exists because the Artifact Input Manifest is itself an artifact, and the gitoid of that artifact is its valid identifier. Gitoids calculated on software artifacts (Snippet, File, or Package Elements) should be recorded in the SPDX 3.0 SoftwareArtifact's contentIdentifier property. Gitoids calculated on the Artifact Input Manifest (Input Manifest Identifier) should be recorded in the SPDX 3.0 Element's externalIdentifier property. See [OmniBOR Specification](https://github.com/omnibor/spec/), a minimalistic specification for describing software [Artifact Dependency Graphs](https://github.com/omnibor/spec/blob/eb1ee5c961c16215eb8709b2975d193a2007a35d/spec/SPEC.md#artifact-dependency-graph-adg)." .

<https://spdx.org/rdf/3.0.1/terms/Core/ExternalIdentifierType/other> a owl:Class ;
    rdfs:label "other" ;
    rdfs:subClassOf core:ExternalIdentifierType ;
    skos:definition "Used when the type does not match any of the other options." .

<https://spdx.org/rdf/3.0.1/terms/Core/ExternalIdentifierType/packageUrl> a owl:Class ;
    rdfs:label "packageUrl" ;
    rdfs:subClassOf core:ExternalIdentifierType ;
    skos:definition "Package URL, as defined in the corresponding [Annex](../../../annexes/pkg-url-specification.md) of this specification." .

<https://spdx.org/rdf/3.0.1/terms/Core/ExternalIdentifierType/securityOther> a owl:Class ;
    rdfs:label "securityOther" ;
    rdfs:subClassOf core:ExternalIdentifierType ;
    skos:definition "Used when there is a security related identifier of unspecified type." .

<https://spdx.org/rdf/3.0.1/terms/Core/ExternalIdentifierType/swhid> a owl:Class ;
    rdfs:label "swhid" ;
    rdfs:subClassOf core:ExternalIdentifierType ;
    skos:definition "SoftWare Hash IDentifier, a persistent intrinsic identifier for digital artifacts, such as files, trees (also known as directories or folders), commits, and other objects typically found in version control systems. The format of the identifiers is defined in the [SWHID specification](https://www.swhid.org/specification/v1.1/4.Syntax) (ISO/IEC DIS 18670). They typically look like `swh:1:cnt:94a9ed024d3859793618152ea559a168bbcbb5e2`." .

<https://spdx.org/rdf/3.0.1/terms/Core/ExternalIdentifierType/swid> a owl:Class ;
    rdfs:label "swid" ;
    rdfs:subClassOf core:ExternalIdentifierType ;
    skos:definition "Concise Software Identification (CoSWID) tag, as defined in [RFC 9393](https://datatracker.ietf.org/doc/rfc9393/) Section 2.3." .

<https://spdx.org/rdf/3.0.1/terms/Core/ExternalIdentifierType/urlScheme> a owl:Class ;
    rdfs:label "urlScheme" ;
    rdfs:subClassOf core:ExternalIdentifierType ;
    skos:definition "[Uniform Resource Identifier (URI) Schemes](https://www.iana.org/assignments/uri-schemes/uri-schemes.xhtml). The scheme used in order to locate a resource." .

<https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/altDownloadLocation> a owl:Class ;
    rdfs:label "altDownloadLocation" ;
    rdfs:subClassOf core:ExternalRefType ;
    skos:definition "A reference to an alternative download location." .

<https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/altWebPage> a owl:Class ;
    rdfs:label "altWebPage" ;
    rdfs:subClassOf core:ExternalRefType ;
    skos:definition "A reference to an alternative web page." .

<https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/binaryArtifact> a owl:Class ;
    rdfs:label "binaryArtifact" ;
    rdfs:subClassOf core:ExternalRefType ;
    skos:definition "A reference to binary artifacts related to a package." .

<https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/bower> a owl:Class ;
    rdfs:label "bower" ;
    rdfs:subClassOf core:ExternalRefType ;
    skos:definition "A reference to a Bower package. The package locator format, looks like `package#version`, is defined in the \"install\" section of [Bower API documentation](https://bower.io/docs/api/#install)." .

<https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/buildMeta> a owl:Class ;
    rdfs:label "buildMeta" ;
    rdfs:subClassOf core:ExternalRefType ;
    skos:definition "A reference build metadata related to a published package." .

<https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/buildSystem> a owl:Class ;
    rdfs:label "buildSystem" ;
    rdfs:subClassOf core:ExternalRefType ;
    skos:definition "A reference build system used to create or publish the package." .

<https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/certificationReport> a owl:Class ;
    rdfs:label "certificationReport" ;
    rdfs:subClassOf core:ExternalRefType ;
    skos:definition "A reference to a certification report for a package from an accredited/independent body." .

<https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/chat> a owl:Class ;
    rdfs:label "chat" ;
    rdfs:subClassOf core:ExternalRefType ;
    skos:definition "A reference to the instant messaging system used by the maintainer for a package." .

<https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/componentAnalysisReport> a owl:Class ;
    rdfs:label "componentAnalysisReport" ;
    rdfs:subClassOf core:ExternalRefType ;
    skos:definition "A reference to a Software Composition Analysis (SCA) report." .

<https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/cwe> a owl:Class ;
    rdfs:label "cwe" ;
    rdfs:subClassOf core:ExternalRefType ;
    skos:definition "[Common Weakness Enumeration](https://csrc.nist.gov/glossary/term/common_weakness_enumeration). A reference to a source of software flaw defined within the official [CWE List](https://cwe.mitre.org/data/) that conforms to the [CWE specification](https://cwe.mitre.org/)." .

<https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/documentation> a owl:Class ;
    rdfs:label "documentation" ;
    rdfs:subClassOf core:ExternalRefType ;
    skos:definition "A reference to the documentation for a package." .

<https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/dynamicAnalysisReport> a owl:Class ;
    rdfs:label "dynamicAnalysisReport" ;
    rdfs:subClassOf core:ExternalRefType ;
    skos:definition "A reference to a dynamic analysis report for a package." .

<https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/eolNotice> a owl:Class ;
    rdfs:label "eolNotice" ;
    rdfs:subClassOf core:ExternalRefType ;
    skos:definition "A reference to the End Of Sale (EOS) and/or End Of Life (EOL) information related to a package." .

<https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/exportControlAssessment> a owl:Class ;
    rdfs:label "exportControlAssessment" ;
    rdfs:subClassOf core:ExternalRefType ;
    skos:definition "A reference to a export control assessment for a package." .

<https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/funding> a owl:Class ;
    rdfs:label "funding" ;
    rdfs:subClassOf core:ExternalRefType ;
    skos:definition "A reference to funding information related to a package." .

<https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/issueTracker> a owl:Class ;
    rdfs:label "issueTracker" ;
    rdfs:subClassOf core:ExternalRefType ;
    skos:definition "A reference to the issue tracker for a package." .

<https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/license> a owl:Class ;
    rdfs:label "license" ;
    rdfs:subClassOf core:ExternalRefType ;
    skos:definition "A reference to additional license information related to an artifact." .

<https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/mailingList> a owl:Class ;
    rdfs:label "mailingList" ;
    rdfs:subClassOf core:ExternalRefType ;
    skos:definition "A reference to the mailing list used by the maintainer for a package." .

<https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/mavenCentral> a owl:Class ;
    rdfs:label "mavenCentral" ;
    rdfs:subClassOf core:ExternalRefType ;
    skos:definition "A reference to a Maven repository artifact. The artifact locator format is defined in the [Maven documentation](https://maven.apache.org/guides/mini/guide-naming-conventions.html) and looks like `groupId:artifactId[:version]`." .

<https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/metrics> a owl:Class ;
    rdfs:label "metrics" ;
    rdfs:subClassOf core:ExternalRefType ;
    skos:definition "A reference to metrics related to package such as OpenSSF scorecards." .

<https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/npm> a owl:Class ;
    rdfs:label "npm" ;
    rdfs:subClassOf core:ExternalRefType ;
    skos:definition "A reference to an npm package. The package locator format is defined in the [npm documentation](https://docs.npmjs.com/cli/v10/configuring-npm/package-json) and looks like `package@version`." .

<https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/nuget> a owl:Class ;
    rdfs:label "nuget" ;
    rdfs:subClassOf core:ExternalRefType ;
    skos:definition "A reference to a NuGet package. The package locator format is defined in the [NuGet documentation](https://docs.nuget.org) and looks like `package/version`." .

<https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/other> a owl:Class ;
    rdfs:label "other" ;
    rdfs:subClassOf core:ExternalRefType ;
    skos:definition "Used when the type does not match any of the other options." .

<https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/privacyAssessment> a owl:Class ;
    rdfs:label "privacyAssessment" ;
    rdfs:subClassOf core:ExternalRefType ;
    skos:definition "A reference to a privacy assessment for a package." .

<https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/productMetadata> a owl:Class ;
    rdfs:label "productMetadata" ;
    rdfs:subClassOf core:ExternalRefType ;
    skos:definition "A reference to additional product metadata such as reference within organization's product catalog." .

<https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/purchaseOrder> a owl:Class ;
    rdfs:label "purchaseOrder" ;
    rdfs:subClassOf core:ExternalRefType ;
    skos:definition "A reference to a purchase order for a package." .

<https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/qualityAssessmentReport> a owl:Class ;
    rdfs:label "qualityAssessmentReport" ;
    rdfs:subClassOf core:ExternalRefType ;
    skos:definition "A reference to a quality assessment for a package." .

<https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/releaseHistory> a owl:Class ;
    rdfs:label "releaseHistory" ;
    rdfs:subClassOf core:ExternalRefType ;
    skos:definition "A reference to a published list of releases for a package." .

<https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/releaseNotes> a owl:Class ;
    rdfs:label "releaseNotes" ;
    rdfs:subClassOf core:ExternalRefType ;
    skos:definition "A reference to the release notes for a package." .

<https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/riskAssessment> a owl:Class ;
    rdfs:label "riskAssessment" ;
    rdfs:subClassOf core:ExternalRefType ;
    skos:definition "A reference to a risk assessment for a package." .

<https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/runtimeAnalysisReport> a owl:Class ;
    rdfs:label "runtimeAnalysisReport" ;
    rdfs:subClassOf core:ExternalRefType ;
    skos:definition "A reference to a runtime analysis report for a package." .

<https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/secureSoftwareAttestation> a owl:Class ;
    rdfs:label "secureSoftwareAttestation" ;
    rdfs:subClassOf core:ExternalRefType ;
    skos:definition "A reference to information assuring that the software is developed using security practices as defined by [NIST SP 800-218 Secure Software Development Framework (SSDF) Version 1.1](https://csrc.nist.gov/pubs/sp/800/218/final) or [CISA Secure Software Development Attestation Form](https://www.cisa.gov/resources-tools/resources/secure-software-development-attestation-form)." .

<https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/securityAdversaryModel> a owl:Class ;
    rdfs:label "securityAdversaryModel" ;
    rdfs:subClassOf core:ExternalRefType ;
    skos:definition "A reference to the security adversary model for a package." .

<https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/securityAdvisory> a owl:Class ;
    rdfs:label "securityAdvisory" ;
    rdfs:subClassOf core:ExternalRefType ;
    skos:definition "A reference to a published security advisory (where advisory as defined per [ISO 29147:2018](https://www.iso.org/standard/72311.html)) that may affect one or more elements, e.g., vendor advisories or specific NVD entries." .

<https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/securityFix> a owl:Class ;
    rdfs:label "securityFix" ;
    rdfs:subClassOf core:ExternalRefType ;
    skos:definition "A reference to the patch or source code that fixes a vulnerability." .

<https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/securityOther> a owl:Class ;
    rdfs:label "securityOther" ;
    rdfs:subClassOf core:ExternalRefType ;
    skos:definition "A reference to related security information of unspecified type." .

<https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/securityPenTestReport> a owl:Class ;
    rdfs:label "securityPenTestReport" ;
    rdfs:subClassOf core:ExternalRefType ;
    skos:definition "A reference to a [penetration test](https://en.wikipedia.org/wiki/Penetration_test) report for a package." .

<https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/securityPolicy> a owl:Class ;
    rdfs:label "securityPolicy" ;
    rdfs:subClassOf core:ExternalRefType ;
    skos:definition "A reference to instructions for reporting newly discovered security vulnerabilities for a package." .

<https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/securityThreatModel> a owl:Class ;
    rdfs:label "securityThreatModel" ;
    rdfs:subClassOf core:ExternalRefType ;
    skos:definition "A reference the [security threat model](https://en.wikipedia.org/wiki/Threat_model) for a package." .

<https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/socialMedia> a owl:Class ;
    rdfs:label "socialMedia" ;
    rdfs:subClassOf core:ExternalRefType ;
    skos:definition "A reference to a social media channel for a package." .

<https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/sourceArtifact> a owl:Class ;
    rdfs:label "sourceArtifact" ;
    rdfs:subClassOf core:ExternalRefType ;
    skos:definition "A reference to an artifact containing the sources for a package." .

<https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/staticAnalysisReport> a owl:Class ;
    rdfs:label "staticAnalysisReport" ;
    rdfs:subClassOf core:ExternalRefType ;
    skos:definition "A reference to a static analysis report for a package." .

<https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/support> a owl:Class ;
    rdfs:label "support" ;
    rdfs:subClassOf core:ExternalRefType ;
    skos:definition "A reference to the software support channel or other support information for a package." .

<https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/vcs> a owl:Class ;
    rdfs:label "vcs" ;
    rdfs:subClassOf core:ExternalRefType ;
    skos:definition "A reference to a version control system related to a software artifact." .

<https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/vulnerabilityDisclosureReport> a owl:Class ;
    rdfs:label "vulnerabilityDisclosureReport" ;
    rdfs:subClassOf core:ExternalRefType ;
    skos:definition "A reference to a Vulnerability Disclosure Report (VDR) which provides the software supplier's analysis and findings describing the impact (or lack of impact) that reported vulnerabilities have on packages or products in the supplier's SBOM as defined in [NIST SP 800-161 Cybersecurity Supply Chain Risk Management Practices for Systems and Organizations](https://csrc.nist.gov/pubs/sp/800/161/r1/final)." .

<https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/vulnerabilityExploitabilityAssessment> a owl:Class ;
    rdfs:label "vulnerabilityExploitabilityAssessment" ;
    rdfs:subClassOf core:ExternalRefType ;
    skos:definition "A reference to a Vulnerability Exploitability eXchange (VEX) statement which provides information on whether a product is impacted by a specific vulnerability in an included package and, if affected, whether there are actions recommended to remediate. See also [NTIA VEX one-page summary](https://ntia.gov/files/ntia/publications/vex_one-page_summary.pdf)." .

<https://spdx.org/rdf/3.0.1/terms/Core/HashAlgorithm/adler32> a owl:Class ;
    rdfs:label "adler32" ;
    rdfs:subClassOf core:HashAlgorithm ;
    skos:definition "Adler-32 checksum is part of the widely used zlib compression library as defined in [RFC 1950](https://datatracker.ietf.org/doc/rfc1950/) Section 2.3." .

<https://spdx.org/rdf/3.0.1/terms/Core/HashAlgorithm/blake2b256> a owl:Class ;
    rdfs:label "blake2b256" ;
    rdfs:subClassOf core:HashAlgorithm ;
    skos:definition "BLAKE2b algorithm with a digest size of 256, as defined in [RFC 7693](https://datatracker.ietf.org/doc/rfc7693/) Section 4." .

<https://spdx.org/rdf/3.0.1/terms/Core/HashAlgorithm/blake2b384> a owl:Class ;
    rdfs:label "blake2b384" ;
    rdfs:subClassOf core:HashAlgorithm ;
    skos:definition "BLAKE2b algorithm with a digest size of 384, as defined in [RFC 7693](https://datatracker.ietf.org/doc/rfc7693/) Section 4." .

<https://spdx.org/rdf/3.0.1/terms/Core/HashAlgorithm/blake2b512> a owl:Class ;
    rdfs:label "blake2b512" ;
    rdfs:subClassOf core:HashAlgorithm ;
    skos:definition "BLAKE2b algorithm with a digest size of 512, as defined in [RFC 7693](https://datatracker.ietf.org/doc/rfc7693/) Section 4." .

<https://spdx.org/rdf/3.0.1/terms/Core/HashAlgorithm/blake3> a owl:Class ;
    rdfs:label "blake3" ;
    rdfs:subClassOf core:HashAlgorithm ;
    skos:definition "[BLAKE3](https://github.com/BLAKE3-team/BLAKE3-specs/blob/master/blake3.pdf)" .

<https://spdx.org/rdf/3.0.1/terms/Core/HashAlgorithm/crystalsDilithium> a owl:Class ;
    rdfs:label "crystalsDilithium" ;
    rdfs:subClassOf core:HashAlgorithm ;
    skos:definition "[Dilithium](https://pq-crystals.org/dilithium/)" .

<https://spdx.org/rdf/3.0.1/terms/Core/HashAlgorithm/crystalsKyber> a owl:Class ;
    rdfs:label "crystalsKyber" ;
    rdfs:subClassOf core:HashAlgorithm ;
    skos:definition "[Kyber](https://pq-crystals.org/kyber/)" .

<https://spdx.org/rdf/3.0.1/terms/Core/HashAlgorithm/falcon> a owl:Class ;
    rdfs:label "falcon" ;
    rdfs:subClassOf core:HashAlgorithm ;
    skos:definition "[FALCON](https://falcon-sign.info/falcon.pdf)" .

<https://spdx.org/rdf/3.0.1/terms/Core/HashAlgorithm/md2> a owl:Class ;
    rdfs:label "md2" ;
    rdfs:subClassOf core:HashAlgorithm ;
    skos:definition "MD2 message-digest algorithm, as defined in [RFC 1319](https://datatracker.ietf.org/doc/rfc1319/)." .

<https://spdx.org/rdf/3.0.1/terms/Core/HashAlgorithm/md4> a owl:Class ;
    rdfs:label "md4" ;
    rdfs:subClassOf core:HashAlgorithm ;
    skos:definition "MD4 message-digest algorithm, as defined in [RFC 1186](https://datatracker.ietf.org/doc/rfc1186/)." .

<https://spdx.org/rdf/3.0.1/terms/Core/HashAlgorithm/md5> a owl:Class ;
    rdfs:label "md5" ;
    rdfs:subClassOf core:HashAlgorithm ;
    skos:definition "MD5 message-digest algorithm, as defined in [RFC 1321](https://datatracker.ietf.org/doc/rfc1321/)." .

<https://spdx.org/rdf/3.0.1/terms/Core/HashAlgorithm/md6> a owl:Class ;
    rdfs:label "md6" ;
    rdfs:subClassOf core:HashAlgorithm ;
