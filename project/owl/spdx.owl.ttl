<https://spdx.org/rdf/3.0.1/terms/Core/RelationshipType/hasProvidedDependency> a owl:Class ;
    rdfs:label "hasProvidedDependency" ;
    rdfs:subClassOf core:RelationshipType ;
    skos:definition "The `from` Element has a dependency on each `to` Element, dependency is not in the distributed artifact, but assumed to be provided, during a LifecycleScopeType period." .

<https://spdx.org/rdf/3.0.1/terms/Core/RelationshipType/hasRequirement> a owl:Class ;
    rdfs:label "hasRequirement" ;
