spdx_core:RelationshipType\/affects a owl:Class ;
	rdfs:label "affects" ;
	rdfs:subClassOf spdx_core:RelationshipType ;
	skos:definition "The `from` Vulnerability affects each `to` Element. The use of the `affects` type is constrained to `VexAffectedVulnAssessmentRelationship` classed relationships." .
spdx_core:RelationshipType\/amendedBy a owl:Class ;
	rdfs:label "amendedBy" ;
	rdfs:subClassOf spdx_core:RelationshipType ;
	skos:definition "The `from` Element is amended by each `to` Element." .
spdx_core:RelationshipType\/ancestorOf a owl:Class ;
	rdfs:label "ancestorOf" ;
	rdfs:subClassOf spdx_core:RelationshipType ;
	skos:definition "The `from` Element is an ancestor of each `to` Element." .
spdx_core:RelationshipType\/availableFrom a owl:Class ;
	rdfs:label "availableFrom" ;
	rdfs:subClassOf spdx_core:RelationshipType ;
	skos:definition "The `from` Element is available from the additional supplier described by each `to` Element." .
spdx_core:RelationshipType\/configures a owl:Class ;
	rdfs:label "configures" ;
	rdfs:subClassOf spdx_core:RelationshipType ;
	skos:definition "The `from` Element is a configuration applied to each `to` Element, during a LifecycleScopeType period." .
spdx_core:RelationshipType\/contains a owl:Class ;
	rdfs:label "contains" ;
	rdfs:subClassOf spdx_core:RelationshipType ;
	skos:definition "The `from` Element contains each `to` Element." .
spdx_core:RelationshipType\/coordinatedBy a owl:Class ;
	rdfs:label "coordinatedBy" ;
	rdfs:subClassOf spdx_core:RelationshipType ;
	skos:definition "The `from` Vulnerability is coordinatedBy the `to` Agent(s) (vendor, researcher, or consumer agent)." .
spdx_core:RelationshipType\/copiedTo a owl:Class ;
	rdfs:label "copiedTo" ;
	rdfs:subClassOf spdx_core:RelationshipType ;
	skos:definition "The `from` Element has been copied to each `to` Element." .
spdx_core:RelationshipType\/delegatedTo a owl:Class ;
	rdfs:label "delegatedTo" ;
	rdfs:subClassOf spdx_core:RelationshipType ;
	skos:definition "The `from` Agent is delegating an action to the Agent of the `to` Relationship (which must be of type invokedBy), during a LifecycleScopeType (e.g. the `to` invokedBy Relationship is being done on behalf of `from`)." .
spdx_core:RelationshipType\/dependsOn a owl:Class ;
	rdfs:label "dependsOn" ;
	rdfs:subClassOf spdx_core:RelationshipType ;
	skos:definition "The `from` Element depends on each `to` Element, during a LifecycleScopeType period." .
spdx_core:RelationshipType\/descendantOf a owl:Class ;
	rdfs:label "descendantOf" ;
	rdfs:subClassOf spdx_core:RelationshipType ;
	skos:definition "The `from` Element is a descendant of each `to` Element." .
spdx_core:RelationshipType\/describes a owl:Class ;
	rdfs:label "describes" ;
	rdfs:subClassOf spdx_core:RelationshipType ;
	skos:definition "The `from` Element describes each `to` Element. To denote the root(s) of a tree of elements in a collection, the rootElement property should be used." .
spdx_core:RelationshipType\/doesNotAffect a owl:Class ;
	rdfs:label "doesNotAffect" ;
	rdfs:subClassOf spdx_core:RelationshipType ;
	skos:definition "The `from` Vulnerability has no impact on each `to` Element. The use of the `doesNotAffect` is constrained to `VexNotAffectedVulnAssessmentRelationship` classed relationships." .
spdx_core:RelationshipType\/expandsTo a owl:Class ;
	rdfs:label "expandsTo" ;
	rdfs:subClassOf spdx_core:RelationshipType ;
	skos:definition "The `from` archive expands out as an artifact described by each `to` Element." .
spdx_core:RelationshipType\/exploitCreatedBy a owl:Class ;
	rdfs:label "exploitCreatedBy" ;
	rdfs:subClassOf spdx_core:RelationshipType ;
	skos:definition "The `from` Vulnerability has had an exploit created against it by each `to` Agent." .
spdx_core:RelationshipType\/fixedBy a owl:Class ;
	rdfs:label "fixedBy" ;
	rdfs:subClassOf spdx_core:RelationshipType ;
	skos:definition "Designates a `from` Vulnerability has been fixed by the `to` Agent(s)." .
spdx_core:RelationshipType\/fixedIn a owl:Class ;
	rdfs:label "fixedIn" ;
	rdfs:subClassOf spdx_core:RelationshipType ;
	skos:definition "A `from` Vulnerability has been fixed in each `to` Element. The use of the `fixedIn` type is constrained to `VexFixedVulnAssessmentRelationship` classed relationships." .
spdx_core:RelationshipType\/foundBy a owl:Class ;
	rdfs:label "foundBy" ;
	rdfs:subClassOf spdx_core:RelationshipType ;
	skos:definition "Designates a `from` Vulnerability was originally discovered by the `to` Agent(s)." .
spdx_core:RelationshipType\/generates a owl:Class ;
	rdfs:label "generates" ;
	rdfs:subClassOf spdx_core:RelationshipType ;
	skos:definition "The `from` Element generates each `to` Element." .
spdx_core:RelationshipType\/hasAddedFile a owl:Class ;
	rdfs:label "hasAddedFile" ;
	rdfs:subClassOf spdx_core:RelationshipType ;
	skos:definition "Every `to` Element is a file added to the `from` Element (`from` hasAddedFile `to`)." .
spdx_core:RelationshipType\/hasAssessmentFor a owl:Class ;
	rdfs:label "hasAssessmentFor" ;
	rdfs:subClassOf spdx_core:RelationshipType ;
	skos:definition "Relates a `from` Vulnerability and each `to` Element with a security assessment. To be used with `VulnAssessmentRelationship` types." .
spdx_core:RelationshipType\/hasAssociatedVulnerability a owl:Class ;
	rdfs:label "hasAssociatedVulnerability" ;
	rdfs:subClassOf spdx_core:RelationshipType ;
	skos:definition "Used to associate a `from` Artifact with each `to` Vulnerability." .
spdx_core:RelationshipType\/hasConcludedLicense a owl:Class ;
	rdfs:label "hasConcludedLicense" ;
	rdfs:subClassOf spdx_core:RelationshipType ;
	skos:definition "The `from` SoftwareArtifact is concluded by the SPDX data creator to be governed by each `to` license." .
spdx_core:RelationshipType\/hasDataFile a owl:Class ;
	rdfs:label "hasDataFile" ;
	rdfs:subClassOf spdx_core:RelationshipType ;
	skos:definition "The `from` Element treats each `to` Element as a data file. A data file is an artifact that stores data required or optional for the `from` Element's functionality. A data file can be a database file, an index file, a log file, an AI model file, a calibration data file, a temporary file, a backup file, and more. For AI training dataset, test dataset, test artifact, configuration data, build input data, and build output data, please consider using the more specific relationship types: `trainedOn`, `testedOn`, `hasTest`, `configures`, `hasInput`, and `hasOutput`, respectively. This relationship does not imply dependency." .
spdx_core:RelationshipType\/hasDeclaredLicense a owl:Class ;
	rdfs:label "hasDeclaredLicense" ;
	rdfs:subClassOf spdx_core:RelationshipType ;
	skos:definition "The `from` SoftwareArtifact was discovered to actually contain each `to` license, for example as detected by use of automated tooling." .
spdx_core:RelationshipType\/hasDeletedFile a owl:Class ;
	rdfs:label "hasDeletedFile" ;
	rdfs:subClassOf spdx_core:RelationshipType ;
	skos:definition "Every `to` Element is a file deleted from the `from` Element (`from` hasDeletedFile `to`)." .
spdx_core:RelationshipType\/hasDependencyManifest a owl:Class ;
	rdfs:label "hasDependencyManifest" ;
	rdfs:subClassOf spdx_core:RelationshipType ;
	skos:definition "The `from` Element has manifest files that contain dependency information in each `to` Element." .
spdx_core:RelationshipType\/hasDistributionArtifact a owl:Class ;
	rdfs:label "hasDistributionArtifact" ;
	rdfs:subClassOf spdx_core:RelationshipType ;
	skos:definition "The `from` Element is distributed as an artifact in each `to` Element (e.g. an RPM or archive file)." .
spdx_core:RelationshipType\/hasDocumentation a owl:Class ;
	rdfs:label "hasDocumentation" ;
	rdfs:subClassOf spdx_core:RelationshipType ;
	skos:definition "The `from` Element is documented by each `to` Element." .
spdx_core:RelationshipType\/hasDynamicLink a owl:Class ;
	rdfs:label "hasDynamicLink" ;
	rdfs:subClassOf spdx_core:RelationshipType ;
	skos:definition "The `from` Element dynamically links in each `to` Element, during a LifecycleScopeType period." .
spdx_core:RelationshipType\/hasEvidence a owl:Class ;
	rdfs:label "hasEvidence" ;
	rdfs:subClassOf spdx_core:RelationshipType ;
	skos:definition "Every `to` Element is considered as evidence for the `from` Element (`from` hasEvidence `to`)." .
spdx_core:RelationshipType\/hasExample a owl:Class ;
	rdfs:label "hasExample" ;
	rdfs:subClassOf spdx_core:RelationshipType ;
	skos:definition "Every `to` Element is an example for the `from` Element (`from` hasExample `to`)." .
spdx_core:RelationshipType\/hasHost a owl:Class ;
	rdfs:label "hasHost" ;
	rdfs:subClassOf spdx_core:RelationshipType ;
	skos:definition "The `from` Build was run on the `to` Element during a LifecycleScopeType period (e.g. the host that the build runs on)." .
spdx_core:RelationshipType\/hasInput a owl:Class ;
	rdfs:label "hasInput" ;
	rdfs:subClassOf spdx_core:RelationshipType ;
	skos:definition "The `from` Build has each `to` Element as an input, during a LifecycleScopeType period." .
spdx_core:RelationshipType\/hasMetadata a owl:Class ;
	rdfs:label "hasMetadata" ;
	rdfs:subClassOf spdx_core:RelationshipType ;
	skos:definition "Every `to` Element is metadata about the `from` Element (`from` hasMetadata `to`)." .
spdx_core:RelationshipType\/hasOptionalComponent a owl:Class ;
	rdfs:label "hasOptionalComponent" ;
	rdfs:subClassOf spdx_core:RelationshipType ;
	skos:definition "Every `to` Element is an optional component of the `from` Element (`from` hasOptionalComponent `to`)." .
spdx_core:RelationshipType\/hasOptionalDependency a owl:Class ;
	rdfs:label "hasOptionalDependency" ;
	rdfs:subClassOf spdx_core:RelationshipType ;
	skos:definition "The `from` Element optionally depends on each `to` Element, during a LifecycleScopeType period." .
spdx_core:RelationshipType\/hasOutput a owl:Class ;
	rdfs:label "hasOutput" ;
	rdfs:subClassOf spdx_core:RelationshipType ;
	skos:definition "The `from` Build element generates each `to` Element as an output, during a LifecycleScopeType period." .
spdx_core:RelationshipType\/hasPrerequisite a owl:Class ;
	rdfs:label "hasPrerequisite" ;
	rdfs:subClassOf spdx_core:RelationshipType ;
	skos:definition "The `from` Element has a prerequisite on each `to` Element, during a LifecycleScopeType period." .
spdx_core:RelationshipType\/hasProvidedDependency a owl:Class ;
	rdfs:label "hasProvidedDependency" ;
	rdfs:subClassOf spdx_core:RelationshipType ;
	skos:definition "The `from` Element has a dependency on each `to` Element, dependency is not in the distributed artifact, but assumed to be provided, during a LifecycleScopeType period." .
spdx_core:RelationshipType\/hasRequirement a owl:Class ;
	rdfs:label "hasRequirement" ;
	rdfs:subClassOf spdx_core:RelationshipType ;
	skos:definition "The `from` Element has a requirement on each `to` Element, during a LifecycleScopeType period." .
spdx_core:RelationshipType\/hasSpecification a owl:Class ;
	rdfs:label "hasSpecification" ;
	rdfs:subClassOf spdx_core:RelationshipType ;
	skos:definition "Every `to` Element is a specification for the `from` Element (`from` hasSpecification `to`), during a LifecycleScopeType period." .
spdx_core:RelationshipType\/hasStaticLink a owl:Class ;
	rdfs:label "hasStaticLink" ;
	rdfs:subClassOf spdx_core:RelationshipType ;
	skos:definition "The `from` Element statically links in each `to` Element, during a LifecycleScopeType period." .
spdx_core:RelationshipType\/hasTest a owl:Class ;
	rdfs:label "hasTest" ;
	rdfs:subClassOf spdx_core:RelationshipType ;
	skos:definition "Every `to` Element is a test artifact for the `from` Element (`from` hasTest `to`), during a LifecycleScopeType period." .
spdx_core:RelationshipType\/hasTestCase a owl:Class ;
	rdfs:label "hasTestCase" ;
	rdfs:subClassOf spdx_core:RelationshipType ;
	skos:definition "Every `to` Element is a test case for the `from` Element (`from` hasTestCase `to`)." .
spdx_core:RelationshipType\/hasVariant a owl:Class ;
	rdfs:label "hasVariant" ;
	rdfs:subClassOf spdx_core:RelationshipType ;
	skos:definition "Every `to` Element is a variant the `from` Element (`from` hasVariant `to`)." .
spdx_core:RelationshipType\/invokedBy a owl:Class ;
	rdfs:label "invokedBy" ;
	rdfs:subClassOf spdx_core:RelationshipType ;
	skos:definition "The `from` Element was invoked by the `to` Agent, during a LifecycleScopeType period (for example, a Build element that describes a build step)." .
spdx_core:RelationshipType\/modifiedBy a owl:Class ;
	rdfs:label "modifiedBy" ;
	rdfs:subClassOf spdx_core:RelationshipType ;
	skos:definition "The `from` Element is modified by each `to` Element." .
spdx_core:RelationshipType\/other a owl:Class ;
	rdfs:label "other" ;
	rdfs:subClassOf spdx_core:RelationshipType ;
	skos:definition "Every `to` Element is related to the `from` Element where the relationship type is not described by any of the SPDX relationship types (this relationship is directionless)." .
spdx_core:RelationshipType\/packagedBy a owl:Class ;
	rdfs:label "packagedBy" ;
	rdfs:subClassOf spdx_core:RelationshipType ;
	skos:definition "Every `to` Element is a packaged instance of the `from` Element (`from` packagedBy `to`)." .
spdx_core:RelationshipType\/patchedBy a owl:Class ;
	rdfs:label "patchedBy" ;
	rdfs:subClassOf spdx_core:RelationshipType ;
	skos:definition "Every `to` Element is a patch for the `from` Element (`from` patchedBy `to`)." .
spdx_core:RelationshipType\/publishedBy a owl:Class ;
	rdfs:label "publishedBy" ;
	rdfs:subClassOf spdx_core:RelationshipType ;
	skos:definition "Designates a `from` Vulnerability was made available for public use or reference by each `to` Agent." .
spdx_core:RelationshipType\/reportedBy a owl:Class ;
	rdfs:label "reportedBy" ;
	rdfs:subClassOf spdx_core:RelationshipType ;
	skos:definition "Designates a `from` Vulnerability was first reported to a project, vendor, or tracking database for formal identification by each `to` Agent." .
spdx_core:RelationshipType\/republishedBy a owl:Class ;
	rdfs:label "republishedBy" ;
	rdfs:subClassOf spdx_core:RelationshipType ;
	skos:definition "Designates a `from` Vulnerability's details were tracked, aggregated, and/or enriched to improve context (i.e. NVD) by each `to` Agent." .
spdx_core:RelationshipType\/serializedInArtifact a owl:Class ;
	rdfs:label "serializedInArtifact" ;
	rdfs:subClassOf spdx_core:RelationshipType ;
	skos:definition "The `from` SpdxDocument can be found in a serialized form in each `to` Artifact." .
spdx_core:RelationshipType\/testedOn a owl:Class ;
	rdfs:label "testedOn" ;
	rdfs:subClassOf spdx_core:RelationshipType ;
	skos:definition "The `from` Element has been tested on the `to` Element(s)." .
spdx_core:RelationshipType\/trainedOn a owl:Class ;
	rdfs:label "trainedOn" ;
	rdfs:subClassOf spdx_core:RelationshipType ;
	skos:definition "The `from` Element has been trained on the `to` Element(s)." .
spdx_core:RelationshipType\/underInvestigationFor a owl:Class ;
	rdfs:label "underInvestigationFor" ;
	rdfs:subClassOf spdx_core:RelationshipType ;
	skos:definition "The `from` Vulnerability impact is being investigated for each `to` Element. The use of the `underInvestigationFor` type is constrained to `VexUnderInvestigationVulnAssessmentRelationship` classed relationships." .
spdx_core:RelationshipType\/usesTool a owl:Class ;
	rdfs:label "usesTool" ;
	rdfs:subClassOf spdx_core:RelationshipType ;
	skos:definition "The `from` Element uses each `to` Element as a tool, during a LifecycleScopeType period." .
spdx_core:RelationshipType a owl:Class ;
	rdfs:label "RelationshipType" ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/Core/Vocabularies/RelationshipType/> ;
	owl:unionOf _:c14n143 ;
	skos:definition "Information about the relationship between two Elements." ;
	skos:inScheme spdx_linkml:spdx_core ;
	linkml:permissible_values spdx_core:RelationshipType\/affects , spdx_core:RelationshipType\/amendedBy , spdx_core:RelationshipType\/ancestorOf , spdx_core:RelationshipType\/availableFrom , spdx_core:RelationshipType\/configures , spdx_core:RelationshipType\/contains , spdx_core:RelationshipType\/coordinatedBy , spdx_core:RelationshipType\/copiedTo , spdx_core:RelationshipType\/delegatedTo , spdx_core:RelationshipType\/dependsOn , spdx_core:RelationshipType\/descendantOf , spdx_core:RelationshipType\/describes , spdx_core:RelationshipType\/doesNotAffect , spdx_core:RelationshipType\/expandsTo , spdx_core:RelationshipType\/exploitCreatedBy , spdx_core:RelationshipType\/fixedBy , spdx_core:RelationshipType\/fixedIn , spdx_core:RelationshipType\/foundBy , spdx_core:RelationshipType\/generates , spdx_core:RelationshipType\/hasAddedFile , spdx_core:RelationshipType\/hasAssessmentFor , spdx_core:RelationshipType\/hasAssociatedVulnerability , spdx_core:RelationshipType\/hasConcludedLicense , spdx_core:RelationshipType\/hasDataFile , spdx_core:RelationshipType\/hasDeclaredLicense , spdx_core:RelationshipType\/hasDeletedFile , spdx_core:RelationshipType\/hasDependencyManifest , spdx_core:RelationshipType\/hasDistributionArtifact , spdx_core:RelationshipType\/hasDocumentation , spdx_core:RelationshipType\/hasDynamicLink , spdx_core:RelationshipType\/hasEvidence , spdx_core:RelationshipType\/hasExample , spdx_core:RelationshipType\/hasHost , spdx_core:RelationshipType\/hasInput , spdx_core:RelationshipType\/hasMetadata , spdx_core:RelationshipType\/hasOptionalComponent , spdx_core:RelationshipType\/hasOptionalDependency , spdx_core:RelationshipType\/hasOutput , spdx_core:RelationshipType\/hasPrerequisite , spdx_core:RelationshipType\/hasProvidedDependency , spdx_core:RelationshipType\/hasRequirement , spdx_core:RelationshipType\/hasSpecification , spdx_core:RelationshipType\/hasStaticLink , spdx_core:RelationshipType\/hasTest , spdx_core:RelationshipType\/hasTestCase , spdx_core:RelationshipType\/hasVariant , spdx_core:RelationshipType\/invokedBy , spdx_core:RelationshipType\/modifiedBy , spdx_core:RelationshipType\/other , spdx_core:RelationshipType\/packagedBy , spdx_core:RelationshipType\/patchedBy , spdx_core:RelationshipType\/publishedBy , spdx_core:RelationshipType\/reportedBy , spdx_core:RelationshipType\/republishedBy , spdx_core:RelationshipType\/serializedInArtifact , spdx_core:RelationshipType\/testedOn , spdx_core:RelationshipType\/trainedOn , spdx_core:RelationshipType\/underInvestigationFor , spdx_core:RelationshipType\/usesTool .
spdx_core:SupportType\/deployed a owl:Class ;
	rdfs:label "deployed" ;
	rdfs:subClassOf spdx_core:SupportType ;
	skos:definition "in addition to being supported by the supplier, the software is known to have been deployed and is in use. For a software as a service provider, this implies the software is now available as a service." .
spdx_core:SupportType\/development a owl:Class ;
	rdfs:label "development" ;
	rdfs:subClassOf spdx_core:SupportType ;
	skos:definition "the artifact is in active development and is not considered ready for formal support from the supplier." .
spdx_core:SupportType\/endOfSupport a owl:Class ;
	rdfs:label "endOfSupport" ;
	rdfs:subClassOf spdx_core:SupportType ;
	skos:definition "there is a defined end of support for the artifact from the supplier. This may also be referred to as end of life. There is a validUntilDate that can be used to signal when support ends for the artifact." .
spdx_core:SupportType\/limitedSupport a owl:Class ;
	rdfs:label "limitedSupport" ;
	rdfs:subClassOf spdx_core:SupportType ;
	skos:definition "the artifact has been released, and there is limited support available from the supplier. There is a validUntilDate that can provide additional information about the duration of support." .
spdx_core:SupportType\/noAssertion a owl:Class ;
	rdfs:label "noAssertion" ;
	rdfs:subClassOf spdx_core:SupportType ;
	skos:definition "no assertion about the type of support is made. This is considered the default if no other support type is used." .
spdx_core:SupportType\/noSupport a owl:Class ;
	rdfs:label "noSupport" ;
	rdfs:subClassOf spdx_core:SupportType ;
	skos:definition "there is no support for the artifact from the supplier, consumer assumes any support obligations." .
spdx_core:SupportType\/support a owl:Class ;
	rdfs:label "support" ;
	rdfs:subClassOf spdx_core:SupportType ;
	skos:definition "the artifact has been released, and is supported from the supplier. There is a validUntilDate that can provide additional information about the duration of support." .
spdx_core:SupportType a owl:Class ;
	rdfs:label "SupportType" ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/Core/Vocabularies/SupportType/> ;
	owl:unionOf _:c14n9 ;
	skos:definition "Indicates the type of support that is associated with an artifact." ;
	skos:inScheme spdx_linkml:spdx_core ;
	linkml:permissible_values spdx_core:SupportType\/deployed , spdx_core:SupportType\/development , spdx_core:SupportType\/endOfSupport , spdx_core:SupportType\/limitedSupport , spdx_core:SupportType\/noAssertion , spdx_core:SupportType\/noSupport , spdx_core:SupportType\/support .
spdx_dataset:ConfidentialityLevelType\/amber a owl:Class ;
	rdfs:label "amber" ;
	rdfs:subClassOf spdx_dataset:ConfidentialityLevelType ;
	skos:definition "Data points in the dataset can be shared only with specific organizations and their clients on a need to know basis." .
spdx_dataset:ConfidentialityLevelType\/clear a owl:Class ;
	rdfs:label "clear" ;
	rdfs:subClassOf spdx_dataset:ConfidentialityLevelType ;
	skos:definition "Dataset may be distributed freely, without restriction." .
spdx_dataset:ConfidentialityLevelType\/green a owl:Class ;
	rdfs:label "green" ;
	rdfs:subClassOf spdx_dataset:ConfidentialityLevelType ;
	skos:definition "Dataset can be shared within a community of peers and partners." .
spdx_dataset:ConfidentialityLevelType\/red a owl:Class ;
	rdfs:label "red" ;
	rdfs:subClassOf spdx_dataset:ConfidentialityLevelType ;
	skos:definition "Data points in the dataset are highly confidential and can only be shared with named recipients." .
spdx_dataset:ConfidentialityLevelType a owl:Class ;
	rdfs:label "ConfidentialityLevelType" ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/Dataset/Vocabularies/ConfidentialityLevelType/> ;
	owl:unionOf _:c14n343 ;
	skos:definition "Categories of confidentiality level." ;
	skos:inScheme spdx_linkml:spdx_dataset ;
	linkml:permissible_values spdx_dataset:ConfidentialityLevelType\/amber , spdx_dataset:ConfidentialityLevelType\/clear , spdx_dataset:ConfidentialityLevelType\/green , spdx_dataset:ConfidentialityLevelType\/red .
spdx_dataset:DatasetAvailabilityType\/clickthrough a owl:Class ;
	rdfs:label "clickthrough" ;
	rdfs:subClassOf spdx_dataset:DatasetAvailabilityType ;
	skos:definition "the dataset is not publicly available and can only be accessed after affirmatively accepting terms on a clickthrough webpage." .
spdx_dataset:DatasetAvailabilityType\/directDownload a owl:Class ;
	rdfs:label "directDownload" ;
	rdfs:subClassOf spdx_dataset:DatasetAvailabilityType ;
	skos:definition "the dataset is publicly available and can be downloaded directly." .
spdx_dataset:DatasetAvailabilityType\/query a owl:Class ;
	rdfs:label "query" ;
	rdfs:subClassOf spdx_dataset:DatasetAvailabilityType ;
	skos:definition "the dataset is publicly available, but not all at once, and can only be accessed through queries which return parts of the dataset." .
spdx_dataset:DatasetAvailabilityType\/registration a owl:Class ;
	rdfs:label "registration" ;
	rdfs:subClassOf spdx_dataset:DatasetAvailabilityType ;
	skos:definition "the dataset is not publicly available and an email registration is required before accessing the dataset, although without an affirmative acceptance of terms." .
spdx_dataset:DatasetAvailabilityType\/scrapingScript a owl:Class ;
	rdfs:label "scrapingScript" ;
	rdfs:subClassOf spdx_dataset:DatasetAvailabilityType ;
	skos:definition "the dataset provider is not making available the underlying data and the dataset must be reassembled, typically using the provided script for scraping the data." .
spdx_dataset:DatasetAvailabilityType a owl:Class ;
	rdfs:label "DatasetAvailabilityType" ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/Dataset/Vocabularies/DatasetAvailabilityType/> ;
	owl:unionOf _:c14n153 ;
	skos:definition "Availability of dataset." ;
	skos:inScheme spdx_linkml:spdx_dataset ;
	linkml:permissible_values spdx_dataset:DatasetAvailabilityType\/clickthrough , spdx_dataset:DatasetAvailabilityType\/directDownload , spdx_dataset:DatasetAvailabilityType\/query , spdx_dataset:DatasetAvailabilityType\/registration , spdx_dataset:DatasetAvailabilityType\/scrapingScript .
spdx_dataset:DatasetType\/audio a owl:Class ;
	rdfs:label "audio" ;
	rdfs:subClassOf spdx_dataset:DatasetType ;
	skos:definition "data is audio based, such as a collection of music from the 80s." .
spdx_dataset:DatasetType\/categorical a owl:Class ;
	rdfs:label "categorical" ;
	rdfs:subClassOf spdx_dataset:DatasetType ;
	skos:definition "data that is classified into a discrete number of categories, such as the eye color of a population of people." .
spdx_dataset:DatasetType\/graph a owl:Class ;
	rdfs:label "graph" ;
	rdfs:subClassOf spdx_dataset:DatasetType ;
	skos:definition "data is in the form of a graph where entries are somehow related to each other through edges, such a social network of friends." .
spdx_dataset:DatasetType\/image a owl:Class ;
	rdfs:label "image" ;
	rdfs:subClassOf spdx_dataset:DatasetType ;
	skos:definition "data is a collection of images such as pictures of animals." .
spdx_dataset:DatasetType\/noAssertion a owl:Class ;
	rdfs:label "noAssertion" ;
	rdfs:subClassOf spdx_dataset:DatasetType ;
	skos:definition "data type is not known." .
spdx_dataset:DatasetType\/numeric a owl:Class ;
	rdfs:label "numeric" ;
	rdfs:subClassOf spdx_dataset:DatasetType ;
	skos:definition "data consists only of numeric entries." .
spdx_dataset:DatasetType\/other a owl:Class ;
	rdfs:label "other" ;
	rdfs:subClassOf spdx_dataset:DatasetType ;
	skos:definition "data is of a type not included in this list." .
spdx_dataset:DatasetType\/sensor a owl:Class ;
	rdfs:label "sensor" ;
	rdfs:subClassOf spdx_dataset:DatasetType ;
	skos:definition "data is recorded from a physical sensor, such as a thermometer reading or biometric device." .
spdx_dataset:DatasetType\/structured a owl:Class ;
	rdfs:label "structured" ;
	rdfs:subClassOf spdx_dataset:DatasetType ;
	skos:definition "data is stored in tabular format or retrieved from a relational database." .
spdx_dataset:DatasetType\/syntactic a owl:Class ;
	rdfs:label "syntactic" ;
	rdfs:subClassOf spdx_dataset:DatasetType ;
	skos:definition "data describes the syntax or semantics of a language or text, such as a parse tree used for natural language processing." .
spdx_dataset:DatasetType\/text a owl:Class ;
	rdfs:label "text" ;
	rdfs:subClassOf spdx_dataset:DatasetType ;
	skos:definition "data consists of unstructured text, such as a book, Wikipedia article (without images), or transcript." .
spdx_dataset:DatasetType\/timeseries a owl:Class ;
	rdfs:label "timeseries" ;
	rdfs:subClassOf spdx_dataset:DatasetType ;
	skos:definition "data is recorded in an ordered sequence of timestamped entries, such as the price of a stock over the course of a day." .
spdx_dataset:DatasetType\/timestamp a owl:Class ;
	rdfs:label "timestamp" ;
	rdfs:subClassOf spdx_dataset:DatasetType ;
	skos:definition "data is recorded with a timestamp for each entry, but not necessarily ordered or at specific intervals, such as when a taxi ride starts and ends." .
spdx_dataset:DatasetType\/video a owl:Class ;
	rdfs:label "video" ;
	rdfs:subClassOf spdx_dataset:DatasetType ;
	skos:definition "data is video based, such as a collection of movie clips featuring Tom Hanks." .
spdx_dataset:DatasetType a owl:Class ;
	rdfs:label "DatasetType" ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/Dataset/Vocabularies/DatasetType/> ;
	owl:unionOf _:c14n164 ;
	skos:definition "Enumeration of dataset types." ;
	skos:inScheme spdx_linkml:spdx_dataset ;
	linkml:permissible_values spdx_dataset:DatasetType\/audio , spdx_dataset:DatasetType\/categorical , spdx_dataset:DatasetType\/graph , spdx_dataset:DatasetType\/image , spdx_dataset:DatasetType\/noAssertion , spdx_dataset:DatasetType\/numeric , spdx_dataset:DatasetType\/other , spdx_dataset:DatasetType\/sensor , spdx_dataset:DatasetType\/structured , spdx_dataset:DatasetType\/syntactic , spdx_dataset:DatasetType\/text , spdx_dataset:DatasetType\/timeseries , spdx_dataset:DatasetType\/timestamp , spdx_dataset:DatasetType\/video .
spdx_security:CvssSeverityType\/critical a owl:Class ;
	rdfs:label "critical" ;
	rdfs:subClassOf spdx_security:CvssSeverityType ;
	skos:definition "When a CVSS score is between 9.0 - 10.0" .
spdx_security:CvssSeverityType\/high a owl:Class ;
	rdfs:label "high" ;
	rdfs:subClassOf spdx_security:CvssSeverityType ;
	skos:definition "When a CVSS score is between 7.0 - 8.9" .
spdx_security:CvssSeverityType\/low a owl:Class ;
	rdfs:label "low" ;
	rdfs:subClassOf spdx_security:CvssSeverityType ;
	skos:definition "When a CVSS score is between 0.1 - 3.9" .
spdx_security:CvssSeverityType\/medium a owl:Class ;
	rdfs:label "medium" ;
	rdfs:subClassOf spdx_security:CvssSeverityType ;
	skos:definition "When a CVSS score is between 4.0 - 6.9" .
spdx_security:CvssSeverityType\/none a owl:Class ;
	rdfs:label "none" ;
	rdfs:subClassOf spdx_security:CvssSeverityType ;
	skos:definition "When a CVSS score is 0.0" .
spdx_security:CvssSeverityType a owl:Class ;
	rdfs:label "CvssSeverityType" ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/Security/Vocabularies/CvssSeverityType/> ;
	owl:unionOf _:c14n510 ;
	skos:definition "Specifies the CVSS base, temporal, threat, or environmental severity type." ;
	skos:inScheme spdx_linkml:spdx_security ;
	linkml:permissible_values spdx_security:CvssSeverityType\/critical , spdx_security:CvssSeverityType\/high , spdx_security:CvssSeverityType\/low , spdx_security:CvssSeverityType\/medium , spdx_security:CvssSeverityType\/none .
spdx_security:ExploitCatalogType\/kev a owl:Class ;
	rdfs:label "kev" ;
	rdfs:subClassOf spdx_security:ExploitCatalogType ;
	skos:definition "CISA's Known Exploited Vulnerability (KEV) Catalog" .
spdx_security:ExploitCatalogType\/other a owl:Class ;
	rdfs:label "other" ;
	rdfs:subClassOf spdx_security:ExploitCatalogType ;
	skos:definition "Other exploit catalogs" .
spdx_security:ExploitCatalogType a owl:Class ;
	rdfs:label "ExploitCatalogType" ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/Security/Vocabularies/ExploitCatalogType/> ;
	owl:unionOf _:c14n364 ;
	skos:definition "Specifies the exploit catalog type." ;
	skos:inScheme spdx_linkml:spdx_security ;
	linkml:permissible_values spdx_security:ExploitCatalogType\/kev , spdx_security:ExploitCatalogType\/other .
spdx_security:SsvcDecisionType\/act a owl:Class ;
	rdfs:label "act" ;
	rdfs:subClassOf spdx_security:SsvcDecisionType ;
	skos:definition "The vulnerability requires attention from the organization's internal, supervisory-level and leadership-level individuals. Necessary actions include requesting assistance or information about the vulnerability, as well as publishing a notification either internally and/or externally. Typically, internal groups would meet to determine the overall response and then execute agreed upon actions. CISA recommends remediating Act vulnerabilities as soon as possible." .
spdx_security:SsvcDecisionType\/attend a owl:Class ;
	rdfs:label "attend" ;
	rdfs:subClassOf spdx_security:SsvcDecisionType ;
	skos:definition "The vulnerability requires attention from the organization's internal, supervisory-level individuals. Necessary actions include requesting assistance or information about the vulnerability, and may involve publishing a notification either internally and/or externally. CISA recommends remediating Attend vulnerabilities sooner than standard update timelines." .
spdx_security:SsvcDecisionType\/track a owl:Class ;
	rdfs:label "track" ;
	rdfs:subClassOf spdx_security:SsvcDecisionType ;
	skos:definition "The vulnerability does not require action at this time. The organization would continue to track the vulnerability and reassess it if new information becomes available. CISA recommends remediating Track vulnerabilities within standard update timelines." .
spdx_security:SsvcDecisionType\/trackStar a owl:Class ;
	rdfs:label "trackStar" ;
	rdfs:subClassOf spdx_security:SsvcDecisionType ;
	skos:definition "(\"Track*\" in the SSVC spec) The vulnerability contains specific characteristics that may require closer monitoring for changes. CISA recommends remediating Track* vulnerabilities within standard update timelines." .
spdx_security:SsvcDecisionType a owl:Class ;
	rdfs:label "SsvcDecisionType" ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/Security/Vocabularies/SsvcDecisionType/> ;
	owl:unionOf _:c14n84 ;
	skos:definition "Specifies the SSVC decision type." ;
	skos:inScheme spdx_linkml:spdx_security ;
	linkml:permissible_values spdx_security:SsvcDecisionType\/act , spdx_security:SsvcDecisionType\/attend , spdx_security:SsvcDecisionType\/track , spdx_security:SsvcDecisionType\/trackStar .
spdx_security:VexJustificationType\/componentNotPresent a owl:Class ;
	rdfs:label "componentNotPresent" ;
	rdfs:subClassOf spdx_security:VexJustificationType ;
	skos:definition "The software is not affected because the vulnerable component is not in the product." .
spdx_security:VexJustificationType\/inlineMitigationsAlreadyExist a owl:Class ;
	rdfs:label "inlineMitigationsAlreadyExist" ;
	rdfs:subClassOf spdx_security:VexJustificationType ;
	skos:definition "Built-in inline controls or mitigations prevent an adversary from leveraging the vulnerability." .
spdx_security:VexJustificationType\/vulnerableCodeCannotBeControlledByAdversary a owl:Class ;
	rdfs:label "vulnerableCodeCannotBeControlledByAdversary" ;
	rdfs:subClassOf spdx_security:VexJustificationType ;
	skos:definition "The vulnerable component is present, and the component contains the vulnerable code. However, vulnerable code is used in such a way that an attacker cannot mount any anticipated attack." .
spdx_security:VexJustificationType\/vulnerableCodeNotInExecutePath a owl:Class ;
	rdfs:label "vulnerableCodeNotInExecutePath" ;
	rdfs:subClassOf spdx_security:VexJustificationType ;
	skos:definition "The affected code is not reachable through the execution of the code, including non-anticipated states of the product." .
spdx_security:VexJustificationType\/vulnerableCodeNotPresent a owl:Class ;
	rdfs:label "vulnerableCodeNotPresent" ;
	rdfs:subClassOf spdx_security:VexJustificationType ;
	skos:definition "The product is not affected because the code underlying the vulnerability is not present in the product." .
spdx_security:VexJustificationType a owl:Class ;
	rdfs:label "VexJustificationType" ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/Security/Vocabularies/VexJustificationType/> ;
	owl:unionOf _:c14n446 ;
	skos:definition "Specifies the VEX justification type." ;
	skos:inScheme spdx_linkml:spdx_security ;
	linkml:permissible_values spdx_security:VexJustificationType\/componentNotPresent , spdx_security:VexJustificationType\/inlineMitigationsAlreadyExist , spdx_security:VexJustificationType\/vulnerableCodeCannotBeControlledByAdversary , spdx_security:VexJustificationType\/vulnerableCodeNotInExecutePath , spdx_security:VexJustificationType\/vulnerableCodeNotPresent .
spdx_software:ContentIdentifierType\/gitoid a owl:Class ;
	rdfs:label "gitoid" ;
	rdfs:subClassOf spdx_software:ContentIdentifierType ;
	skos:definition "[Gitoid](https://www.iana.org/assignments/uri-schemes/prov/gitoid), stands for [Git Object ID](https://git-scm.com/book/en/v2/Git-Internals-Git-Objects). A gitoid of type blob is a unique hash of a binary artifact. A gitoid may represent either an [Artifact Identifier](https://github.com/omnibor/spec/blob/eb1ee5c961c16215eb8709b2975d193a2007a35d/spec/SPEC.md#artifact-identifier-types) for the software artifact or an [Input Manifest Identifier](https://github.com/omnibor/spec/blob/eb1ee5c961c16215eb8709b2975d193a2007a35d/spec/SPEC.md#input-manifest-identifier) for the software artifact's associated [Artifact Input Manifest](https://github.com/omnibor/spec/blob/eb1ee5c961c16215eb8709b2975d193a2007a35d/spec/SPEC.md#artifact-input-manifest); this ambiguity exists because the Artifact Input Manifest is itself an artifact, and the gitoid of that artifact is its valid identifier. Gitoids calculated on software artifacts (Snippet, File, or Package Elements) should be recorded in the SPDX 3.0 SoftwareArtifact's contentIdentifier property. Gitoids calculated on the Artifact Input Manifest (Input Manifest Identifier) should be recorded in the SPDX 3.0 Element's externalIdentifier property. See [OmniBOR Specification](https://github.com/omnibor/spec/), a minimalistic specification for describing software [Artifact Dependency Graphs](https://github.com/omnibor/spec/blob/eb1ee5c961c16215eb8709b2975d193a2007a35d/spec/SPEC.md#artifact-dependency-graph-adg)." .
spdx_software:ContentIdentifierType\/swhid a owl:Class ;
	rdfs:label "swhid" ;
	rdfs:subClassOf spdx_software:ContentIdentifierType ;
	skos:definition "SoftWare Hash IDentifier, a persistent intrinsic identifier for digital artifacts, such as files, trees (also known as directories or folders), commits, and other objects typically found in version control systems. The format of the identifiers is defined in the [SWHID specification](https://www.swhid.org/specification/v1.1/4.Syntax) (ISO/IEC DIS 18670). They typically look like `swh:1:cnt:94a9ed024d3859793618152ea559a168bbcbb5e2`." .
spdx_software:ContentIdentifierType a owl:Class ;
	rdfs:label "ContentIdentifierType" ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/Software/Vocabularies/ContentIdentifierType/> ;
	owl:unionOf _:c14n226 ;
	skos:definition "Specifies the type of a content identifier." ;
	skos:inScheme spdx_linkml:spdx_software ;
	linkml:permissible_values spdx_software:ContentIdentifierType\/gitoid , spdx_software:ContentIdentifierType\/swhid .
spdx_software:FileKindType\/directory a owl:Class ;
	rdfs:label "directory" ;
	rdfs:subClassOf spdx_software:FileKindType ;
	skos:definition "The file represents a directory and all content stored in that directory." .
spdx_software:FileKindType\/file a owl:Class ;
	rdfs:label "file" ;
	rdfs:subClassOf spdx_software:FileKindType ;
	skos:definition "The file represents a single file (default)." .
spdx_software:FileKindType a owl:Class ;
	rdfs:label "FileKindType" ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/Software/Vocabularies/FileKindType/> ;
	owl:unionOf _:c14n528 ;
	skos:definition "Enumeration of the different kinds of SPDX file." ;
	skos:inScheme spdx_linkml:spdx_software ;
	linkml:permissible_values spdx_software:FileKindType\/directory , spdx_software:FileKindType\/file .
spdx_software:SbomType\/analyzed a owl:Class ;
	rdfs:label "analyzed" ;
	rdfs:subClassOf spdx_software:SbomType ;
	skos:definition "SBOM generated through analysis of artifacts (e.g., executables, packages, containers, and virtual machine images) after its build. Such analysis generally requires a variety of heuristics. In some contexts, this may also be referred to as a \"3rd party\" SBOM." .
spdx_software:SbomType\/build a owl:Class ;
	rdfs:label "build" ;
	rdfs:subClassOf spdx_software:SbomType ;
	skos:definition "SBOM generated as part of the process of building the software to create a releasable artifact (e.g., executable or package) from data such as source files, dependencies, built components, build process ephemeral data, and other SBOMs." .
spdx_software:SbomType\/deployed a owl:Class ;
	rdfs:label "deployed" ;
	rdfs:subClassOf spdx_software:SbomType ;
	skos:definition "SBOM provides an inventory of software that is present on a system. This may be an assembly of other SBOMs that combines analysis of configuration options, and examination of execution behavior in a (potentially simulated) deployment environment." .
spdx_software:SbomType\/design a owl:Class ;
	rdfs:label "design" ;
	rdfs:subClassOf spdx_software:SbomType ;
	skos:definition "SBOM of intended, planned software project or product with included components (some of which may not yet exist) for a new software artifact." .
spdx_software:SbomType\/runtime a owl:Class ;
	rdfs:label "runtime" ;
	rdfs:subClassOf spdx_software:SbomType ;
	skos:definition "SBOM generated through instrumenting the system running the software, to capture only components present in the system, as well as external call-outs or dynamically loaded components. In some contexts, this may also be referred to as an \"Instrumented\" or \"Dynamic\" SBOM." .
spdx_software:SbomType\/source a owl:Class ;
	rdfs:label "source" ;
	rdfs:subClassOf spdx_software:SbomType ;
	skos:definition "SBOM created directly from the development environment, source files, and included dependencies used to build an product artifact." .
spdx_software:SbomType a owl:Class ;
	rdfs:label "SbomType" ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/Software/Vocabularies/SbomType/> ;
	owl:unionOf _:c14n23 ;
	skos:definition "Provides a set of values to be used to describe the common types of SBOMs that tools may create." ;
	skos:inScheme spdx_linkml:spdx_software ;
	linkml:permissible_values spdx_software:SbomType\/analyzed , spdx_software:SbomType\/build , spdx_software:SbomType\/deployed , spdx_software:SbomType\/design , spdx_software:SbomType\/runtime , spdx_software:SbomType\/source .
spdx_software:SoftwarePurpose\/application a owl:Class ;
	rdfs:label "application" ;
	rdfs:subClassOf spdx_software:SoftwarePurpose ;
	skos:definition "The Element is a software application." .
spdx_software:SoftwarePurpose\/archive a owl:Class ;
	rdfs:label "archive" ;
	rdfs:subClassOf spdx_software:SoftwarePurpose ;
	skos:definition "The Element is an archived collection of one or more files (.tar, .zip, etc.)." .
spdx_software:SoftwarePurpose\/bom a owl:Class ;
	rdfs:label "bom" ;
	rdfs:subClassOf spdx_software:SoftwarePurpose ;
	skos:definition "The Element is a bill of materials." .
spdx_software:SoftwarePurpose\/configuration a owl:Class ;
	rdfs:label "configuration" ;
	rdfs:subClassOf spdx_software:SoftwarePurpose ;
	skos:definition "The Element is configuration data." .
spdx_software:SoftwarePurpose\/container a owl:Class ;
	rdfs:label "container" ;
	rdfs:subClassOf spdx_software:SoftwarePurpose ;
	skos:definition "The Element is a container image which can be used by a container runtime application." .
spdx_software:SoftwarePurpose\/data a owl:Class ;
	rdfs:label "data" ;
	rdfs:subClassOf spdx_software:SoftwarePurpose ;
	skos:definition "The Element is data." .
spdx_software:SoftwarePurpose\/device a owl:Class ;
	rdfs:label "device" ;
	rdfs:subClassOf spdx_software:SoftwarePurpose ;
	skos:definition "The Element refers to a chipset, processor, or electronic board." .
spdx_software:SoftwarePurpose\/deviceDriver a owl:Class ;
	rdfs:label "deviceDriver" ;
	rdfs:subClassOf spdx_software:SoftwarePurpose ;
	skos:definition "The Element represents software that controls hardware devices." .
spdx_software:SoftwarePurpose\/diskImage a owl:Class ;
	rdfs:label "diskImage" ;
	rdfs:subClassOf spdx_software:SoftwarePurpose ;
	skos:definition "The Element refers to a disk image that can be written to a disk, booted in a VM, etc. A disk image typically contains most or all of the components necessary to boot, such as bootloaders, kernels, firmware, userspace, etc." .
spdx_software:SoftwarePurpose\/documentation a owl:Class ;
	rdfs:label "documentation" ;
	rdfs:subClassOf spdx_software:SoftwarePurpose ;
	skos:definition "The Element is documentation." .
spdx_software:SoftwarePurpose\/evidence a owl:Class ;
	rdfs:label "evidence" ;
	rdfs:subClassOf spdx_software:SoftwarePurpose ;
	skos:definition "The Element is the evidence that a specification or requirement has been fulfilled." .
spdx_software:SoftwarePurpose\/executable a owl:Class ;
	rdfs:label "executable" ;
	rdfs:subClassOf spdx_software:SoftwarePurpose ;
	skos:definition "The Element is an Artifact that can be run on a computer." .
spdx_software:SoftwarePurpose\/file a owl:Class ;
	rdfs:label "file" ;
	rdfs:subClassOf spdx_software:SoftwarePurpose ;
	skos:definition "The Element is a single file which can be independently distributed (configuration file, statically linked binary, Kubernetes deployment, etc.)." .
spdx_software:SoftwarePurpose\/filesystemImage a owl:Class ;
	rdfs:label "filesystemImage" ;
	rdfs:subClassOf spdx_software:SoftwarePurpose ;
	skos:definition "The Element is a file system image that can be written to a disk (or virtual) partition." .
spdx_software:SoftwarePurpose\/firmware a owl:Class ;
	rdfs:label "firmware" ;
	rdfs:subClassOf spdx_software:SoftwarePurpose ;
	skos:definition "The Element provides low level control over a device's hardware." .
spdx_software:SoftwarePurpose\/framework a owl:Class ;
	rdfs:label "framework" ;
	rdfs:subClassOf spdx_software:SoftwarePurpose ;
	skos:definition "The Element is a software framework." .
spdx_software:SoftwarePurpose\/install a owl:Class ;
	rdfs:label "install" ;
	rdfs:subClassOf spdx_software:SoftwarePurpose ;
	skos:definition "The Element is used to install software on disk." .
spdx_software:SoftwarePurpose\/library a owl:Class ;
	rdfs:label "library" ;
	rdfs:subClassOf spdx_software:SoftwarePurpose ;
	skos:definition "The Element is a software library." .
spdx_software:SoftwarePurpose\/manifest a owl:Class ;
	rdfs:label "manifest" ;
	rdfs:subClassOf spdx_software:SoftwarePurpose ;
	skos:definition "The Element is a software manifest." .
spdx_software:SoftwarePurpose\/model a owl:Class ;
	rdfs:label "model" ;
	rdfs:subClassOf spdx_software:SoftwarePurpose ;
	skos:definition "The Element is a machine learning or artificial intelligence model." .
spdx_software:SoftwarePurpose\/module a owl:Class ;
	rdfs:label "module" ;
	rdfs:subClassOf spdx_software:SoftwarePurpose ;
	skos:definition "The Element is a module of a piece of software." .
spdx_software:SoftwarePurpose\/operatingSystem a owl:Class ;
	rdfs:label "operatingSystem" ;
	rdfs:subClassOf spdx_software:SoftwarePurpose ;
	skos:definition "The Element is an operating system." .
spdx_software:SoftwarePurpose\/other a owl:Class ;
	rdfs:label "other" ;
	rdfs:subClassOf spdx_software:SoftwarePurpose ;
	skos:definition "The Element doesn't fit into any of the other categories." .
spdx_software:SoftwarePurpose\/patch a owl:Class ;
	rdfs:label "patch" ;
	rdfs:subClassOf spdx_software:SoftwarePurpose ;
	skos:definition "The Element contains a set of changes to update, fix, or improve another Element." .
spdx_software:SoftwarePurpose\/platform a owl:Class ;
	rdfs:label "platform" ;
	rdfs:subClassOf spdx_software:SoftwarePurpose ;
	skos:definition "The Element represents a runtime environment." .
spdx_software:SoftwarePurpose\/requirement a owl:Class ;
	rdfs:label "requirement" ;
	rdfs:subClassOf spdx_software:SoftwarePurpose ;
	skos:definition "The Element provides a requirement needed as input for another Element." .
spdx_software:SoftwarePurpose\/source a owl:Class ;
	rdfs:label "source" ;
	rdfs:subClassOf spdx_software:SoftwarePurpose ;
	skos:definition "The Element is a single or a collection of source files." .
spdx_software:SoftwarePurpose\/specification a owl:Class ;
	rdfs:label "specification" ;
	rdfs:subClassOf spdx_software:SoftwarePurpose ;
	skos:definition "The Element is a plan, guideline or strategy how to create, perform or analyze an application." .
spdx_software:SoftwarePurpose\/test a owl:Class ;
	rdfs:label "test" ;
	rdfs:subClassOf spdx_software:SoftwarePurpose ;
	skos:definition "The Element is a test used to verify functionality on an software element." .
spdx_software:SoftwarePurpose a owl:Class ;
	rdfs:label "SoftwarePurpose" ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/Software/Vocabularies/SoftwarePurpose/> ;
	owl:unionOf _:c14n294 ;
	skos:definition "Provides information about the primary purpose of an Element." ;
	skos:inScheme spdx_linkml:spdx_software ;
	linkml:permissible_values spdx_software:SoftwarePurpose\/application , spdx_software:SoftwarePurpose\/archive , spdx_software:SoftwarePurpose\/bom , spdx_software:SoftwarePurpose\/configuration , spdx_software:SoftwarePurpose\/container , spdx_software:SoftwarePurpose\/data , spdx_software:SoftwarePurpose\/device , spdx_software:SoftwarePurpose\/deviceDriver , spdx_software:SoftwarePurpose\/diskImage , spdx_software:SoftwarePurpose\/documentation , spdx_software:SoftwarePurpose\/evidence , spdx_software:SoftwarePurpose\/executable , spdx_software:SoftwarePurpose\/file , spdx_software:SoftwarePurpose\/filesystemImage , spdx_software:SoftwarePurpose\/firmware , spdx_software:SoftwarePurpose\/framework , spdx_software:SoftwarePurpose\/install , spdx_software:SoftwarePurpose\/library , spdx_software:SoftwarePurpose\/manifest , spdx_software:SoftwarePurpose\/model , spdx_software:SoftwarePurpose\/module , spdx_software:SoftwarePurpose\/operatingSystem , spdx_software:SoftwarePurpose\/other , spdx_software:SoftwarePurpose\/patch , spdx_software:SoftwarePurpose\/platform , spdx_software:SoftwarePurpose\/requirement , spdx_software:SoftwarePurpose\/source , spdx_software:SoftwarePurpose\/specification , spdx_software:SoftwarePurpose\/test .
<https://w3id.org/lmodel/spdx.owl.ttl> dcterms:license "Apache-2.0" ;
	dcterms:source <https://spdx.org/rdf/3.0.1/spdx-model.ttl> ;
	dcterms:title "System Package Data Exchange (SPDX)" ;
	pav:version "3.0.1" ;
	a owl:Ontology ;
	rdfs:label "spdx" ;
	rdfs:seeAlso <https://lmodel.github.io/spdx> , <https://spdx.dev/specifications/> , <https://spdx.github.io/spdx-spec/v3.0.1/> ;
	skos:definition "A LinkML rendering of the SPDX 3.0.1 model: its nine profiles, each a module, with every class, property and vocabulary keeping its SPDX IRI." ;
	skos:note "The element descriptions are the model's own rdfs:comment texts, which the SPDX Project publishes under the Community Specification License 1.0." , "The model's individuals (NoAssertionElement, NoneElement, NoAssertionLicense, NoneLicense and SpdxOrganization) are instance data, not schema. A reference to one is an IRI like any other Element reference." , "scripts/spdx_to_linkml.py writes every YAML file in this folder from the vendored model, upstream/spdx-model.ttl. Change the script or the model, never the files." , "spdx_core imports only the LinkML types, each profile module imports the modules it references, and this file adds nothing of its own, so an importer can take one profile." .
spdx_linkml:AIPackage a owl:Class ;
	rdfs:label "AIPackage" ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/AI/Classes/AIPackage/> ;
	rdfs:subClassOf spdx_linkml:Package , _:c14n111 , _:c14n176 , _:c14n183 , _:c14n208 , _:c14n235 , _:c14n295 , _:c14n325 , _:c14n328 , _:c14n342 , _:c14n387 , _:c14n398 , _:c14n422 , _:c14n430 , _:c14n44 , _:c14n449 , _:c14n451 , _:c14n50 , _:c14n517 , _:c14n556 , _:c14n601 , _:c14n610 , _:c14n94 ;
	skos:definition "Specifies an AI package and its associated information." ;
	skos:exactMatch spdx_ai:AIPackage ;
	skos:inScheme spdx_linkml:spdx_ai .
spdx_linkml:Agent a owl:Class ;
	rdfs:label "Agent" ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/Core/Classes/Agent/> ;
	rdfs:subClassOf spdx_linkml:Element ;
	skos:definition "Agent represents anything with the potential to act on a system." ;
	skos:exactMatch spdx_core:Agent ;
	skos:inScheme spdx_linkml:spdx_core .
spdx_linkml:Annotation a owl:Class ;
	rdfs:label "Annotation" ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/Core/Classes/Annotation/> ;
	rdfs:subClassOf spdx_linkml:Element , _:c14n159 , _:c14n221 , _:c14n259 , _:c14n336 , _:c14n418 , _:c14n465 , _:c14n545 ;
	skos:definition "An assertion made in relation to one or more elements." ;
	skos:exactMatch spdx_core:Annotation ;
	skos:inScheme spdx_linkml:spdx_core .
spdx_linkml:AnyLicenseInfo a owl:Class ;
	rdfs:label "AnyLicenseInfo" ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/SimpleLicensing/Classes/AnyLicenseInfo/> ;
	rdfs:subClassOf spdx_linkml:Element ;
	skos:definition "Abstract class representing a license combination consisting of one or more licenses." ;
	skos:exactMatch spdx_simple_licensing:AnyLicenseInfo ;
	skos:inScheme spdx_linkml:spdx_core ;
	skos:note "Declared in the core module because a Core field ranges over it. Its IRI stays in the SimpleLicensing profile's namespace, and so does its subset." .
spdx_linkml:Artifact a owl:Class ;
	rdfs:label "Artifact" ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/Core/Classes/Artifact/> ;
	rdfs:subClassOf spdx_linkml:Element , _:c14n15 , _:c14n157 , _:c14n216 , _:c14n296 , _:c14n345 , _:c14n415 , _:c14n513 , _:c14n56 , _:c14n591 , _:c14n602 ;
	skos:definition "A distinct article or unit within the digital domain." ;
	skos:exactMatch spdx_core:Artifact ;
	skos:inScheme spdx_linkml:spdx_core .
spdx_linkml:Bom a owl:Class ;
	rdfs:label "Bom" ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/Core/Classes/Bom/> ;
	rdfs:subClassOf spdx_linkml:Bundle ;
	skos:definition "A container for a grouping of SPDX-3.0 content characterizing details (provenence, composition, licensing, etc.) about a product." ;
	skos:exactMatch spdx_core:Bom ;
	skos:inScheme spdx_linkml:spdx_core .
spdx_linkml:Build a owl:Class ;
	rdfs:label "Build" ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/Build/Classes/Build/> ;
	rdfs:subClassOf spdx_linkml:Element , _:c14n108 , _:c14n151 , _:c14n170 , _:c14n240 , _:c14n277 , _:c14n331 , _:c14n363 , _:c14n404 , _:c14n412 , _:c14n478 , _:c14n51 , _:c14n555 , _:c14n570 ;
	skos:definition "Class that describes a build instance of software/artifacts." ;
	skos:exactMatch spdx_build:Build ;
	skos:inScheme spdx_linkml:spdx_build .
spdx_linkml:Bundle a owl:Class ;
	rdfs:label "Bundle" ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/Core/Classes/Bundle/> ;
	rdfs:subClassOf spdx_linkml:ElementCollection , _:c14n185 , _:c14n384 ;
	skos:definition "A collection of Elements that have a shared context." ;
	skos:exactMatch spdx_core:Bundle ;
	skos:inScheme spdx_linkml:spdx_core .
spdx_linkml:CdxPropertiesExtension a owl:Class ;
	rdfs:label "CdxPropertiesExtension" ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/Extension/Classes/CdxPropertiesExtension/> ;
	rdfs:subClassOf spdx_linkml:Extension , _:c14n481 , _:c14n588 ;
	skos:definition "A type of extension consisting of a list of name value pairs." ;
	skos:exactMatch spdx_extension:CdxPropertiesExtension ;
	skos:inScheme spdx_linkml:spdx_extension .
spdx_linkml:CdxPropertyEntry a owl:Class ;
	rdfs:label "CdxPropertyEntry" ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/Extension/Classes/CdxPropertyEntry/> ;
	rdfs:subClassOf _:c14n125 , _:c14n268 , _:c14n383 , _:c14n65 , _:c14n67 ;
	skos:definition "A property name with an associated value." ;
	skos:exactMatch spdx_extension:CdxPropertyEntry ;
	skos:inScheme spdx_linkml:spdx_extension .
spdx_linkml:ConjunctiveLicenseSet a owl:Class ;
	rdfs:label "ConjunctiveLicenseSet" ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/ExpandedLicensing/Classes/ConjunctiveLicenseSet/> ;
	rdfs:subClassOf spdx_linkml:AnyLicenseInfo , _:c14n264 ;
	skos:definition "Portion of an AnyLicenseInfo representing a set of licensing information where all elements apply." ;
	skos:exactMatch spdx_expanded_licensing:ConjunctiveLicenseSet ;
	skos:inScheme spdx_linkml:spdx_expanded_licensing .
spdx_linkml:ContentIdentifier a owl:Class ;
	rdfs:label "ContentIdentifier" ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/Software/Classes/ContentIdentifier/> ;
	rdfs:subClassOf spdx_linkml:IntegrityMethod , _:c14n52 , _:c14n550 , _:c14n573 , _:c14n595 ;
	skos:definition "A canonical, unique, immutable identifier" ;
	skos:exactMatch spdx_software:ContentIdentifier ;
	skos:inScheme spdx_linkml:spdx_software .
spdx_linkml:CreationInfo a owl:Class ;
	rdfs:label "CreationInfo" ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/Core/Classes/CreationInfo/> ;
	rdfs:subClassOf _:c14n104 , _:c14n18 , _:c14n313 , _:c14n324 , _:c14n466 , _:c14n47 , _:c14n496 , _:c14n549 , _:c14n564 ;
	skos:definition "Provides information about the creation of the Element." ;
	skos:exactMatch spdx_core:CreationInfo ;
	skos:inScheme spdx_linkml:spdx_core .
spdx_linkml:CustomLicense a owl:Class ;
	rdfs:label "CustomLicense" ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/ExpandedLicensing/Classes/CustomLicense/> ;
	rdfs:subClassOf spdx_linkml:License ;
	skos:definition "A license that is not listed on the SPDX License List." ;
