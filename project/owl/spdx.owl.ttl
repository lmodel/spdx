    rdfs:label "hasAddedFile" ;
    rdfs:subClassOf core:RelationshipType ;
    skos:definition "Every `to` Element is a file added to the `from` Element (`from` hasAddedFile `to`)." .

<https://spdx.org/rdf/3.0.1/terms/Core/RelationshipType/hasAssessmentFor> a owl:Class ;
