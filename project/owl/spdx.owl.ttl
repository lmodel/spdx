    rdfs:label "hasDistributionArtifact" ;
    rdfs:subClassOf core:RelationshipType ;
    skos:definition "The `from` Element is distributed as an artifact in each `to` Element (e.g. an RPM or archive file)." .

<https://spdx.org/rdf/3.0.1/terms/Core/RelationshipType/hasDocumentation> a owl:Class ;
    rdfs:label "hasDocumentation" ;
    rdfs:subClassOf core:RelationshipType ;
    skos:definition "The `from` Element is documented by each `to` Element." .

<https://spdx.org/rdf/3.0.1/terms/Core/RelationshipType/hasDynamicLink> a owl:Class ;
    rdfs:label "hasDynamicLink" ;
    rdfs:subClassOf core:RelationshipType ;
