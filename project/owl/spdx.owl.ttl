<https://spdx.org/rdf/3.0.1/terms/Core/RelationshipType/availableFrom> a owl:Class ;
    rdfs:label "availableFrom" ;
    rdfs:subClassOf core:RelationshipType ;
    skos:definition "The `from` Element is available from the additional supplier described by each `to` Element." .

