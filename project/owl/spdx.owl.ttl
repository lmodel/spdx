<https://spdx.org/rdf/3.0.1/terms/Core/RelationshipType/hasEvidence> a owl:Class ;
    rdfs:label "hasEvidence" ;
    rdfs:subClassOf core:RelationshipType ;
    skos:definition "Every `to` Element is considered as evidence for the `from` Element (`from` hasEvidence `to`)." .

<https://spdx.org/rdf/3.0.1/terms/Core/RelationshipType/hasExample> a owl:Class ;
    rdfs:label "hasExample" ;
    rdfs:subClassOf core:RelationshipType ;
    skos:definition "Every `to` Element is an example for the `from` Element (`from` hasExample `to`)." .

