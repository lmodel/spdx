    skos:definition "Every `to` Element is related to the `from` Element where the relationship type is not described by any of the SPDX relationship types (this relationship is directionless)." .

<https://spdx.org/rdf/3.0.1/terms/Core/RelationshipType/packagedBy> a owl:Class ;
    rdfs:label "packagedBy" ;
