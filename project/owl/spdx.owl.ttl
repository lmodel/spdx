<https://spdx.org/rdf/3.0.1/terms/Core/RelationshipType/hasTest> a owl:Class ;
    rdfs:label "hasTest" ;
    rdfs:subClassOf core:RelationshipType ;
    skos:definition "Every `to` Element is a test artifact for the `from` Element (`from` hasTest `to`), during a LifecycleScopeType period." .

