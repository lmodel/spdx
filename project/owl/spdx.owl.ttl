    rdfs:label "hasHost" ;
    rdfs:subClassOf core:RelationshipType ;
    skos:definition "The `from` Build was run on the `to` Element during a LifecycleScopeType period (e.g. the host that the build runs on)." .

<https://spdx.org/rdf/3.0.1/terms/Core/RelationshipType/hasInput> a owl:Class ;
    rdfs:label "hasInput" ;
    rdfs:subClassOf core:RelationshipType ;
    skos:definition "The `from` Build has each `to` Element as an input, during a LifecycleScopeType period." .

<https://spdx.org/rdf/3.0.1/terms/Core/RelationshipType/hasMetadata> a owl:Class ;
    rdfs:label "hasMetadata" ;
    rdfs:subClassOf core:RelationshipType ;
    skos:definition "Every `to` Element is metadata about the `from` Element (`from` hasMetadata `to`)." .

<https://spdx.org/rdf/3.0.1/terms/Core/RelationshipType/hasOptionalComponent> a owl:Class ;
    rdfs:label "hasOptionalComponent" ;
    rdfs:subClassOf core:RelationshipType ;
    skos:definition "Every `to` Element is an optional component of the `from` Element (`from` hasOptionalComponent `to`)." .

<https://spdx.org/rdf/3.0.1/terms/Core/RelationshipType/hasOptionalDependency> a owl:Class ;
    rdfs:label "hasOptionalDependency" ;
    rdfs:subClassOf core:RelationshipType ;
    skos:definition "The `from` Element optionally depends on each `to` Element, during a LifecycleScopeType period." .

<https://spdx.org/rdf/3.0.1/terms/Core/RelationshipType/hasOutput> a owl:Class ;
    rdfs:label "hasOutput" ;
    rdfs:subClassOf core:RelationshipType ;
    skos:definition "The `from` Build element generates each `to` Element as an output, during a LifecycleScopeType period." .

<https://spdx.org/rdf/3.0.1/terms/Core/RelationshipType/hasPrerequisite> a owl:Class ;
    rdfs:label "hasPrerequisite" ;
