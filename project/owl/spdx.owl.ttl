spdx_core:RelationshipCompleteness\/complete a owl:Class ;
	rdfs:label "complete" ;
	rdfs:subClassOf spdx_core:RelationshipCompleteness ;
	skos:definition "The relationship is known to be exhaustive." .
spdx_core:RelationshipCompleteness\/incomplete a owl:Class ;
	rdfs:label "incomplete" ;
	rdfs:subClassOf spdx_core:RelationshipCompleteness ;
	skos:definition "The relationship is known not to be exhaustive." .
spdx_core:RelationshipCompleteness\/noAssertion a owl:Class ;
	rdfs:label "noAssertion" ;
	rdfs:subClassOf spdx_core:RelationshipCompleteness ;
	skos:definition "No assertion can be made about the completeness of the relationship." .
spdx_core:RelationshipCompleteness a owl:Class ;
	rdfs:label "RelationshipCompleteness" ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/Core/Vocabularies/RelationshipCompleteness/> ;
