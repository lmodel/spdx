spdx_linkml:scope a owl:ObjectProperty ;
	rdfs:label "scope" ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/Core/Properties/scope/> ;
	skos:definition "Capture the scope of information about a specific relationship between elements." ;
	skos:inScheme spdx_linkml:spdx_core .
spdx_linkml:score a owl:DatatypeProperty ;
	rdfs:label "score" ;
	rdfs:range xsd:decimal ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/Security/Properties/score/> ;
	skos:definition "Provides a numerical (0-10) representation of the severity of a vulnerability." ;
	skos:inScheme spdx_linkml:spdx_security .
spdx_linkml:security_locator a owl:DatatypeProperty ;
	rdfs:label "security_locator" ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/Security/Properties/locator/> ;
	skos:definition "Provides the location of an exploit catalog." ;
	skos:inScheme spdx_linkml:spdx_security .
spdx_linkml:seeAlso a owl:DatatypeProperty ;
	rdfs:label "seeAlso" ;
	rdfs:range xsd:anyURI ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/ExpandedLicensing/Properties/seeAlso/> ;
	skos:definition "Contains a URL where the License or LicenseAddition can be found in use." ;
	skos:inScheme spdx_linkml:spdx_expanded_licensing .
spdx_linkml:sensor a owl:ObjectProperty ;
	rdfs:label "sensor" ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/Dataset/Properties/sensor/> ;
	skos:definition "Describes a sensor used for collecting the data." ;
	skos:inScheme spdx_linkml:spdx_dataset .
spdx_linkml:severity a owl:ObjectProperty ;
	rdfs:label "severity" ;
	rdfs:range spdx_security:CvssSeverityType ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/Security/Properties/severity/> ;
	skos:definition "Specifies the CVSS qualitative severity rating of a vulnerability in relation to a piece of software." ;
	skos:inScheme spdx_linkml:spdx_security .
spdx_linkml:snippetFromFile a owl:ObjectProperty ;
	rdfs:label "snippetFromFile" ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/Software/Properties/snippetFromFile/> ;
	skos:definition "Defines the original host file that the snippet information applies to." ;
	skos:inScheme spdx_linkml:spdx_software .
spdx_linkml:sourceInfo a owl:DatatypeProperty ;
	rdfs:label "sourceInfo" ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/Software/Properties/sourceInfo/> ;
	skos:definition "Records any relevant background information or additional comments about the origin of the package." ;
	skos:inScheme spdx_linkml:spdx_software .
spdx_linkml:spdxId a owl:DatatypeProperty ;
	rdfs:label "spdxId" ;
	skos:definition "The IRI that identifies this Element. A reference to an Element from any field is this IRI." ;
	skos:inScheme spdx_linkml:spdx_core ;
	skos:note "SPDX JSON-LD writes an Element's IRI as spdxId. The model has no property for it, so this key is the schema's own, in its own namespace." .
spdx_linkml:specVersion a owl:DatatypeProperty ;
	rdfs:label "specVersion" ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/Core/Properties/specVersion/> ;
	skos:definition "Provides a reference number that can be used to understand how to parse and interpret an Element." ;
	skos:inScheme spdx_linkml:spdx_core .
spdx_linkml:standardAdditionTemplate a owl:DatatypeProperty ;
	rdfs:label "standardAdditionTemplate" ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/ExpandedLicensing/Properties/standardAdditionTemplate/> ;
	skos:definition "Identifies the full text of a LicenseAddition, in SPDX templating format." ;
	skos:inScheme spdx_linkml:spdx_expanded_licensing .
spdx_linkml:standardCompliance a owl:DatatypeProperty ;
	rdfs:label "standardCompliance" ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/AI/Properties/standardCompliance/> ;
	skos:definition "Captures a standard that is being complied with." ;
	skos:inScheme spdx_linkml:spdx_ai .
spdx_linkml:standardLicenseHeader a owl:DatatypeProperty ;
	rdfs:label "standardLicenseHeader" ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/ExpandedLicensing/Properties/standardLicenseHeader/> ;
	skos:definition "Provides a License author's preferred text to indicate that a file is covered by the License." ;
	skos:inScheme spdx_linkml:spdx_expanded_licensing .
spdx_linkml:standardLicenseTemplate a owl:DatatypeProperty ;
	rdfs:label "standardLicenseTemplate" ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/ExpandedLicensing/Properties/standardLicenseTemplate/> ;
	skos:definition "Identifies the full text of a License, in SPDX templating format." ;
	skos:inScheme spdx_linkml:spdx_expanded_licensing .
spdx_linkml:standardName a owl:DatatypeProperty ;
	rdfs:label "standardName" ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/Core/Properties/standardName/> ;
	skos:definition "The name of a relevant standard that may apply to an artifact." ;
	skos:inScheme spdx_linkml:spdx_core .
spdx_linkml:startTime a owl:DatatypeProperty ;
	rdfs:label "startTime" ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/Core/Properties/startTime/> ;
	skos:definition "Specifies the time from which an element is applicable / valid." ;
	skos:inScheme spdx_linkml:spdx_core .
spdx_linkml:statement a owl:DatatypeProperty ;
	rdfs:label "statement" ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/Core/Properties/statement/> ;
	skos:definition "Commentary on an assertion that an annotator has made." ;
	skos:inScheme spdx_linkml:spdx_core .
spdx_linkml:statusNotes a owl:DatatypeProperty ;
	rdfs:label "statusNotes" ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/Security/Properties/statusNotes/> ;
	skos:definition "Conveys information about how VEX status was determined." ;
	skos:inScheme spdx_linkml:spdx_security .
spdx_linkml:subject a owl:ObjectProperty ;
	rdfs:label "subject" ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/Core/Properties/subject/> ;
	skos:definition "An Element an annotator has made an assertion about." ;
	skos:inScheme spdx_linkml:spdx_core .
spdx_linkml:subjectAddition a owl:ObjectProperty ;
	rdfs:label "subjectAddition" ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/ExpandedLicensing/Properties/subjectAddition/> ;
	skos:definition "A LicenseAddition participating in a 'with addition' model." ;
	skos:inScheme spdx_linkml:spdx_expanded_licensing .
spdx_linkml:subjectExtendableLicense a owl:ObjectProperty ;
	rdfs:label "subjectExtendableLicense" ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/ExpandedLicensing/Properties/subjectExtendableLicense/> ;
	skos:definition "A License participating in a 'with addition' model." ;
	skos:inScheme spdx_linkml:spdx_expanded_licensing .
spdx_linkml:subjectLicense a owl:ObjectProperty ;
	rdfs:label "subjectLicense" ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/ExpandedLicensing/Properties/subjectLicense/> ;
	skos:definition "A License participating in an 'or later' model." ;
	skos:inScheme spdx_linkml:spdx_expanded_licensing .
spdx_linkml:summary a owl:DatatypeProperty ;
	rdfs:label "summary" ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/Core/Properties/summary/> ;
	skos:definition "A short description of an Element." ;
	skos:inScheme spdx_linkml:spdx_core .
spdx_linkml:suppliedBy a owl:ObjectProperty ;
	rdfs:label "suppliedBy" ;
	rdfs:range spdx_linkml:Agent ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/Core/Properties/suppliedBy/> ;
	skos:definition "Identifies who or what supplied the artifact or VulnAssessmentRelationship referenced by the Element." ;
	skos:inScheme spdx_linkml:spdx_core .
spdx_linkml:supportLevel a owl:ObjectProperty ;
	rdfs:label "supportLevel" ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/Core/Properties/supportLevel/> ;
	skos:definition "Specifies the level of support associated with an artifact." ;
	skos:inScheme spdx_linkml:spdx_core .
spdx_linkml:to a owl:ObjectProperty ;
	rdfs:label "to" ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/Core/Properties/to/> ;
	skos:definition "References an Element on the right-hand side of a relationship." ;
	skos:inScheme spdx_linkml:spdx_core .
spdx_linkml:trainingEnergyConsumption a owl:ObjectProperty ;
	rdfs:label "trainingEnergyConsumption" ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/AI/Properties/trainingEnergyConsumption/> ;
	skos:definition "Specifies the amount of energy consumed when training the AI model that is being used in the AI system." ;
	skos:inScheme spdx_linkml:spdx_ai .
spdx_linkml:type a owl:DatatypeProperty ;
	rdfs:label "type" ;
	rdfs:range xsd:string ;
	skos:definition "The name of the class an object is an instance of, such as Package or Hash." ;
	skos:inScheme spdx_linkml:spdx_core ;
	skos:note "SPDX JSON-LD writes the same key with the profile prefixed to a class outside Core, software_Package for a Package. This schema takes the bare class name." .
spdx_linkml:typeOfModel a owl:DatatypeProperty ;
	rdfs:label "typeOfModel" ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/AI/Properties/typeOfModel/> ;
	skos:definition "Records the type of the model used in the AI software." ;
	skos:inScheme spdx_linkml:spdx_ai .
spdx_linkml:useSensitivePersonalInformation a owl:ObjectProperty ;
	rdfs:label "useSensitivePersonalInformation" ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/AI/Properties/useSensitivePersonalInformation/> ;
	skos:definition "Records if sensitive personal information is used during model training or could be used during the inference." ;
	skos:inScheme spdx_linkml:spdx_ai .
spdx_linkml:validUntilTime a owl:DatatypeProperty ;
	rdfs:label "validUntilTime" ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/Core/Properties/validUntilTime/> ;
	skos:definition "Specifies until when the artifact can be used before its usage needs to be reassessed." ;
	skos:inScheme spdx_linkml:spdx_core .
spdx_linkml:value a owl:DatatypeProperty ;
	rdfs:label "value" ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/Core/Properties/value/> ;
	skos:definition "A value used in a generic key-value pair." ;
	skos:inScheme spdx_linkml:spdx_core .
spdx_linkml:vectorString a owl:DatatypeProperty ;
	rdfs:label "vectorString" ;
	rdfs:range xsd:string ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/Security/Properties/vectorString/> ;
	skos:definition "Specifies the CVSS vector string for a vulnerability." ;
	skos:inScheme spdx_linkml:spdx_security .
spdx_linkml:verifiedUsing a owl:ObjectProperty ;
	rdfs:label "verifiedUsing" ;
	rdfs:range spdx_linkml:IntegrityMethod ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/Core/Properties/verifiedUsing/> ;
	skos:definition "Provides an IntegrityMethod with which the integrity of an Element can be asserted." ;
	skos:inScheme spdx_linkml:spdx_core .
spdx_linkml:vexVersion a owl:DatatypeProperty ;
	rdfs:label "vexVersion" ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/Security/Properties/vexVersion/> ;
	skos:definition "Specifies the version of a VEX statement." ;
	skos:inScheme spdx_linkml:spdx_security .
spdx_linkml:withdrawnTime a owl:DatatypeProperty ;
	rdfs:label "withdrawnTime" ;
	rdfs:range xsd:dateTimeStamp ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/Security/Properties/withdrawnTime/> ;
	skos:definition "Specified the time and date when a vulnerability was withdrawn." ;
	skos:inScheme spdx_linkml:spdx_security .
