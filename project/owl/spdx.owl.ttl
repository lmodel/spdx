spdx:DictionaryEntry a owl:Class ;
    rdfs:label "DictionaryEntry" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spdx:key ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty spdx:key ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:key ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spdx:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spdx:value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spdx:value ] ;
    skos:definition "A key with an associated value." ;
    skos:exactMatch core:DictionaryEntry ;
    skos:inScheme <https://w3id.org/lmodel/spdx> ;
    spdx:shacl_node_kind "sh:BlankNodeOrIRI" .

spdx:comment a owl:DatatypeProperty ;
