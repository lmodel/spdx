    rdfs:subClassOf core:RelationshipType ;
    skos:definition "The `from` Element is a descendant of each `to` Element." .

<https://spdx.org/rdf/3.0.1/terms/Core/RelationshipType/describes> a owl:Class ;
    rdfs:label "describes" ;
    rdfs:subClassOf core:RelationshipType ;
    skos:definition "The `from` Element describes each `to` Element. To denote the root(s) of a tree of elements in a collection, the rootElement property should be used." .

<https://spdx.org/rdf/3.0.1/terms/Core/RelationshipType/doesNotAffect> a owl:Class ;
    rdfs:label "doesNotAffect" ;
    rdfs:subClassOf core:RelationshipType ;
    skos:definition "The `from` Vulnerability has no impact on each `to` Element. The use of the `doesNotAffect` is constrained to `VexNotAffectedVulnAssessmentRelationship` classed relationships." .

<https://spdx.org/rdf/3.0.1/terms/Core/RelationshipType/expandsTo> a owl:Class ;
    rdfs:label "expandsTo" ;
    rdfs:subClassOf core:RelationshipType ;
    skos:definition "The `from` archive expands out as an artifact described by each `to` Element." .

<https://spdx.org/rdf/3.0.1/terms/Core/RelationshipType/exploitCreatedBy> a owl:Class ;
    rdfs:label "exploitCreatedBy" ;
    rdfs:subClassOf core:RelationshipType ;
