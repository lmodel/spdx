    {
      "name": "LicenseExpression_licenseListVersion",
      "definition_uri": "https://spdx.org/rdf/3.0.1/terms/licenseListVersion",
      "description": "The version of the SPDX License List used in the license expression.",
      "notes": [
        "SHACL nodeKind: sh:Literal"
      ],
      "from_schema": "https://w3id.org/lmodel/spdx",
      "mappings": [
        "https://spdx.org/rdf/3.0.1/terms/SimpleLicensing/licenseListVersion"
      ],
