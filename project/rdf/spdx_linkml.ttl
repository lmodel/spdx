<https://w3id.org/lmodel/spdx/finetuningEnergyConsumption> OIO:inSubset <https://w3id.org/lmodel/spdx/spdx_ai> ;
	a linkml:SlotDefinition ;
	rdfs:seeAlso "https://spdx.github.io/spdx-spec/v3.0.1/model/AI/Properties/finetuningEnergyConsumption/"^^xsd:anyURI ;
