	linkml:slot_uri "https://w3id.org/lmodel/spdx/spdxId"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/email> linkml:description "Email address, as defined in [RFC 3696](https://datatracker.ietf.org/doc/rfc3986/) Section 3." ;
	linkml:meaning "spdx_core:ExternalIdentifierType/email"^^xsd:anyURI .
