	linkml:definition_uri "https://w3id.org/lmodel/spdx/supportLevel"^^xsd:anyURI ;
	linkml:description "Specifies the level of support associated with an artifact." ;
	linkml:domain_of <https://w3id.org/lmodel/spdx/Artifact> ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/spdx/Artifact> ;
	linkml:range <https://w3id.org/lmodel/spdx/SupportType> ;
	linkml:slot_uri "https://spdx.org/rdf/3.0.1/terms/Core/supportLevel"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/swhid> linkml:description "SoftWare Hash IDentifier, a persistent intrinsic identifier for digital artifacts, such as files, trees (also known as directories or folders), commits, and other objects typically found in version control systems. The format of the identifiers is defined in the [SWHID specification](https://www.swhid.org/specification/v1.1/4.Syntax) (ISO/IEC DIS 18670). They typically look like `swh:1:cnt:94a9ed024d3859793618152ea559a168bbcbb5e2`." ;
	linkml:meaning "spdx_core:ExternalIdentifierType/swhid"^^xsd:anyURI , "spdx_software:ContentIdentifierType/swhid"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/swid> linkml:description "Concise Software Identification (CoSWID) tag, as defined in [RFC 9393](https://datatracker.ietf.org/doc/rfc9393/) Section 2.3." ;
	linkml:meaning "spdx_core:ExternalIdentifierType/swid"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/syntactic> linkml:description "data describes the syntax or semantics of a language or text, such as a parse tree used for natural language processing." ;
	linkml:meaning "spdx_dataset:DatasetType/syntactic"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/test> linkml:description "A relationship has specific context implications during an element's testing phase, during development." , "The Element is a test used to verify functionality on an software element." ;
	linkml:meaning "spdx_core:LifecycleScopeType/test"^^xsd:anyURI , "spdx_software:SoftwarePurpose/test"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/testedOn> linkml:description "The `from` Element has been tested on the `to` Element(s)." ;
	linkml:meaning "spdx_core:RelationshipType/testedOn"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/text> linkml:description "data consists of unstructured text, such as a book, Wikipedia article (without images), or transcript." ;
	linkml:meaning "spdx_dataset:DatasetType/text"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/time> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"time\"." , "URI is dateTime because OWL reasoners do not work with straight date or time" ;
	skos:exactMatch "schema:Time"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "XSDTime" ;
	linkml:definition_uri "https://w3id.org/linkml/Time"^^xsd:anyURI ;
	linkml:description "A time object represents a (local) time of day, independent of any particular day" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#time"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/timeseries> linkml:description "data is recorded in an ordered sequence of timestamped entries, such as the price of a stock over the course of a day." ;
	linkml:meaning "spdx_dataset:DatasetType/timeseries"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/timestamp> linkml:description "data is recorded with a timestamp for each entry, but not necessarily ordered or at specific intervals, such as when a taxi ride starts and ends." ;
	linkml:meaning "spdx_dataset:DatasetType/timestamp"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/to> OIO:inSubset <https://w3id.org/lmodel/spdx/spdx_core> ;
	a linkml:SlotDefinition ;
	rdfs:seeAlso "https://spdx.github.io/spdx-spec/v3.0.1/model/Core/Properties/to/"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/spdx/spdx_core"^^xsd:anyURI ;
	skos:mappingRelation "https://spdx.org/rdf/3.0.1/terms/Core/to"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/spdx/to"^^xsd:anyURI ;
	linkml:description "References an Element on the right-hand side of a relationship." ;
	linkml:domain_of <https://w3id.org/lmodel/spdx/Relationship> ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/spdx/Relationship> ;
	linkml:range <https://w3id.org/lmodel/spdx/Element> ;
	linkml:required true ;
	linkml:slot_uri "https://spdx.org/rdf/3.0.1/terms/Core/to"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/track> linkml:description "The vulnerability does not require action at this time. The organization would continue to track the vulnerability and reassess it if new information becomes available. CISA recommends remediating Track vulnerabilities within standard update timelines." ;
	linkml:meaning "spdx_security:SsvcDecisionType/track"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/trackStar> linkml:description "(\"Track*\" in the SSVC spec) The vulnerability contains specific characteristics that may require closer monitoring for changes. CISA recommends remediating Track* vulnerabilities within standard update timelines." ;
