<https://w3id.org/lmodel/spdx/suppliedBy> OIO:inSubset <https://w3id.org/lmodel/spdx/spdx_core> ;
	a linkml:SlotDefinition ;
	rdfs:seeAlso "https://spdx.github.io/spdx-spec/v3.0.1/model/Core/Properties/suppliedBy/"^^xsd:anyURI ;
