	linkml:slot_uri "https://spdx.org/rdf/3.0.1/terms/AI/finetuningEnergyConsumption"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/firmware> linkml:description "The Element provides low level control over a device's hardware." ;
	linkml:meaning "spdx_software:SoftwarePurpose/firmware"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/fixedBy> linkml:description "Designates a `from` Vulnerability has been fixed by the `to` Agent(s)." ;
	linkml:meaning "spdx_core:RelationshipType/fixedBy"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/fixedIn> linkml:description "A `from` Vulnerability has been fixed in each `to` Element. The use of the `fixedIn` type is constrained to `VexFixedVulnAssessmentRelationship` classed relationships." ;
	linkml:meaning "spdx_core:RelationshipType/fixedIn"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/float> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"float\"." ;
	skos:exactMatch "schema:Float"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "float" ;
	linkml:definition_uri "https://w3id.org/linkml/Float"^^xsd:anyURI ;
	linkml:description "A real number that conforms to the xsd:float specification" ;
	linkml:imported_from "linkml:types" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#float"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/foundBy> linkml:description "Designates a `from` Vulnerability was originally discovered by the `to` Agent(s)." ;
	linkml:meaning "spdx_core:RelationshipType/foundBy"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/framework> linkml:description "The Element is a software framework." ;
	linkml:meaning "spdx_software:SoftwarePurpose/framework"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/from> OIO:inSubset <https://w3id.org/lmodel/spdx/spdx_core> ;
	a linkml:SlotDefinition ;
	rdfs:seeAlso "https://spdx.github.io/spdx-spec/v3.0.1/model/Core/Properties/from/"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/spdx/spdx_core"^^xsd:anyURI ;
	skos:mappingRelation "https://spdx.org/rdf/3.0.1/terms/Core/from"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/spdx/from"^^xsd:anyURI ;
	linkml:description "References the Element on the left-hand side of a relationship." ;
	linkml:domain_of <https://w3id.org/lmodel/spdx/Relationship> ;
	linkml:owner <https://w3id.org/lmodel/spdx/Relationship> ;
	linkml:range <https://w3id.org/lmodel/spdx/Element> ;
	linkml:required true ;
	linkml:slot_uri "https://spdx.org/rdf/3.0.1/terms/Core/from"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/funding> linkml:description "A reference to funding information related to a package." ;
	linkml:meaning "spdx_core:ExternalRefType/funding"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/generates> linkml:description "The `from` Element generates each `to` Element." ;
	linkml:meaning "spdx_core:RelationshipType/generates"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/gitoid> linkml:description "[Gitoid](https://www.iana.org/assignments/uri-schemes/prov/gitoid), stands for [Git Object ID](https://git-scm.com/book/en/v2/Git-Internals-Git-Objects). A gitoid of type blob is a unique hash of a binary artifact. A gitoid may represent either an [Artifact Identifier](https://github.com/omnibor/spec/blob/eb1ee5c961c16215eb8709b2975d193a2007a35d/spec/SPEC.md#artifact-identifier-types) for the software artifact or an [Input Manifest Identifier](https://github.com/omnibor/spec/blob/eb1ee5c961c16215eb8709b2975d193a2007a35d/spec/SPEC.md#input-manifest-identifier) for the software artifact's associated [Artifact Input Manifest](https://github.com/omnibor/spec/blob/eb1ee5c961c16215eb8709b2975d193a2007a35d/spec/SPEC.md#artifact-input-manifest); this ambiguity exists because the Artifact Input Manifest is itself an artifact, and the gitoid of that artifact is its valid identifier. Gitoids calculated on software artifacts (Snippet, File, or Package Elements) should be recorded in the SPDX 3.0 SoftwareArtifact's contentIdentifier property. Gitoids calculated on the Artifact Input Manifest (Input Manifest Identifier) should be recorded in the SPDX 3.0 Element's externalIdentifier property. See [OmniBOR Specification](https://github.com/omnibor/spec/), a minimalistic specification for describing software [Artifact Dependency Graphs](https://github.com/omnibor/spec/blob/eb1ee5c961c16215eb8709b2975d193a2007a35d/spec/SPEC.md#artifact-dependency-graph-adg)." ;
	linkml:meaning "spdx_core:ExternalIdentifierType/gitoid"^^xsd:anyURI , "spdx_software:ContentIdentifierType/gitoid"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/graph> linkml:description "data is in the form of a graph where entries are somehow related to each other through edges, such a social network of friends." ;
	linkml:meaning "spdx_dataset:DatasetType/graph"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/green> linkml:description "Dataset can be shared within a community of peers and partners." ;
	linkml:meaning "spdx_dataset:ConfidentialityLevelType/green"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/hasAddedFile> linkml:description "Every `to` Element is a file added to the `from` Element (`from` hasAddedFile `to`)." ;
	linkml:meaning "spdx_core:RelationshipType/hasAddedFile"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/hasAssessmentFor> linkml:description "Relates a `from` Vulnerability and each `to` Element with a security assessment. To be used with `VulnAssessmentRelationship` types." ;
	linkml:meaning "spdx_core:RelationshipType/hasAssessmentFor"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/hasAssociatedVulnerability> linkml:description "Used to associate a `from` Artifact with each `to` Vulnerability." ;
	linkml:meaning "spdx_core:RelationshipType/hasAssociatedVulnerability"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/hasConcludedLicense> linkml:description "The `from` SoftwareArtifact is concluded by the SPDX data creator to be governed by each `to` license." ;
	linkml:meaning "spdx_core:RelationshipType/hasConcludedLicense"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/hasDataFile> linkml:description "The `from` Element treats each `to` Element as a data file. A data file is an artifact that stores data required or optional for the `from` Element's functionality. A data file can be a database file, an index file, a log file, an AI model file, a calibration data file, a temporary file, a backup file, and more. For AI training dataset, test dataset, test artifact, configuration data, build input data, and build output data, please consider using the more specific relationship types: `trainedOn`, `testedOn`, `hasTest`, `configures`, `hasInput`, and `hasOutput`, respectively. This relationship does not imply dependency." ;
	linkml:meaning "spdx_core:RelationshipType/hasDataFile"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/hasDeclaredLicense> linkml:description "The `from` SoftwareArtifact was discovered to actually contain each `to` license, for example as detected by use of automated tooling." ;
	linkml:meaning "spdx_core:RelationshipType/hasDeclaredLicense"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/hasDeletedFile> linkml:description "Every `to` Element is a file deleted from the `from` Element (`from` hasDeletedFile `to`)." ;
	linkml:meaning "spdx_core:RelationshipType/hasDeletedFile"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/hasDependencyManifest> linkml:description "The `from` Element has manifest files that contain dependency information in each `to` Element." ;
	linkml:meaning "spdx_core:RelationshipType/hasDependencyManifest"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/hasDistributionArtifact> linkml:description "The `from` Element is distributed as an artifact in each `to` Element (e.g. an RPM or archive file)." ;
	linkml:meaning "spdx_core:RelationshipType/hasDistributionArtifact"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/hasDocumentation> linkml:description "The `from` Element is documented by each `to` Element." ;
	linkml:meaning "spdx_core:RelationshipType/hasDocumentation"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/hasDynamicLink> linkml:description "The `from` Element dynamically links in each `to` Element, during a LifecycleScopeType period." ;
	linkml:meaning "spdx_core:RelationshipType/hasDynamicLink"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/hasEvidence> linkml:description "Every `to` Element is considered as evidence for the `from` Element (`from` hasEvidence `to`)." ;
	linkml:meaning "spdx_core:RelationshipType/hasEvidence"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/hasExample> linkml:description "Every `to` Element is an example for the `from` Element (`from` hasExample `to`)." ;
	linkml:meaning "spdx_core:RelationshipType/hasExample"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/hasHost> linkml:description "The `from` Build was run on the `to` Element during a LifecycleScopeType period (e.g. the host that the build runs on)." ;
	linkml:meaning "spdx_core:RelationshipType/hasHost"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/hasInput> linkml:description "The `from` Build has each `to` Element as an input, during a LifecycleScopeType period." ;
	linkml:meaning "spdx_core:RelationshipType/hasInput"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/hasMetadata> linkml:description "Every `to` Element is metadata about the `from` Element (`from` hasMetadata `to`)." ;
	linkml:meaning "spdx_core:RelationshipType/hasMetadata"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/hasOptionalComponent> linkml:description "Every `to` Element is an optional component of the `from` Element (`from` hasOptionalComponent `to`)." ;
	linkml:meaning "spdx_core:RelationshipType/hasOptionalComponent"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/hasOptionalDependency> linkml:description "The `from` Element optionally depends on each `to` Element, during a LifecycleScopeType period." ;
	linkml:meaning "spdx_core:RelationshipType/hasOptionalDependency"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/hasOutput> linkml:description "The `from` Build element generates each `to` Element as an output, during a LifecycleScopeType period." ;
	linkml:meaning "spdx_core:RelationshipType/hasOutput"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/hasPrerequisite> linkml:description "The `from` Element has a prerequisite on each `to` Element, during a LifecycleScopeType period." ;
	linkml:meaning "spdx_core:RelationshipType/hasPrerequisite"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/hasProvidedDependency> linkml:description "The `from` Element has a dependency on each `to` Element, dependency is not in the distributed artifact, but assumed to be provided, during a LifecycleScopeType period." ;
	linkml:meaning "spdx_core:RelationshipType/hasProvidedDependency"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/hasRequirement> linkml:description "The `from` Element has a requirement on each `to` Element, during a LifecycleScopeType period." ;
	linkml:meaning "spdx_core:RelationshipType/hasRequirement"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/hasSensitivePersonalInformation> OIO:inSubset <https://w3id.org/lmodel/spdx/spdx_dataset> ;
	a linkml:SlotDefinition ;
	rdfs:seeAlso "https://spdx.github.io/spdx-spec/v3.0.1/model/Dataset/Properties/hasSensitivePersonalInformation/"^^xsd:anyURI ;
