	linkml:range <https://w3id.org/lmodel/spdx/SsvcDecisionType> ;
	linkml:required true ;
	linkml:slot_uri "https://spdx.org/rdf/3.0.1/terms/Security/decisionType"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/definingArtifact> OIO:inSubset <https://w3id.org/lmodel/spdx/spdx_core> ;
	a linkml:SlotDefinition ;
	rdfs:seeAlso "https://spdx.github.io/spdx-spec/v3.0.1/model/Core/Properties/definingArtifact/"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/spdx/spdx_core"^^xsd:anyURI ;
	skos:mappingRelation "https://spdx.org/rdf/3.0.1/terms/Core/definingArtifact"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/spdx/definingArtifact"^^xsd:anyURI ;
	linkml:description "Artifact representing a serialization instance of SPDX data containing the definition of a particular Element." ;
	linkml:domain_of <https://w3id.org/lmodel/spdx/ExternalMap> ;
	linkml:owner <https://w3id.org/lmodel/spdx/ExternalMap> ;
	linkml:range <https://w3id.org/lmodel/spdx/Artifact> ;
	linkml:slot_uri "https://spdx.org/rdf/3.0.1/terms/Core/definingArtifact"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/delegatedTo> linkml:description "The `from` Agent is delegating an action to the Agent of the `to` Relationship (which must be of type invokedBy), during a LifecycleScopeType (e.g. the `to` invokedBy Relationship is being done on behalf of `from`)." ;
	linkml:meaning "spdx_core:RelationshipType/delegatedTo"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/dependsOn> linkml:description "The `from` Element depends on each `to` Element, during a LifecycleScopeType period." ;
	linkml:meaning "spdx_core:RelationshipType/dependsOn"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/deployed> linkml:description "SBOM provides an inventory of software that is present on a system. This may be an assembly of other SBOMs that combines analysis of configuration options, and examination of execution behavior in a (potentially simulated) deployment environment." , "in addition to being supported by the supplier, the software is known to have been deployed and is in use. For a software as a service provider, this implies the software is now available as a service." ;
	linkml:meaning "spdx_core:SupportType/deployed"^^xsd:anyURI , "spdx_software:SbomType/deployed"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/deprecatedVersion> OIO:inSubset <https://w3id.org/lmodel/spdx/spdx_expanded_licensing> ;
	a linkml:SlotDefinition ;
	rdfs:seeAlso "https://spdx.github.io/spdx-spec/v3.0.1/model/ExpandedLicensing/Properties/deprecatedVersion/"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/spdx/spdx_expanded_licensing"^^xsd:anyURI ;
	skos:mappingRelation "https://spdx.org/rdf/3.0.1/terms/ExpandedLicensing/deprecatedVersion"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/spdx/deprecatedVersion"^^xsd:anyURI ;
	linkml:description "Specifies the SPDX License List version in which this license or exception identifier was deprecated." ;
	linkml:domain_of <https://w3id.org/lmodel/spdx/ListedLicense> , <https://w3id.org/lmodel/spdx/ListedLicenseException> ;
	linkml:owner <https://w3id.org/lmodel/spdx/ListedLicenseException> ;
	linkml:range <https://w3id.org/lmodel/spdx/string> ;
	linkml:slot_uri "https://spdx.org/rdf/3.0.1/terms/ExpandedLicensing/deprecatedVersion"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/descendantOf> linkml:description "The `from` Element is a descendant of each `to` Element." ;
	linkml:meaning "spdx_core:RelationshipType/descendantOf"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/describes> linkml:description "The `from` Element describes each `to` Element. To denote the root(s) of a tree of elements in a collection, the rootElement property should be used." ;
	linkml:meaning "spdx_core:RelationshipType/describes"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/description> OIO:inSubset <https://w3id.org/lmodel/spdx/spdx_core> ;
	a linkml:SlotDefinition ;
	rdfs:seeAlso "https://spdx.github.io/spdx-spec/v3.0.1/model/Core/Properties/description/"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/spdx/spdx_core"^^xsd:anyURI ;
	skos:mappingRelation "https://spdx.org/rdf/3.0.1/terms/Core/description"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/spdx/description"^^xsd:anyURI ;
	linkml:description "Provides a detailed description of the Element." ;
	linkml:domain_of <https://w3id.org/lmodel/spdx/Element> ;
	linkml:owner <https://w3id.org/lmodel/spdx/Element> ;
	linkml:range <https://w3id.org/lmodel/spdx/string> ;
	linkml:slot_uri "https://spdx.org/rdf/3.0.1/terms/Core/description"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/design> linkml:description "A relationship has specific context implications during an element's design." , "SBOM of intended, planned software project or product with included components (some of which may not yet exist) for a new software artifact." ;
	linkml:meaning "spdx_core:LifecycleScopeType/design"^^xsd:anyURI , "spdx_software:SbomType/design"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/development> linkml:description "A relationship has specific context implications during development phase of an element." , "the artifact is in active development and is not considered ready for formal support from the supplier." ;
	linkml:meaning "spdx_core:LifecycleScopeType/development"^^xsd:anyURI , "spdx_core:SupportType/development"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/device> linkml:description "The Element refers to a chipset, processor, or electronic board." ;
	linkml:meaning "spdx_software:SoftwarePurpose/device"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/deviceDriver> linkml:description "The Element represents software that controls hardware devices." ;
	linkml:meaning "spdx_software:SoftwarePurpose/deviceDriver"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/directDownload> linkml:description "the dataset is publicly available and can be downloaded directly." ;
	linkml:meaning "spdx_dataset:DatasetAvailabilityType/directDownload"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/directory> linkml:description "The file represents a directory and all content stored in that directory." ;
	linkml:meaning "spdx_software:FileKindType/directory"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/diskImage> linkml:description "The Element refers to a disk image that can be written to a disk, booted in a VM, etc. A disk image typically contains most or all of the components necessary to boot, such as bootloaders, kernels, firmware, userspace, etc." ;
	linkml:meaning "spdx_software:SoftwarePurpose/diskImage"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/documentation> linkml:description "A reference to the documentation for a package." , "The Element is documentation." ;
	linkml:meaning "spdx_core:ExternalRefType/documentation"^^xsd:anyURI , "spdx_software:SoftwarePurpose/documentation"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/doesNotAffect> linkml:description "The `from` Vulnerability has no impact on each `to` Element. The use of the `doesNotAffect` is constrained to `VexNotAffectedVulnAssessmentRelationship` classed relationships." ;
	linkml:meaning "spdx_core:RelationshipType/doesNotAffect"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/domain> OIO:inSubset <https://w3id.org/lmodel/spdx/spdx_ai> ;
