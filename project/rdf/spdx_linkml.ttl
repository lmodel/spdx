	linkml:owner <https://w3id.org/lmodel/spdx/VulnAssessmentRelationship> ;
	linkml:range <https://w3id.org/lmodel/spdx/Agent> ;
	linkml:slot_uri "https://spdx.org/rdf/3.0.1/terms/Core/suppliedBy"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/support> linkml:description "A reference to the software support channel or other support information for a package." , "the artifact has been released, and is supported from the supplier. There is a validUntilDate that can provide additional information about the duration of support." ;
	linkml:meaning "spdx_core:ExternalRefType/support"^^xsd:anyURI , "spdx_core:SupportType/support"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/supportLevel> OIO:inSubset <https://w3id.org/lmodel/spdx/spdx_core> ;
	a linkml:SlotDefinition ;
	rdfs:seeAlso "https://spdx.github.io/spdx-spec/v3.0.1/model/Core/Properties/supportLevel/"^^xsd:anyURI ;
