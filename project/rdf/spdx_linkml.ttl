<https://w3id.org/lmodel/spdx/semver> OIO:inSubset <https://w3id.org/lmodel/spdx/spdx_core> ;
	a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/spdx/spdx_core"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/spdx/Semver"^^xsd:anyURI ;
	linkml:description "A semantic version, such as 3.0.1." ;
	linkml:pattern "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$" ;
	linkml:typeof <https://w3id.org/lmodel/spdx/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
