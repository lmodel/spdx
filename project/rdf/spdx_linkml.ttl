	linkml:range <https://w3id.org/lmodel/spdx/PresenceType> ;
	linkml:slot_uri "https://spdx.org/rdf/3.0.1/terms/Dataset/hasSensitivePersonalInformation"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/hasSpecification> linkml:description "Every `to` Element is a specification for the `from` Element (`from` hasSpecification `to`), during a LifecycleScopeType period." ;
	linkml:meaning "spdx_core:RelationshipType/hasSpecification"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/hasStaticLink> linkml:description "The `from` Element statically links in each `to` Element, during a LifecycleScopeType period." ;
	linkml:meaning "spdx_core:RelationshipType/hasStaticLink"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/hasTest> linkml:description "Every `to` Element is a test artifact for the `from` Element (`from` hasTest `to`), during a LifecycleScopeType period." ;
	linkml:meaning "spdx_core:RelationshipType/hasTest"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/hasTestCase> linkml:description "Every `to` Element is a test case for the `from` Element (`from` hasTestCase `to`)." ;
	linkml:meaning "spdx_core:RelationshipType/hasTestCase"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/hasVariant> linkml:description "Every `to` Element is a variant the `from` Element (`from` hasVariant `to`)." ;
	linkml:meaning "spdx_core:RelationshipType/hasVariant"^^xsd:anyURI .
<https://w3id.org/lmodel/spdx/hashValue> OIO:inSubset <https://w3id.org/lmodel/spdx/spdx_core> ;
	a linkml:SlotDefinition ;
	rdfs:seeAlso "https://spdx.github.io/spdx-spec/v3.0.1/model/Core/Properties/hashValue/"^^xsd:anyURI ;
