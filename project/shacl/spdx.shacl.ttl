software:Package a sh:NodeShape ;
    rdfs:comment """Refers to any unit of content that can be associated with a distribution of
software.""" ;
    sh:closed true ;
    sh:ignoredProperties ( ai:modelDataPreprocessing ai:informationAboutApplication dataset:datasetUpdateMechanism ai:limitation ai:metricDecisionThreshold ai:energyConsumption ai:safetyRiskAssessment dataset:dataCollectionProcess ai:typeOfModel ai:informationAboutTraining dataset:datasetNoise dataset:confidentialityLevel ai:useSensitivePersonalInformation dataset:datasetSize ai:standardCompliance dataset:anonymizationMethodUsed ai:modelExplainability dataset:dataPreprocessing dataset:sensor dataset:hasSensitivePersonalInformation dataset:datasetType ai:autonomyType ai:domain dataset:knownBias rdf:type ai:hyperparameter dataset:datasetAvailability dataset:intendedUse ai:metric ) ;
    sh:property [ sh:datatype xsd:dateTime ;
            sh:description "Specifies the time an artifact was built." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path core:builtTime ;
            sh:pattern "^\\d\\d\\d\\d-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$" ],
        [ sh:class core:ExternalIdentifier ;
            sh:description """Provides a reference to a resource outside the scope of SPDX-3.0 content
that uniquely identifies an Element.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path core:externalIdentifier ],
        [ sh:datatype xsd:anyURI ;
            sh:description """Identifies the download Uniform Resource Identifier for the package at the time
that the document was created.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path software:downloadLocation ],
        [ sh:description "Provides additional purpose information of the software artifact." ;
            sh:or ( [ sh:in ( <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/application> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/archive> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/bom> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/configuration> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/container> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/data> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/device> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/deviceDriver> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/diskImage> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/documentation> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/evidence> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/executable> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/file> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/filesystemImage> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/firmware> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/framework> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/install> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/library> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/manifest> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/model> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/module> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/operatingSystem> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/other> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/patch> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/platform> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/requirement> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/source> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/specification> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/test> ) ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 7 ;
            sh:path software:additionalPurpose ],
        [ sh:class core:Agent ;
            sh:description "Identifies from where or whom the Element originally came." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path core:originatedBy ],
        [ sh:class core:CreationInfo ;
            sh:description "Provides information about the creation of the Element." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 25 ;
            sh:path core:creationInfo ],
        [ sh:datatype xsd:anyURI ;
            sh:description """Provides a place for the SPDX data creator to record the package URL string
(in accordance with the Package URL specification) for a software Package.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path software:packageUrl ],
        [ sh:description "Specifies the level of support associated with an artifact." ;
            sh:in ( <https://spdx.org/rdf/3.0.1/terms/Core/SupportType/deployed> <https://spdx.org/rdf/3.0.1/terms/Core/SupportType/development> <https://spdx.org/rdf/3.0.1/terms/Core/SupportType/endOfSupport> <https://spdx.org/rdf/3.0.1/terms/Core/SupportType/limitedSupport> <https://spdx.org/rdf/3.0.1/terms/Core/SupportType/noAssertion> <https://spdx.org/rdf/3.0.1/terms/Core/SupportType/noSupport> <https://spdx.org/rdf/3.0.1/terms/Core/SupportType/support> ) ;
            sh:order 13 ;
            sh:path core:supportLevel ],
        [ sh:class core:IntegrityMethod ;
            sh:description """Provides an IntegrityMethod with which the integrity of an Element can be
asserted.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 22 ;
            sh:path core:verifiedUsing ],
        [ sh:datatype xsd:string ;
            sh:description "Identify the version of a package." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path software:packageVersion ],
        [ sh:datatype xsd:string ;
            sh:description """Records any relevant background information or additional comments
about the origin of the package.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path software:sourceInfo ],
        [ sh:datatype xsd:string ;
            sh:description """Provide consumers with comments by the creator of the Element about the
Element.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path core:comment ],
        [ sh:class core:Agent ;
            sh:description """Identifies who or what supplied the artifact or VulnAssessmentRelationship
referenced by the Element.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path core:suppliedBy ],
        [ sh:datatype xsd:string ;
            sh:description """Identifies the text of one or more copyright notices for a software Package,
File or Snippet, if any.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path software:copyrightText ],
        [ sh:datatype xsd:anyURI ;
            sh:description """A place for the SPDX document creator to record a website that serves as the
package's home page.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path software:homePage ],
        [ sh:description "Provides information about the primary purpose of the software artifact." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:in ( <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/application> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/archive> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/bom> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/configuration> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/container> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/data> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/device> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/deviceDriver> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/diskImage> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/documentation> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/evidence> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/executable> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/file> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/filesystemImage> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/firmware> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/framework> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/install> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/library> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/manifest> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/model> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/module> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/operatingSystem> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/other> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/patch> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/platform> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/requirement> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/source> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/specification> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/test> ) ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 6 ;
            sh:path software:primaryPurpose ],
        [ sh:class core:ExternalRef ;
            sh:description """Points to a resource outside the scope of the SPDX-3.0 content
that provides additional characteristics of an Element.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 23 ;
            sh:path core:externalRef ],
        [ sh:class software:ContentIdentifier ;
            sh:description """A canonical, unique, immutable identifier of the artifact content, that may be
used for verifying its identity and/or integrity.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path software:contentIdentifier ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Specifies the time an artifact was released." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path core:releaseTime ;
            sh:pattern "^\\d\\d\\d\\d-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$" ],
        [ sh:datatype xsd:string ;
            sh:description """Provides a place for the SPDX data creator to record acknowledgement text for
a software Package, File or Snippet.""" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path software:attributionText ],
        [ sh:datatype xsd:dateTime ;
            sh:description """Specifies until when the artifact can be used before its usage needs to be
reassessed.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path core:validUntilTime ;
            sh:pattern "^\\d\\d\\d\\d-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$" ],
        [ sh:class extension:Extension ;
            sh:description "Specifies an Extension characterization of some aspect of an Element." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 18 ;
            sh:path core:extension ],
        [ sh:datatype xsd:string ;
            sh:description "The name of a relevant standard that may apply to an artifact." ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path core:standardName ],
        [ sh:datatype xsd:string ;
            sh:description "A short description of an Element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path core:summary ],
        [ sh:datatype xsd:string ;
            sh:description "Provides a detailed description of the Element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path core:description ],
        [ sh:datatype xsd:string ;
            sh:description "Identifies the name of an Element as designated by the creator." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path core:name ] ;
    sh:targetClass software:Package .

software:Sbom a sh:NodeShape ;
    rdfs:comment "A collection of SPDX Elements describing a single package." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class core:Element ;
            sh:description "Refers to one or more Elements that are part of an ElementCollection." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path core:element ],
        [ sh:class core:IntegrityMethod ;
            sh:description """Provides an IntegrityMethod with which the integrity of an Element can be
asserted.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path core:verifiedUsing ],
        [ sh:datatype xsd:string ;
            sh:description """Gives information about the circumstances or unifying properties
that Elements of the bundle have been assembled under.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path core:context ],
        [ sh:description """Describes one a profile which the creator of this ElementCollection intends to
conform to.""" ;
            sh:in ( <https://spdx.org/rdf/3.0.1/terms/Core/ProfileIdentifierType/ai> <https://spdx.org/rdf/3.0.1/terms/Core/ProfileIdentifierType/build> <https://spdx.org/rdf/3.0.1/terms/Core/ProfileIdentifierType/core> <https://spdx.org/rdf/3.0.1/terms/Core/ProfileIdentifierType/dataset> <https://spdx.org/rdf/3.0.1/terms/Core/ProfileIdentifierType/expandedLicensing> <https://spdx.org/rdf/3.0.1/terms/Core/ProfileIdentifierType/extension> <https://spdx.org/rdf/3.0.1/terms/Core/ProfileIdentifierType/lite> <https://spdx.org/rdf/3.0.1/terms/Core/ProfileIdentifierType/security> <https://spdx.org/rdf/3.0.1/terms/Core/ProfileIdentifierType/simpleLicensing> <https://spdx.org/rdf/3.0.1/terms/Core/ProfileIdentifierType/software> ) ;
            sh:order 3 ;
            sh:path core:profileConformance ],
        [ sh:datatype xsd:string ;
            sh:description "Provides a detailed description of the Element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path core:description ],
        [ sh:class extension:Extension ;
            sh:description "Specifies an Extension characterization of some aspect of an Element." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path core:extension ],
        [ sh:datatype xsd:string ;
            sh:description """Provide consumers with comments by the creator of the Element about the
Element.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path core:comment ],
        [ sh:datatype xsd:string ;
            sh:description "A short description of an Element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path core:summary ],
        [ sh:description "Provides information about the type of an SBOM." ;
            sh:in ( <https://spdx.org/rdf/3.0.1/terms/Software/SbomType/analyzed> <https://spdx.org/rdf/3.0.1/terms/Software/SbomType/build> <https://spdx.org/rdf/3.0.1/terms/Software/SbomType/deployed> <https://spdx.org/rdf/3.0.1/terms/Software/SbomType/design> <https://spdx.org/rdf/3.0.1/terms/Software/SbomType/runtime> <https://spdx.org/rdf/3.0.1/terms/Software/SbomType/source> ) ;
            sh:order 0 ;
            sh:path software:sbomType ],
        [ sh:class core:ExternalRef ;
            sh:description """Points to a resource outside the scope of the SPDX-3.0 content
that provides additional characteristics of an Element.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path core:externalRef ],
        [ sh:class core:CreationInfo ;
            sh:description "Provides information about the creation of the Element." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path core:creationInfo ],
        [ sh:class core:ExternalIdentifier ;
            sh:description """Provides a reference to a resource outside the scope of SPDX-3.0 content
that uniquely identifies an Element.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path core:externalIdentifier ],
        [ sh:datatype xsd:string ;
            sh:description "Identifies the name of an Element as designated by the creator." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path core:name ],
        [ sh:class core:Element ;
            sh:description "This property is used to denote the root Element(s) of a tree of elements contained in a BOM." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path core:rootElement ] ;
    sh:targetClass software:Sbom .

software:Snippet a sh:NodeShape ;
    rdfs:comment "Describes a certain part of a file." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class core:Agent ;
            sh:description "Identifies from where or whom the Element originally came." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path core:originatedBy ],
        [ sh:class core:IntegrityMethod ;
            sh:description """Provides an IntegrityMethod with which the integrity of an Element can be
asserted.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 20 ;
            sh:path core:verifiedUsing ],
        [ sh:class core:ExternalIdentifier ;
            sh:description """Provides a reference to a resource outside the scope of SPDX-3.0 content
that uniquely identifies an Element.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path core:externalIdentifier ],
        [ sh:class core:CreationInfo ;
            sh:description "Provides information about the creation of the Element." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 23 ;
            sh:path core:creationInfo ],
        [ sh:description "Specifies the level of support associated with an artifact." ;
            sh:in ( <https://spdx.org/rdf/3.0.1/terms/Core/SupportType/deployed> <https://spdx.org/rdf/3.0.1/terms/Core/SupportType/development> <https://spdx.org/rdf/3.0.1/terms/Core/SupportType/endOfSupport> <https://spdx.org/rdf/3.0.1/terms/Core/SupportType/limitedSupport> <https://spdx.org/rdf/3.0.1/terms/Core/SupportType/noAssertion> <https://spdx.org/rdf/3.0.1/terms/Core/SupportType/noSupport> <https://spdx.org/rdf/3.0.1/terms/Core/SupportType/support> ) ;
            sh:order 11 ;
            sh:path core:supportLevel ],
        [ sh:datatype xsd:string ;
            sh:description "Provides a detailed description of the Element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path core:description ],
        [ sh:class software:File ;
            sh:description "Defines the original host file that the snippet information applies to." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path software:snippetFromFile ],
        [ sh:datatype xsd:dateTime ;
            sh:description """Specifies until when the artifact can be used before its usage needs to be
reassessed.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path core:validUntilTime ;
            sh:pattern "^\\d\\d\\d\\d-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$" ],
        [ sh:class core:PositiveIntegerRange ;
            sh:description """Defines the line range in the original host file that the snippet information
applies to.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path software:lineRange ],
        [ sh:datatype xsd:string ;
            sh:description """Provide consumers with comments by the creator of the Element about the
Element.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path core:comment ],
        [ sh:datatype xsd:string ;
            sh:description "The name of a relevant standard that may apply to an artifact." ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path core:standardName ],
        [ sh:datatype xsd:string ;
            sh:description """Identifies the text of one or more copyright notices for a software Package,
File or Snippet, if any.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path software:copyrightText ],
        [ sh:datatype xsd:string ;
            sh:description """Provides a place for the SPDX data creator to record acknowledgement text for
a software Package, File or Snippet.""" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path software:attributionText ],
        [ sh:class core:ExternalRef ;
            sh:description """Points to a resource outside the scope of the SPDX-3.0 content
that provides additional characteristics of an Element.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 21 ;
            sh:path core:externalRef ],
        [ sh:description "Provides information about the primary purpose of the software artifact." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:in ( <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/application> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/archive> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/bom> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/configuration> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/container> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/data> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/device> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/deviceDriver> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/diskImage> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/documentation> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/evidence> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/executable> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/file> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/filesystemImage> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/firmware> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/framework> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/install> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/library> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/manifest> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/model> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/module> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/operatingSystem> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/other> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/patch> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/platform> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/requirement> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/source> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/specification> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/test> ) ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 4 ;
            sh:path software:primaryPurpose ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Specifies the time an artifact was built." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path core:builtTime ;
            sh:pattern "^\\d\\d\\d\\d-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$" ],
        [ sh:class software:ContentIdentifier ;
            sh:description """A canonical, unique, immutable identifier of the artifact content, that may be
used for verifying its identity and/or integrity.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path software:contentIdentifier ],
        [ sh:datatype xsd:string ;
            sh:description "A short description of an Element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path core:summary ],
        [ sh:description "Provides additional purpose information of the software artifact." ;
            sh:or ( [ sh:in ( <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/application> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/archive> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/bom> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/configuration> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/container> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/data> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/device> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/deviceDriver> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/diskImage> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/documentation> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/evidence> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/executable> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/file> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/filesystemImage> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/firmware> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/framework> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/install> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/library> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/manifest> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/model> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/module> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/operatingSystem> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/other> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/patch> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/platform> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/requirement> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/source> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/specification> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/test> ) ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 5 ;
            sh:path software:additionalPurpose ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Specifies the time an artifact was released." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path core:releaseTime ;
            sh:pattern "^\\d\\d\\d\\d-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$" ],
        [ sh:class extension:Extension ;
            sh:description "Specifies an Extension characterization of some aspect of an Element." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 16 ;
            sh:path core:extension ],
        [ sh:class core:Agent ;
            sh:description """Identifies who or what supplied the artifact or VulnAssessmentRelationship
referenced by the Element.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path core:suppliedBy ],
        [ sh:class core:PositiveIntegerRange ;
            sh:description """Defines the byte range in the original host file that the snippet information
applies to.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path software:byteRange ],
        [ sh:datatype xsd:string ;
            sh:description "Identifies the name of an Element as designated by the creator." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path core:name ] ;
    sh:targetClass software:Snippet .

ai:EnergyConsumption a sh:NodeShape ;
    rdfs:comment """A class for describing the energy consumption incurred by an AI model in
different stages of its lifecycle.""" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class ai:EnergyConsumptionDescription ;
            sh:description """Specifies the amount of energy consumed when training the AI model that is
being used in the AI system.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path ai:trainingEnergyConsumption ],
        [ sh:class ai:EnergyConsumptionDescription ;
            sh:description """Specifies the amount of energy consumed during inference time by an AI model
that is being used in the AI system.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path ai:inferenceEnergyConsumption ],
        [ sh:class ai:EnergyConsumptionDescription ;
            sh:description """Specifies the amount of energy consumed when finetuning the AI model that is
being used in the AI system.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path ai:finetuningEnergyConsumption ] ;
    sh:targetClass ai:EnergyConsumption .

core:Artifact a sh:NodeShape ;
    rdfs:comment "A distinct article or unit within the digital domain." ;
    sh:closed false ;
    sh:ignoredProperties ( ai:modelDataPreprocessing software:attributionText ai:informationAboutApplication software:packageVersion dataset:datasetUpdateMechanism ai:limitation software:contentIdentifier ai:metricDecisionThreshold ai:energyConsumption ai:safetyRiskAssessment software:lineRange dataset:dataCollectionProcess ai:typeOfModel software:homePage software:copyrightText software:downloadLocation ai:informationAboutTraining security:modifiedTime security:publishedTime software:additionalPurpose dataset:datasetNoise dataset:confidentialityLevel ai:useSensitivePersonalInformation software:sourceInfo software:primaryPurpose dataset:datasetSize ai:standardCompliance dataset:anonymizationMethodUsed ai:modelExplainability dataset:dataPreprocessing security:withdrawnTime software:snippetFromFile software:fileKind dataset:sensor dataset:hasSensitivePersonalInformation dataset:datasetType software:byteRange ai:autonomyType core:contentType software:packageUrl ai:domain dataset:knownBias rdf:type ai:hyperparameter dataset:datasetAvailability dataset:intendedUse ai:metric ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Identifies the name of an Element as designated by the creator." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path core:name ],
        [ sh:class core:Agent ;
            sh:description """Identifies who or what supplied the artifact or VulnAssessmentRelationship
referenced by the Element.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path core:suppliedBy ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Specifies the time an artifact was built." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path core:builtTime ;
            sh:pattern "^\\d\\d\\d\\d-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$" ],
        [ sh:class core:ExternalIdentifier ;
            sh:description """Provides a reference to a resource outside the scope of SPDX-3.0 content
that uniquely identifies an Element.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path core:externalIdentifier ],
        [ sh:datatype xsd:string ;
            sh:description """Provide consumers with comments by the creator of the Element about the
Element.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path core:comment ],
        [ sh:class core:ExternalRef ;
            sh:description """Points to a resource outside the scope of the SPDX-3.0 content
that provides additional characteristics of an Element.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path core:externalRef ],
        [ sh:datatype xsd:dateTime ;
            sh:description """Specifies until when the artifact can be used before its usage needs to be
reassessed.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path core:validUntilTime ;
            sh:pattern "^\\d\\d\\d\\d-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$" ],
        [ sh:description "Specifies the level of support associated with an artifact." ;
            sh:in ( <https://spdx.org/rdf/3.0.1/terms/Core/SupportType/deployed> <https://spdx.org/rdf/3.0.1/terms/Core/SupportType/development> <https://spdx.org/rdf/3.0.1/terms/Core/SupportType/endOfSupport> <https://spdx.org/rdf/3.0.1/terms/Core/SupportType/limitedSupport> <https://spdx.org/rdf/3.0.1/terms/Core/SupportType/noAssertion> <https://spdx.org/rdf/3.0.1/terms/Core/SupportType/noSupport> <https://spdx.org/rdf/3.0.1/terms/Core/SupportType/support> ) ;
            sh:order 3 ;
            sh:path core:supportLevel ],
        [ sh:class extension:Extension ;
            sh:description "Specifies an Extension characterization of some aspect of an Element." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path core:extension ],
        [ sh:datatype xsd:string ;
            sh:description "A short description of an Element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path core:summary ],
        [ sh:class core:Agent ;
            sh:description "Identifies from where or whom the Element originally came." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path core:originatedBy ],
        [ sh:class core:IntegrityMethod ;
            sh:description """Provides an IntegrityMethod with which the integrity of an Element can be
asserted.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path core:verifiedUsing ],
        [ sh:datatype xsd:string ;
            sh:description "Provides a detailed description of the Element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path core:description ],
        [ sh:datatype xsd:string ;
            sh:description "The name of a relevant standard that may apply to an artifact." ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path core:standardName ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Specifies the time an artifact was released." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path core:releaseTime ;
            sh:pattern "^\\d\\d\\d\\d-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$" ],
        [ sh:class core:CreationInfo ;
            sh:description "Provides information about the creation of the Element." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path core:creationInfo ] ;
    sh:targetClass core:Artifact .

core:ExternalMap a sh:NodeShape ;
    rdfs:comment """A map of Element identifiers that are used within an SpdxDocument but defined
external to that SpdxDocument.""" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class core:Artifact ;
            sh:description """Artifact representing a serialization instance of SPDX data containing the
definition of a particular Element.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path core:definingArtifact ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Provides an indication of where to retrieve an external Element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path core:locationHint ],
        [ sh:class core:IntegrityMethod ;
            sh:description """Provides an IntegrityMethod with which the integrity of an Element can be
asserted.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path core:verifiedUsing ],
        [ sh:datatype xsd:anyURI ;
            sh:description """Identifies an external Element used within an SpdxDocument but defined
external to that SpdxDocument.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path core:externalSpdxId ] ;
    sh:targetClass core:ExternalMap .

core:Hash a sh:NodeShape ;
    rdfs:comment "A mathematically calculated representation of a grouping of data." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The result of applying a hash algorithm to an Element." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path core:hashValue ],
        [ sh:datatype xsd:string ;
            sh:description """Provide consumers with comments by the creator of the Element about the
Element.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path core:comment ],
        [ sh:description "Specifies the algorithm used for calculating the hash value." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:or ( [ sh:in ( <https://spdx.org/rdf/3.0.1/terms/Core/HashAlgorithm/adler32> <https://spdx.org/rdf/3.0.1/terms/Core/HashAlgorithm/blake2b256> <https://spdx.org/rdf/3.0.1/terms/Core/HashAlgorithm/blake2b384> <https://spdx.org/rdf/3.0.1/terms/Core/HashAlgorithm/blake2b512> <https://spdx.org/rdf/3.0.1/terms/Core/HashAlgorithm/blake3> <https://spdx.org/rdf/3.0.1/terms/Core/HashAlgorithm/crystalsDilithium> <https://spdx.org/rdf/3.0.1/terms/Core/HashAlgorithm/crystalsKyber> <https://spdx.org/rdf/3.0.1/terms/Core/HashAlgorithm/falcon> <https://spdx.org/rdf/3.0.1/terms/Core/HashAlgorithm/md2> <https://spdx.org/rdf/3.0.1/terms/Core/HashAlgorithm/md4> <https://spdx.org/rdf/3.0.1/terms/Core/HashAlgorithm/md5> <https://spdx.org/rdf/3.0.1/terms/Core/HashAlgorithm/md6> <https://spdx.org/rdf/3.0.1/terms/Core/HashAlgorithm/other> <https://spdx.org/rdf/3.0.1/terms/Core/HashAlgorithm/sha1> <https://spdx.org/rdf/3.0.1/terms/Core/HashAlgorithm/sha224> <https://spdx.org/rdf/3.0.1/terms/Core/HashAlgorithm/sha256> <https://spdx.org/rdf/3.0.1/terms/Core/HashAlgorithm/sha384> <https://spdx.org/rdf/3.0.1/terms/Core/HashAlgorithm/sha3_224> <https://spdx.org/rdf/3.0.1/terms/Core/HashAlgorithm/sha3_256> <https://spdx.org/rdf/3.0.1/terms/Core/HashAlgorithm/sha3_384> <https://spdx.org/rdf/3.0.1/terms/Core/HashAlgorithm/sha3_512> <https://spdx.org/rdf/3.0.1/terms/Core/HashAlgorithm/sha512> ) ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 0 ;
            sh:path core:algorithm ] ;
    sh:targetClass core:Hash .

core:NamespaceMap a sh:NodeShape ;
    rdfs:comment "A mapping between prefixes and namespace partial URIs." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A substitute for a URI." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path core:prefix ],
        [ sh:datatype xsd:anyURI ;
            sh:description """Provides an unambiguous mechanism for conveying a URI fragment portion of an
Element ID.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path core:namespace ] ;
    sh:targetClass core:NamespaceMap .

