            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path security:actionStatementTime ;
            sh:pattern "^\\d\\d\\d\\d-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$" ],
        [ sh:datatype xsd:string ;
            sh:description "A short description of an Element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path core:summary ],
        [ sh:class software:SoftwareArtifact ;
            sh:description """Specifies an Element contained in a piece of software where a vulnerability was
found.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path security:assessedElement ],
        [ sh:datatype xsd:string ;
            sh:description "Specifies the version of a VEX statement." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path security:vexVersion ],
        [ sh:class core:Element ;
            sh:description "References the Element on the left-hand side of a relationship." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path core:from ],
        [ sh:class core:ExternalRef ;
            sh:description """Points to a resource outside the scope of the SPDX-3.0 content
