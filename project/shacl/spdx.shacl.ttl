security:VexNotAffectedVulnAssessmentRelationship a sh:NodeShape ;
    rdfs:comment """Links a vulnerability and one or more elements designating the latter as products
not affected by the vulnerability.""" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:dateTime ;
            sh:description "Timestamp of impact statement." ;
            sh:maxCount 1 ;
