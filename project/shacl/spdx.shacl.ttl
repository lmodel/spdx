            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path security:modifiedTime ;
            sh:pattern "^\\d\\d\\d\\d-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$" ],
        [ sh:datatype xsd:string ;
            sh:description "Provides a detailed description of the Element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path core:description ],
        [ sh:datatype xsd:string ;
            sh:description "Specifies the CVSS vector string for a vulnerability." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path security:vectorString ],
        [ sh:class core:IntegrityMethod ;
            sh:description """Provides an IntegrityMethod with which the integrity of an Element can be
asserted.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 19 ;
            sh:path core:verifiedUsing ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Specifies the time from which an element is applicable / valid." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path core:startTime ;
            sh:pattern "^\\d\\d\\d\\d-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$" ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Specifies the time when a vulnerability was published." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path security:publishedTime ;
            sh:pattern "^\\d\\d\\d\\d-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$" ],
        [ sh:class core:Element ;
            sh:description "References the Element on the left-hand side of a relationship." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path core:from ],
        [ sh:description "Provides information about the completeness of relationships." ;
            sh:in ( <https://spdx.org/rdf/3.0.1/terms/Core/RelationshipCompleteness/complete> <https://spdx.org/rdf/3.0.1/terms/Core/RelationshipCompleteness/incomplete> <https://spdx.org/rdf/3.0.1/terms/Core/RelationshipCompleteness/noAssertion> ) ;
            sh:maxCount 1 ;
            sh:order 9 ;
            sh:path core:completeness ],
        [ sh:class core:Agent ;
            sh:description """Identifies who or what supplied the artifact or VulnAssessmentRelationship
referenced by the Element.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path core:suppliedBy ],
        [ sh:class core:ExternalIdentifier ;
            sh:description """Provides a reference to a resource outside the scope of SPDX-3.0 content
that uniquely identifies an Element.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path core:externalIdentifier ],
        [ sh:class core:CreationInfo ;
            sh:description "Provides information about the creation of the Element." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 22 ;
            sh:path core:creationInfo ],
        [ sh:class software:SoftwareArtifact ;
            sh:description """Specifies an Element contained in a piece of software where a vulnerability was
found.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path security:assessedElement ],
        [ sh:datatype xsd:decimal ;
