            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path core:extension ],
        [ sh:description "Capture the scope of information about a specific relationship between elements." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:in ( <https://spdx.org/rdf/3.0.1/terms/Core/LifecycleScopeType/build> <https://spdx.org/rdf/3.0.1/terms/Core/LifecycleScopeType/design> <https://spdx.org/rdf/3.0.1/terms/Core/LifecycleScopeType/development> <https://spdx.org/rdf/3.0.1/terms/Core/LifecycleScopeType/other> <https://spdx.org/rdf/3.0.1/terms/Core/LifecycleScopeType/runtime> <https://spdx.org/rdf/3.0.1/terms/Core/LifecycleScopeType/test> ) ] [ sh:datatype xsd:string ;
