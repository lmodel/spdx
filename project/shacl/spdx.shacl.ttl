        [ sh:datatype xsd:string ;
            sh:description "Identifies the name of an Element as designated by the creator." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path core:name ],
        [ sh:datatype xsd:string ;
            sh:description "A short description of an Element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path core:summary ],
        [ sh:description "Specifies the CVSS qualitative severity rating of a vulnerability in relation to a piece of software." ;
            sh:in ( <https://spdx.org/rdf/3.0.1/terms/Security/CvssSeverityType/critical> <https://spdx.org/rdf/3.0.1/terms/Security/CvssSeverityType/high> <https://spdx.org/rdf/3.0.1/terms/Security/CvssSeverityType/low> <https://spdx.org/rdf/3.0.1/terms/Security/CvssSeverityType/medium> <https://spdx.org/rdf/3.0.1/terms/Security/CvssSeverityType/none> ) ;
            sh:maxCount 1 ;
