        [ sh:description "Provides information about the primary purpose of the software artifact." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:in ( <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/application> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/archive> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/bom> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/configuration> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/container> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/data> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/device> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/deviceDriver> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/diskImage> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/documentation> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/evidence> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/executable> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/file> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/filesystemImage> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/firmware> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/framework> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/install> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/library> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/manifest> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/model> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/module> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/operatingSystem> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/other> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/patch> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/platform> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/requirement> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/source> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/specification> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/test> ) ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 19 ;
            sh:path software:primaryPurpose ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Specifies the time an artifact was released." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 29 ;
            sh:path core:releaseTime ;
            sh:pattern "^\\d\\d\\d\\d-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$" ],
        [ sh:datatype xsd:string ;
            sh:description "Provides a detailed description of the Element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 33 ;
            sh:path core:description ],
        [ sh:description "Specifies the level of support associated with an artifact." ;
            sh:in ( <https://spdx.org/rdf/3.0.1/terms/Core/SupportType/deployed> <https://spdx.org/rdf/3.0.1/terms/Core/SupportType/development> <https://spdx.org/rdf/3.0.1/terms/Core/SupportType/endOfSupport> <https://spdx.org/rdf/3.0.1/terms/Core/SupportType/limitedSupport> <https://spdx.org/rdf/3.0.1/terms/Core/SupportType/noAssertion> <https://spdx.org/rdf/3.0.1/terms/Core/SupportType/noSupport> <https://spdx.org/rdf/3.0.1/terms/Core/SupportType/support> ) ;
            sh:order 26 ;
            sh:path core:supportLevel ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Specifies the time an artifact was built." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path core:builtTime ;
            sh:pattern "^\\d\\d\\d\\d-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$" ],
        [ sh:description "The field describes the availability of a dataset." ;
            sh:in ( <https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetAvailabilityType/clickthrough> <https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetAvailabilityType/directDownload> <https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetAvailabilityType/query> <https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetAvailabilityType/registration> <https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetAvailabilityType/scrapingScript> ) ;
            sh:maxCount 1 ;
            sh:order 10 ;
            sh:path dataset:datasetAvailability ],
        [ sh:class core:IntegrityMethod ;
            sh:description """Provides an IntegrityMethod with which the integrity of an Element can be
asserted.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 35 ;
            sh:path core:verifiedUsing ],
        [ sh:datatype xsd:string ;
            sh:description """Provide consumers with comments by the creator of the Element about the
Element.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 34 ;
            sh:path core:comment ],
        [ sh:datatype xsd:string ;
            sh:description "Describes the anonymization methods used." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dataset:anonymizationMethodUsed ],
        [ sh:datatype xsd:string ;
            sh:description """Records any relevant background information or additional comments
about the origin of the package.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path software:sourceInfo ],
        [ sh:datatype xsd:string ;
            sh:description """Identifies the text of one or more copyright notices for a software Package,
File or Snippet, if any.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path software:copyrightText ],
        [ sh:class core:ExternalRef ;
            sh:description """Points to a resource outside the scope of the SPDX-3.0 content
that provides additional characteristics of an Element.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 36 ;
            sh:path core:externalRef ],
        [ sh:datatype xsd:anyURI ;
            sh:description """A place for the SPDX document creator to record a website that serves as the
package's home page.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path software:homePage ],
        [ sh:datatype xsd:string ;
            sh:description """Provides a place for the SPDX data creator to record acknowledgement text for
a software Package, File or Snippet.""" ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path software:attributionText ],
        [ sh:datatype xsd:string ;
            sh:description "Describes a mechanism to update the dataset." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dataset:datasetUpdateMechanism ],
        [ sh:datatype xsd:anyURI ;
            sh:description """Provides a place for the SPDX data creator to record the package URL string
(in accordance with the Package URL specification) for a software Package.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path software:packageUrl ],
        [ sh:datatype xsd:string ;
            sh:description "Identify the version of a package." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path software:packageVersion ],
        [ sh:datatype xsd:string ;
            sh:description "A short description of an Element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 32 ;
            sh:path core:summary ],
        [ sh:class core:Agent ;
            sh:description """Identifies who or what supplied the artifact or VulnAssessmentRelationship
referenced by the Element.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 27 ;
            sh:path core:suppliedBy ],
        [ sh:datatype xsd:string ;
            sh:description "The name of a relevant standard that may apply to an artifact." ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path core:standardName ],
        [ sh:datatype xsd:string ;
            sh:description "Describes potentially noisy elements of the dataset." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path dataset:datasetNoise ],
        [ sh:datatype xsd:dateTime ;
            sh:description """Specifies until when the artifact can be used before its usage needs to be
reassessed.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 25 ;
            sh:path core:validUntilTime ;
            sh:pattern "^\\d\\d\\d\\d-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$" ],
        [ sh:class core:ExternalIdentifier ;
            sh:description """Provides a reference to a resource outside the scope of SPDX-3.0 content
that uniquely identifies an Element.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 30 ;
            sh:path core:externalIdentifier ],
        [ sh:datatype xsd:string ;
            sh:description "Describes how the dataset was collected." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dataset:dataCollectionProcess ],
        [ sh:datatype xsd:string ;
            sh:description "Records the biases that the dataset is known to encompass." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dataset:knownBias ],
        [ sh:class core:Agent ;
            sh:description "Identifies from where or whom the Element originally came." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 28 ;
            sh:path core:originatedBy ],
        [ sh:datatype xsd:anyURI ;
            sh:description """Identifies the download Uniform Resource Identifier for the package at the time
that the document was created.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path software:downloadLocation ],
        [ sh:description "Describes the confidentiality level of the data points contained in the dataset." ;
            sh:in ( <https://spdx.org/rdf/3.0.1/terms/Dataset/ConfidentialityLevelType/amber> <https://spdx.org/rdf/3.0.1/terms/Dataset/ConfidentialityLevelType/clear> <https://spdx.org/rdf/3.0.1/terms/Dataset/ConfidentialityLevelType/green> <https://spdx.org/rdf/3.0.1/terms/Dataset/ConfidentialityLevelType/red> ) ;
            sh:maxCount 1 ;
            sh:order 9 ;
            sh:path dataset:confidentialityLevel ],
        [ sh:description "Describes the type of the given dataset." ;
            sh:minCount 1 ;
            sh:or ( [ sh:in ( <https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetType/audio> <https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetType/categorical> <https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetType/graph> <https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetType/image> <https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetType/noAssertion> <https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetType/numeric> <https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetType/other> <https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetType/sensor> <https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetType/structured> <https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetType/syntactic> <https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetType/text> <https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetType/timeseries> <https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetType/timestamp> <https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetType/video> ) ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 1 ;
            sh:path dataset:datasetType ],
        [ sh:class core:DictionaryEntry ;
            sh:description "Describes a sensor used for collecting the data." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path dataset:sensor ],
        [ sh:class software:ContentIdentifier ;
            sh:description """A canonical, unique, immutable identifier of the artifact content, that may be
used for verifying its identity and/or integrity.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 21 ;
            sh:path software:contentIdentifier ],
        [ sh:datatype xsd:string ;
            sh:description "Describes the preprocessing steps that were applied to the raw data to create the given dataset." ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path dataset:dataPreprocessing ],
        [ sh:description "Provides additional purpose information of the software artifact." ;
            sh:or ( [ sh:in ( <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/application> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/archive> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/bom> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/configuration> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/container> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/data> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/device> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/deviceDriver> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/diskImage> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/documentation> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/evidence> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/executable> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/file> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/filesystemImage> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/firmware> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/framework> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/install> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/library> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/manifest> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/model> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/module> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/operatingSystem> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/other> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/patch> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/platform> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/requirement> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/source> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/specification> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/test> ) ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 20 ;
            sh:path software:additionalPurpose ],
        [ sh:description "Describes if any sensitive personal information is present in the dataset." ;
            sh:in ( <https://spdx.org/rdf/3.0.1/terms/Core/PresenceType/no> <https://spdx.org/rdf/3.0.1/terms/Core/PresenceType/noAssertion> <https://spdx.org/rdf/3.0.1/terms/Core/PresenceType/yes> ) ;
            sh:maxCount 1 ;
            sh:order 11 ;
            sh:path dataset:hasSensitivePersonalInformation ],
        [ sh:datatype xsd:integer ;
            sh:description "Captures the size of the dataset." ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dataset:datasetSize ] ;
    sh:targetClass dataset:DatasetPackage .

expandedlicensing:ConjunctiveLicenseSet a sh:NodeShape ;
    rdfs:comment """Portion of an AnyLicenseInfo representing a set of licensing information
where all elements apply.""" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class core:ExternalRef ;
            sh:description """Points to a resource outside the scope of the SPDX-3.0 content
that provides additional characteristics of an Element.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path core:externalRef ],
        [ sh:datatype xsd:string ;
            sh:description "Identifies the name of an Element as designated by the creator." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path core:name ],
        [ sh:datatype xsd:string ;
            sh:description "A short description of an Element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path core:summary ],
        [ sh:class extension:Extension ;
            sh:description "Specifies an Extension characterization of some aspect of an Element." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path core:extension ],
        [ sh:datatype xsd:string ;
            sh:description "Provides a detailed description of the Element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path core:description ],
        [ sh:class core:IntegrityMethod ;
            sh:description """Provides an IntegrityMethod with which the integrity of an Element can be
asserted.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path core:verifiedUsing ],
        [ sh:datatype xsd:string ;
            sh:description """Provide consumers with comments by the creator of the Element about the
Element.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path core:comment ],
        [ sh:class core:CreationInfo ;
            sh:description "Provides information about the creation of the Element." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path core:creationInfo ],
        [ sh:class core:ExternalIdentifier ;
            sh:description """Provides a reference to a resource outside the scope of SPDX-3.0 content
that uniquely identifies an Element.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path core:externalIdentifier ],
        [ sh:class simplelicensing:AnyLicenseInfo ;
            sh:description "A license expression participating in a license set." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path expandedlicensing:member ] ;
    sh:targetClass expandedlicensing:ConjunctiveLicenseSet .

expandedlicensing:CustomLicense a sh:NodeShape ;
    rdfs:comment "A license that is not listed on the SPDX License List." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A short description of an Element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path core:summary ],
        [ sh:class core:ExternalRef ;
            sh:description """Points to a resource outside the scope of the SPDX-3.0 content
that provides additional characteristics of an Element.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path core:externalRef ],
        [ sh:class core:CreationInfo ;
            sh:description "Provides information about the creation of the Element." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path core:creationInfo ],
        [ sh:datatype xsd:string ;
            sh:description """Specifies the licenseId that is preferred to be used in place of a deprecated
License or LicenseAddition.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path expandedlicensing:obsoletedBy ],
        [ sh:datatype xsd:string ;
            sh:description "Provides a detailed description of the Element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path core:description ],
        [ sh:datatype xsd:boolean ;
            sh:description """Specifies whether a license or additional text identifier has been marked as
deprecated.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path expandedlicensing:isDeprecatedLicenseId ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Contains a URL where the License or LicenseAddition can be found in use." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path expandedlicensing:seeAlso ],
        [ sh:datatype xsd:boolean ;
            sh:description """Specifies whether the License is listed as free by the
Free Software Foundation (FSF).""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path expandedlicensing:isFsfLibre ],
        [ sh:datatype xsd:string ;
            sh:description """Provide consumers with comments by the creator of the Element about the
Element.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path core:comment ],
        [ sh:datatype xsd:string ;
            sh:description """Provides a License author's preferred text to indicate that a file is covered
by the License.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path expandedlicensing:standardLicenseHeader ],
        [ sh:datatype xsd:boolean ;
            sh:description """Specifies whether the License is listed as approved by the
Open Source Initiative (OSI).""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path expandedlicensing:isOsiApproved ],
        [ sh:class core:ExternalIdentifier ;
            sh:description """Provides a reference to a resource outside the scope of SPDX-3.0 content
that uniquely identifies an Element.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path core:externalIdentifier ],
        [ sh:datatype xsd:string ;
            sh:description "Identifies the name of an Element as designated by the creator." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path core:name ],
        [ sh:datatype xsd:string ;
            sh:description "Identifies the full text of a License, in SPDX templating format." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path expandedlicensing:standardLicenseTemplate ],
        [ sh:class core:IntegrityMethod ;
            sh:description """Provides an IntegrityMethod with which the integrity of an Element can be
asserted.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path core:verifiedUsing ],
        [ sh:datatype xsd:string ;
            sh:description "Identifies the full text of a License or Addition." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path simplelicensing:licenseText ],
        [ sh:class extension:Extension ;
            sh:description "Specifies an Extension characterization of some aspect of an Element." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path core:extension ],
        [ sh:datatype xsd:string ;
            sh:description """Identifies all the text and metadata associated with a license in the license
XML format.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path expandedlicensing:licenseXml ] ;
    sh:targetClass expandedlicensing:CustomLicense .

expandedlicensing:CustomLicenseAddition a sh:NodeShape ;
    rdfs:comment "A license addition that is not listed on the SPDX Exceptions List." ;
