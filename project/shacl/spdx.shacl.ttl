extension:CdxPropertyEntry a sh:NodeShape ;
    rdfs:comment "A property name with an associated value." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A value used in a CdxPropertyEntry name-value pair." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path extension:cdxPropValue ],
        [ sh:datatype xsd:string ;
            sh:description "A name used in a CdxPropertyEntry name-value pair." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path extension:cdxPropName ] ;
    sh:targetClass extension:CdxPropertyEntry .

software:File a sh:NodeShape ;
    rdfs:comment "Refers to any object that stores content on a computer." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class software:ContentIdentifier ;
            sh:description """A canonical, unique, immutable identifier of the artifact content, that may be
used for verifying its identity and/or integrity.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path software:contentIdentifier ],
        [ sh:datatype xsd:string ;
            sh:description "Provides information about the content type of an Element or a Property." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path core:contentType ;
            sh:pattern "^[^\\/]+\\/[^\\/]+$" ],
        [ sh:class core:ExternalRef ;
            sh:description """Points to a resource outside the scope of the SPDX-3.0 content
that provides additional characteristics of an Element.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 20 ;
            sh:path core:externalRef ],
        [ sh:datatype xsd:string ;
            sh:description "Provides a detailed description of the Element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path core:description ],
        [ sh:datatype xsd:string ;
            sh:description "A short description of an Element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path core:summary ],
        [ sh:class core:ExternalIdentifier ;
            sh:description """Provides a reference to a resource outside the scope of SPDX-3.0 content
that uniquely identifies an Element.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path core:externalIdentifier ],
        [ sh:datatype xsd:string ;
            sh:description """Identifies the text of one or more copyright notices for a software Package,
File or Snippet, if any.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path software:copyrightText ],
        [ sh:datatype xsd:string ;
            sh:description "The name of a relevant standard that may apply to an artifact." ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path core:standardName ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Specifies the time an artifact was released." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path core:releaseTime ;
            sh:pattern "^\\d\\d\\d\\d-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$" ],
        [ sh:datatype xsd:dateTime ;
            sh:description """Specifies until when the artifact can be used before its usage needs to be
reassessed.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path core:validUntilTime ;
            sh:pattern "^\\d\\d\\d\\d-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$" ],
        [ sh:description "Describes if a given file is a directory or non-directory kind of file." ;
            sh:in ( <https://spdx.org/rdf/3.0.1/terms/Software/FileKindType/directory> <https://spdx.org/rdf/3.0.1/terms/Software/FileKindType/file> ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path software:fileKind ],
        [ sh:class core:CreationInfo ;
            sh:description "Provides information about the creation of the Element." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 22 ;
            sh:path core:creationInfo ],
        [ sh:datatype xsd:string ;
            sh:description """Provide consumers with comments by the creator of the Element about the
Element.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path core:comment ],
        [ sh:datatype xsd:string ;
            sh:description """Provides a place for the SPDX data creator to record acknowledgement text for
a software Package, File or Snippet.""" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path software:attributionText ],
        [ sh:description "Provides information about the primary purpose of the software artifact." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:in ( <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/application> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/archive> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/bom> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/configuration> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/container> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/data> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/device> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/deviceDriver> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/diskImage> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/documentation> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/evidence> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/executable> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/file> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/filesystemImage> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/firmware> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/framework> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/install> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/library> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/manifest> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/model> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/module> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/operatingSystem> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/other> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/patch> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/platform> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/requirement> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/source> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/specification> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/test> ) ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 3 ;
            sh:path software:primaryPurpose ],
        [ sh:class core:Agent ;
            sh:description "Identifies from where or whom the Element originally came." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path core:originatedBy ],
        [ sh:datatype xsd:string ;
            sh:description "Identifies the name of an Element as designated by the creator." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path core:name ],
        [ sh:class core:IntegrityMethod ;
            sh:description """Provides an IntegrityMethod with which the integrity of an Element can be
asserted.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 19 ;
            sh:path core:verifiedUsing ],
        [ sh:class core:Agent ;
            sh:description """Identifies who or what supplied the artifact or VulnAssessmentRelationship
referenced by the Element.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path core:suppliedBy ],
        [ sh:description "Provides additional purpose information of the software artifact." ;
            sh:or ( [ sh:in ( <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/application> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/archive> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/bom> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/configuration> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/container> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/data> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/device> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/deviceDriver> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/diskImage> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/documentation> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/evidence> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/executable> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/file> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/filesystemImage> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/firmware> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/framework> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/install> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/library> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/manifest> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/model> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/module> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/operatingSystem> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/other> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/patch> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/platform> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/requirement> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/source> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/specification> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/test> ) ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 4 ;
            sh:path software:additionalPurpose ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Specifies the time an artifact was built." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path core:builtTime ;
            sh:pattern "^\\d\\d\\d\\d-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$" ],
        [ sh:description "Specifies the level of support associated with an artifact." ;
            sh:in ( <https://spdx.org/rdf/3.0.1/terms/Core/SupportType/deployed> <https://spdx.org/rdf/3.0.1/terms/Core/SupportType/development> <https://spdx.org/rdf/3.0.1/terms/Core/SupportType/endOfSupport> <https://spdx.org/rdf/3.0.1/terms/Core/SupportType/limitedSupport> <https://spdx.org/rdf/3.0.1/terms/Core/SupportType/noAssertion> <https://spdx.org/rdf/3.0.1/terms/Core/SupportType/noSupport> <https://spdx.org/rdf/3.0.1/terms/Core/SupportType/support> ) ;
            sh:order 10 ;
            sh:path core:supportLevel ],
        [ sh:class extension:Extension ;
            sh:description "Specifies an Extension characterization of some aspect of an Element." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path core:extension ] ;
    sh:targetClass software:File .

core:PositiveIntegerRange a sh:NodeShape ;
    rdfs:comment "A tuple of two positive integers that define a range." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "Defines the end of a range." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path core:endIntegerRange ],
        [ sh:datatype xsd:integer ;
            sh:description "Defines the beginning of a range." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path core:beginIntegerRange ] ;
    sh:targetClass core:PositiveIntegerRange .

ai:EnergyConsumptionDescription a sh:NodeShape ;
    rdfs:comment """The class that helps note down the quantity of energy consumption and the unit
used for measurement.""" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:description "Represents the energy quantity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path ai:energyQuantity ],
        [ sh:description "Specifies the unit in which energy is measured." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:or ( [ sh:in ( <https://spdx.org/rdf/3.0.1/terms/AI/EnergyUnitType/kilowattHour> <https://spdx.org/rdf/3.0.1/terms/AI/EnergyUnitType/megajoule> <https://spdx.org/rdf/3.0.1/terms/AI/EnergyUnitType/other> ) ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 1 ;
            sh:path ai:energyUnit ] ;
    sh:targetClass ai:EnergyConsumptionDescription .

simplelicensing:AnyLicenseInfo a sh:NodeShape ;
    rdfs:comment "Abstract class representing a license combination consisting of one or more licenses." ;
    sh:closed false ;
    sh:ignoredProperties ( expandedlicensing:subjectExtendableLicense expandedlicensing:isFsfLibre expandedlicensing:isOsiApproved expandedlicensing:seeAlso simplelicensing:licenseListVersion expandedlicensing:subjectLicense expandedlicensing:isDeprecatedLicenseId expandedlicensing:deprecatedVersion expandedlicensing:obsoletedBy expandedlicensing:standardLicenseTemplate expandedlicensing:standardLicenseHeader expandedlicensing:licenseXml expandedlicensing:listVersionAdded simplelicensing:licenseExpression expandedlicensing:member expandedlicensing:subjectAddition simplelicensing:customIdToUri rdf:type simplelicensing:licenseText ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Provide consumers with comments by the creator of the Element about the
Element.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path core:comment ],
        [ sh:class core:CreationInfo ;
            sh:description "Provides information about the creation of the Element." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path core:creationInfo ],
        [ sh:class extension:Extension ;
            sh:description "Specifies an Extension characterization of some aspect of an Element." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path core:extension ],
        [ sh:class core:ExternalRef ;
            sh:description """Points to a resource outside the scope of the SPDX-3.0 content
that provides additional characteristics of an Element.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path core:externalRef ],
        [ sh:class core:IntegrityMethod ;
            sh:description """Provides an IntegrityMethod with which the integrity of an Element can be
asserted.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path core:verifiedUsing ],
        [ sh:class core:ExternalIdentifier ;
            sh:description """Provides a reference to a resource outside the scope of SPDX-3.0 content
that uniquely identifies an Element.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path core:externalIdentifier ],
        [ sh:datatype xsd:string ;
            sh:description "A short description of an Element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path core:summary ],
        [ sh:datatype xsd:string ;
            sh:description "Provides a detailed description of the Element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path core:description ],
        [ sh:datatype xsd:string ;
            sh:description "Identifies the name of an Element as designated by the creator." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path core:name ] ;
    sh:targetClass simplelicensing:AnyLicenseInfo .

software:ContentIdentifier a sh:NodeShape ;
    rdfs:comment "A canonical, unique, immutable identifier" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Provide consumers with comments by the creator of the Element about the
Element.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path core:comment ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Specifies the value of the content identifier." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path software:contentIdentifierValue ],
        [ sh:description "Specifies the type of the content identifier." ;
            sh:in ( <https://spdx.org/rdf/3.0.1/terms/Software/ContentIdentifierType/gitoid> <https://spdx.org/rdf/3.0.1/terms/Software/ContentIdentifierType/swhid> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path software:contentIdentifierType ] ;
    sh:targetClass software:ContentIdentifier .

core:DictionaryEntry a sh:NodeShape ;
    rdfs:comment "A key with an associated value." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A key used in a generic key-value pair." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path core:key ],
        [ sh:datatype xsd:string ;
            sh:description "A value used in a generic key-value pair." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path core:value ] ;
    sh:targetClass core:DictionaryEntry .

software:SoftwareArtifact a sh:NodeShape ;
    rdfs:comment "A distinct article or unit related to Software." ;
    sh:closed false ;
    sh:ignoredProperties ( ai:modelDataPreprocessing ai:informationAboutApplication software:packageVersion dataset:datasetUpdateMechanism ai:limitation ai:metricDecisionThreshold ai:energyConsumption ai:safetyRiskAssessment software:lineRange dataset:dataCollectionProcess ai:typeOfModel software:homePage software:downloadLocation ai:informationAboutTraining dataset:datasetNoise dataset:confidentialityLevel ai:useSensitivePersonalInformation software:sourceInfo dataset:datasetSize ai:standardCompliance dataset:anonymizationMethodUsed ai:modelExplainability dataset:dataPreprocessing software:snippetFromFile software:fileKind dataset:sensor dataset:hasSensitivePersonalInformation dataset:datasetType software:byteRange ai:autonomyType core:contentType software:packageUrl ai:domain dataset:knownBias rdf:type ai:hyperparameter dataset:datasetAvailability dataset:intendedUse ai:metric ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Provides a detailed description of the Element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path core:description ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Specifies the time an artifact was built." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path core:builtTime ;
            sh:pattern "^\\d\\d\\d\\d-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$" ],
        [ sh:datatype xsd:string ;
            sh:description "The name of a relevant standard that may apply to an artifact." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path core:standardName ],
        [ sh:datatype xsd:string ;
            sh:description """Identifies the text of one or more copyright notices for a software Package,
File or Snippet, if any.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path software:copyrightText ],
        [ sh:class software:ContentIdentifier ;
            sh:description """A canonical, unique, immutable identifier of the artifact content, that may be
used for verifying its identity and/or integrity.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path software:contentIdentifier ],
        [ sh:datatype xsd:string ;
            sh:description "A short description of an Element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path core:summary ],
        [ sh:class core:ExternalIdentifier ;
            sh:description """Provides a reference to a resource outside the scope of SPDX-3.0 content
that uniquely identifies an Element.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path core:externalIdentifier ],
        [ sh:class core:ExternalRef ;
            sh:description """Points to a resource outside the scope of the SPDX-3.0 content
that provides additional characteristics of an Element.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 18 ;
            sh:path core:externalRef ],
        [ sh:description "Provides additional purpose information of the software artifact." ;
            sh:or ( [ sh:in ( <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/application> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/archive> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/bom> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/configuration> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/container> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/data> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/device> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/deviceDriver> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/diskImage> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/documentation> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/evidence> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/executable> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/file> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/filesystemImage> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/firmware> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/framework> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/install> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/library> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/manifest> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/model> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/module> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/operatingSystem> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/other> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/patch> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/platform> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/requirement> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/source> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/specification> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/test> ) ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 2 ;
            sh:path software:additionalPurpose ],
        [ sh:description "Provides information about the primary purpose of the software artifact." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:in ( <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/application> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/archive> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/bom> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/configuration> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/container> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/data> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/device> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/deviceDriver> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/diskImage> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/documentation> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/evidence> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/executable> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/file> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/filesystemImage> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/firmware> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/framework> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/install> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/library> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/manifest> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/model> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/module> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/operatingSystem> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/other> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/patch> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/platform> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/requirement> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/source> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/specification> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/test> ) ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 1 ;
            sh:path software:primaryPurpose ],
        [ sh:class extension:Extension ;
            sh:description "Specifies an Extension characterization of some aspect of an Element." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path core:extension ],
        [ sh:datatype xsd:dateTime ;
            sh:description """Specifies until when the artifact can be used before its usage needs to be
reassessed.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path core:validUntilTime ;
            sh:pattern "^\\d\\d\\d\\d-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$" ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Specifies the time an artifact was released." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path core:releaseTime ;
            sh:pattern "^\\d\\d\\d\\d-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$" ],
        [ sh:class core:CreationInfo ;
            sh:description "Provides information about the creation of the Element." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 20 ;
            sh:path core:creationInfo ],
        [ sh:datatype xsd:string ;
            sh:description "Identifies the name of an Element as designated by the creator." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path core:name ],
        [ sh:description "Specifies the level of support associated with an artifact." ;
            sh:in ( <https://spdx.org/rdf/3.0.1/terms/Core/SupportType/deployed> <https://spdx.org/rdf/3.0.1/terms/Core/SupportType/development> <https://spdx.org/rdf/3.0.1/terms/Core/SupportType/endOfSupport> <https://spdx.org/rdf/3.0.1/terms/Core/SupportType/limitedSupport> <https://spdx.org/rdf/3.0.1/terms/Core/SupportType/noAssertion> <https://spdx.org/rdf/3.0.1/terms/Core/SupportType/noSupport> <https://spdx.org/rdf/3.0.1/terms/Core/SupportType/support> ) ;
            sh:order 8 ;
            sh:path core:supportLevel ],
        [ sh:class core:Agent ;
            sh:description "Identifies from where or whom the Element originally came." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path core:originatedBy ],
        [ sh:class core:Agent ;
            sh:description """Identifies who or what supplied the artifact or VulnAssessmentRelationship
referenced by the Element.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path core:suppliedBy ],
        [ sh:class core:IntegrityMethod ;
            sh:description """Provides an IntegrityMethod with which the integrity of an Element can be
asserted.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path core:verifiedUsing ],
        [ sh:datatype xsd:string ;
            sh:description """Provides a place for the SPDX data creator to record acknowledgement text for
a software Package, File or Snippet.""" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path software:attributionText ],
        [ sh:datatype xsd:string ;
            sh:description """Provide consumers with comments by the creator of the Element about the
Element.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path core:comment ] ;
    sh:targetClass software:SoftwareArtifact .

core:Agent a sh:NodeShape ;
    rdfs:comment "Agent represents anything with the potential to act on a system." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class core:ExternalIdentifier ;
            sh:description """Provides a reference to a resource outside the scope of SPDX-3.0 content
that uniquely identifies an Element.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path core:externalIdentifier ],
        [ sh:datatype xsd:string ;
            sh:description """Provide consumers with comments by the creator of the Element about the
Element.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path core:comment ],
        [ sh:datatype xsd:string ;
            sh:description "Provides a detailed description of the Element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path core:description ],
        [ sh:datatype xsd:string ;
            sh:description "Identifies the name of an Element as designated by the creator." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path core:name ],
        [ sh:class extension:Extension ;
            sh:description "Specifies an Extension characterization of some aspect of an Element." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path core:extension ],
        [ sh:class core:IntegrityMethod ;
            sh:description """Provides an IntegrityMethod with which the integrity of an Element can be
asserted.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path core:verifiedUsing ],
        [ sh:datatype xsd:string ;
            sh:description "A short description of an Element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path core:summary ],
        [ sh:class core:CreationInfo ;
            sh:description "Provides information about the creation of the Element." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path core:creationInfo ],
        [ sh:class core:ExternalRef ;
            sh:description """Points to a resource outside the scope of the SPDX-3.0 content
that provides additional characteristics of an Element.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path core:externalRef ] ;
    sh:targetClass core:Agent .

core:Element a sh:NodeShape ;
    rdfs:comment "Base domain class from which all other SPDX-3.0 domain classes derive." ;
    sh:closed false ;
    sh:ignoredProperties ( expandedlicensing:subjectExtendableLicense ai:modelDataPreprocessing core:annotationType ai:informationAboutApplication core:from security:probability software:sbomType software:packageVersion dataset:datasetUpdateMechanism security:decisionType core:context expandedlicensing:isFsfLibre core:dataLicense software:lineRange core:builtTime software:homePage expandedlicensing:subjectLicense expandedlicensing:isDeprecatedAdditionId core:startTime ai:informationAboutTraining build:configSourceDigest security:severity security:score security:exploited security:modifiedTime build:configSourceUri software:sourceInfo build:buildStartTime software:primaryPurpose ai:standardCompliance core:rootElement security:actionStatement core:supportLevel security:withdrawnTime expandedlicensing:standardLicenseTemplate software:fileKind build:environment dataset:hasSensitivePersonalInformation dataset:sensor security:catalogType build:configSourceEntrypoint ai:autonomyType software:byteRange security:vectorString software:packageUrl simplelicensing:licenseExpression expandedlicensing:member expandedlicensing:subjectAddition security:assessedElement rdf:type core:validUntilTime dataset:intendedUse build:buildId software:attributionText security:statusNotes expandedlicensing:isOsiApproved expandedlicensing:seeAlso ai:limitation software:contentIdentifier ai:metricDecisionThreshold ai:energyConsumption core:standardName ai:safetyRiskAssessment core:element dataset:dataCollectionProcess core:completeness core:endTime ai:typeOfModel simplelicensing:licenseListVersion core:import software:copyrightText build:buildType software:downloadLocation expandedlicensing:standardAdditionTemplate security:percentile build:buildEndTime security:publishedTime core:scope software:additionalPurpose dataset:datasetNoise dataset:confidentialityLevel expandedlicensing:isDeprecatedLicenseId core:profileConformance ai:useSensitivePersonalInformation expandedlicensing:deprecatedVersion core:to dataset:datasetSize core:namespaceMap expandedlicensing:obsoletedBy security:justificationType core:originatedBy dataset:anonymizationMethodUsed security:vexVersion security:impactStatement core:statement ai:modelExplainability dataset:dataPreprocessing security:locator build:parameter software:snippetFromFile expandedlicensing:licenseXml expandedlicensing:listVersionAdded dataset:datasetType expandedlicensing:standardLicenseHeader core:subject core:contentType security:actionStatementTime security:impactStatementTime ai:domain dataset:knownBias simplelicensing:customIdToUri ai:hyperparameter dataset:datasetAvailability expandedlicensing:additionText core:releaseTime simplelicensing:licenseText core:relationshipType core:suppliedBy ai:metric ) ;
    sh:property [ sh:class core:ExternalRef ;
            sh:description """Points to a resource outside the scope of the SPDX-3.0 content
that provides additional characteristics of an Element.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path core:externalRef ],
        [ sh:class core:ExternalIdentifier ;
            sh:description """Provides a reference to a resource outside the scope of SPDX-3.0 content
that uniquely identifies an Element.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path core:externalIdentifier ],
        [ sh:class core:CreationInfo ;
            sh:description "Provides information about the creation of the Element." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path core:creationInfo ],
        [ sh:datatype xsd:string ;
            sh:description """Provide consumers with comments by the creator of the Element about the
Element.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path core:comment ],
        [ sh:datatype xsd:string ;
            sh:description "Identifies the name of an Element as designated by the creator." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path core:name ],
        [ sh:datatype xsd:string ;
            sh:description "A short description of an Element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path core:summary ],
        [ sh:class core:IntegrityMethod ;
            sh:description """Provides an IntegrityMethod with which the integrity of an Element can be
asserted.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path core:verifiedUsing ],
        [ sh:class extension:Extension ;
            sh:description "Specifies an Extension characterization of some aspect of an Element." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path core:extension ],
        [ sh:datatype xsd:string ;
            sh:description "Provides a detailed description of the Element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path core:description ] ;
    sh:targetClass core:Element .

core:CreationInfo a sh:NodeShape ;
    rdfs:comment "Provides information about the creation of the Element." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class core:Tool ;
            sh:description "Identifies the tooling that was used during the creation of the Element." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path core:createdUsing ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Identifies when the Element was originally created." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path core:created ;
            sh:pattern "^\\d\\d\\d\\d-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$" ],
        [ sh:class core:Agent ;
            sh:description "Identifies who or what created the Element." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path core:createdBy ],
        [ sh:datatype xsd:string ;
            sh:description """Provides a reference number that can be used to understand how to parse and
interpret an Element.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path core:specVersion ;
            sh:pattern "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$" ],
        [ sh:datatype xsd:string ;
            sh:description """Provide consumers with comments by the creator of the Element about the
Element.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path core:comment ] ;
    sh:targetClass core:CreationInfo .

core:ExternalIdentifier a sh:NodeShape ;
    rdfs:comment "A reference to a resource identifier defined outside the scope of SPDX-3.0 content that uniquely identifies an Element." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "An entity that is authorized to issue identification credentials." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path core:issuingAuthority ],
        [ sh:description "Specifies the type of the external identifier." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:or ( [ sh:in ( <https://spdx.org/rdf/3.0.1/terms/Core/ExternalIdentifierType/cpe22> <https://spdx.org/rdf/3.0.1/terms/Core/ExternalIdentifierType/cpe23> <https://spdx.org/rdf/3.0.1/terms/Core/ExternalIdentifierType/cve> <https://spdx.org/rdf/3.0.1/terms/Core/ExternalIdentifierType/email> <https://spdx.org/rdf/3.0.1/terms/Core/ExternalIdentifierType/gitoid> <https://spdx.org/rdf/3.0.1/terms/Core/ExternalIdentifierType/other> <https://spdx.org/rdf/3.0.1/terms/Core/ExternalIdentifierType/packageUrl> <https://spdx.org/rdf/3.0.1/terms/Core/ExternalIdentifierType/securityOther> <https://spdx.org/rdf/3.0.1/terms/Core/ExternalIdentifierType/swhid> <https://spdx.org/rdf/3.0.1/terms/Core/ExternalIdentifierType/swid> <https://spdx.org/rdf/3.0.1/terms/Core/ExternalIdentifierType/urlScheme> ) ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 1 ;
            sh:path core:externalIdentifierType ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Provides the location for more information regarding an external identifier." ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path core:identifierLocator ],
        [ sh:datatype xsd:string ;
            sh:description """Provide consumers with comments by the creator of the Element about the
Element.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path core:comment ],
        [ sh:datatype xsd:string ;
            sh:description "Uniquely identifies an external element." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path core:identifier ] ;
    sh:targetClass core:ExternalIdentifier .

core:ExternalRef a sh:NodeShape ;
    rdfs:comment "A reference to a resource outside the scope of SPDX-3.0 content related to an Element." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Provides information about the content type of an Element or a Property." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path core:contentType ;
            sh:pattern "^[^\\/]+\\/[^\\/]+$" ],
        [ sh:datatype xsd:string ;
            sh:description """Provide consumers with comments by the creator of the Element about the
Element.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path core:comment ],
        [ sh:description "Specifies the type of the external reference." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:in ( <https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/altDownloadLocation> <https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/altWebPage> <https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/binaryArtifact> <https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/bower> <https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/buildMeta> <https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/buildSystem> <https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/certificationReport> <https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/chat> <https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/componentAnalysisReport> <https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/cwe> <https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/documentation> <https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/dynamicAnalysisReport> <https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/eolNotice> <https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/exportControlAssessment> <https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/funding> <https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/issueTracker> <https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/license> <https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/mailingList> <https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/mavenCentral> <https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/metrics> <https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/npm> <https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/nuget> <https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/other> <https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/privacyAssessment> <https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/productMetadata> <https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/purchaseOrder> <https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/qualityAssessmentReport> <https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/releaseHistory> <https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/releaseNotes> <https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/riskAssessment> <https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/runtimeAnalysisReport> <https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/secureSoftwareAttestation> <https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/securityAdversaryModel> <https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/securityAdvisory> <https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/securityFix> <https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/securityOther> <https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/securityPenTestReport> <https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/securityPolicy> <https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/securityThreatModel> <https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/socialMedia> <https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/sourceArtifact> <https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/staticAnalysisReport> <https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/support> <https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/vcs> <https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/vulnerabilityDisclosureReport> <https://spdx.org/rdf/3.0.1/terms/Core/ExternalRefType/vulnerabilityExploitabilityAssessment> ) ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 1 ;
            sh:path core:externalRefType ],
        [ sh:datatype xsd:string ;
            sh:description "Provides the location of an external reference." ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path core:locator ] ;
    sh:targetClass core:ExternalRef .

extension:Extension a sh:NodeShape ;
    rdfs:comment "A characterization of some aspect of an Element that is associated with the Element in a generalized fashion." ;
    sh:closed false ;
    sh:ignoredProperties ( extension:cdxProperty rdf:type ) ;
    sh:targetClass extension:Extension .

core:IntegrityMethod a sh:NodeShape ;
    rdfs:comment "Provides an independently reproducible mechanism that permits verification of a specific Element." ;
    sh:closed false ;
    sh:ignoredProperties ( core:packageVerificationCodeExcludedFile core:hashValue software:contentIdentifierType core:algorithm rdf:type software:contentIdentifierValue ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Provide consumers with comments by the creator of the Element about the
Element.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path core:comment ] ;
    sh:targetClass core:IntegrityMethod .

