@prefix ai: <https://spdx.org/rdf/3.0.1/terms/AI/> .
@prefix build: <https://spdx.org/rdf/3.0.1/terms/Build/> .
@prefix core: <https://spdx.org/rdf/3.0.1/terms/Core/> .
@prefix dataset: <https://spdx.org/rdf/3.0.1/terms/Dataset/> .
@prefix expandedlicensing: <https://spdx.org/rdf/3.0.1/terms/ExpandedLicensing/> .
@prefix extension: <https://spdx.org/rdf/3.0.1/terms/Extension/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix security: <https://spdx.org/rdf/3.0.1/terms/Security/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix simplelicensing: <https://spdx.org/rdf/3.0.1/terms/SimpleLicensing/> .
@prefix software: <https://spdx.org/rdf/3.0.1/terms/Software/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ai:AIPackage a sh:NodeShape ;
    rdfs:comment "Specifies an AI package and its associated information." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Provide consumers with comments by the creator of the Element about the
Element.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 36 ;
            sh:path core:comment ],
        [ sh:datatype xsd:string ;
            sh:description """Identifies the text of one or more copyright notices for a software Package,
File or Snippet, if any.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path software:copyrightText ],
        [ sh:datatype xsd:anyURI ;
            sh:description """A place for the SPDX document creator to record a website that serves as the
package's home page.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path software:homePage ],
        [ sh:datatype xsd:string ;
            sh:description """Provides a place for the SPDX data creator to record acknowledgement text for
a software Package, File or Snippet.""" ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path software:attributionText ],
        [ sh:class core:DictionaryEntry ;
            sh:description "Records the measurement of prediction quality of the AI model." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path ai:metric ],
        [ sh:class core:Agent ;
            sh:description """Identifies who or what supplied the artifact or VulnAssessmentRelationship
referenced by the Element.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 29 ;
            sh:path core:suppliedBy ],
        [ sh:class software:ContentIdentifier ;
            sh:description """A canonical, unique, immutable identifier of the artifact content, that may be
used for verifying its identity and/or integrity.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 23 ;
            sh:path software:contentIdentifier ],
        [ sh:datatype xsd:string ;
            sh:description "Identifies the name of an Element as designated by the creator." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 39 ;
            sh:path core:name ],
        [ sh:datatype xsd:string ;
            sh:description "Captures a limitation of the AI software." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path ai:limitation ],
        [ sh:class extension:Extension ;
            sh:description "Specifies an Extension characterization of some aspect of an Element." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 33 ;
            sh:path core:extension ],
        [ sh:datatype xsd:string ;
            sh:description """Describes all the preprocessing steps applied to the training data before the
model training.""" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path ai:modelDataPreprocessing ],
        [ sh:class core:DictionaryEntry ;
            sh:description """Records a hyperparameter used to build the AI model contained in the AI
package.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path ai:hyperparameter ],
        [ sh:description "Records the results of general safety risk assessment of the AI system." ;
            sh:in ( <https://spdx.org/rdf/3.0.1/terms/AI/SafetyRiskAssessmentType/high> <https://spdx.org/rdf/3.0.1/terms/AI/SafetyRiskAssessmentType/low> <https://spdx.org/rdf/3.0.1/terms/AI/SafetyRiskAssessmentType/medium> <https://spdx.org/rdf/3.0.1/terms/AI/SafetyRiskAssessmentType/serious> ) ;
            sh:maxCount 1 ;
            sh:order 3 ;
            sh:path ai:safetyRiskAssessment ],
        [ sh:class core:ExternalRef ;
            sh:description """Points to a resource outside the scope of the SPDX-3.0 content
that provides additional characteristics of an Element.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 38 ;
            sh:path core:externalRef ],
        [ sh:datatype xsd:string ;
            sh:description "Captures a standard that is being complied with." ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path ai:standardCompliance ],
        [ sh:datatype xsd:string ;
            sh:description "Captures the domain in which the AI package can be used." ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path ai:domain ],
        [ sh:class ai:EnergyConsumption ;
            sh:description "Indicates the amount of energy consumption incurred by an AI model." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path ai:energyConsumption ],
        [ sh:description """Records if sensitive personal information is used during model training or
could be used during the inference.""" ;
            sh:in ( <https://spdx.org/rdf/3.0.1/terms/Core/PresenceType/no> <https://spdx.org/rdf/3.0.1/terms/Core/PresenceType/noAssertion> <https://spdx.org/rdf/3.0.1/terms/Core/PresenceType/yes> ) ;
            sh:maxCount 1 ;
            sh:order 5 ;
            sh:path ai:useSensitivePersonalInformation ],
        [ sh:description """Indicates whether the system can perform a decision or action without human
involvement or guidance.""" ;
            sh:in ( <https://spdx.org/rdf/3.0.1/terms/Core/PresenceType/no> <https://spdx.org/rdf/3.0.1/terms/Core/PresenceType/noAssertion> <https://spdx.org/rdf/3.0.1/terms/Core/PresenceType/yes> ) ;
            sh:maxCount 1 ;
            sh:order 9 ;
            sh:path ai:autonomyType ],
        [ sh:datatype xsd:string ;
            sh:description "A short description of an Element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 34 ;
            sh:path core:summary ],
        [ sh:description "Specifies the level of support associated with an artifact." ;
            sh:in ( <https://spdx.org/rdf/3.0.1/terms/Core/SupportType/deployed> <https://spdx.org/rdf/3.0.1/terms/Core/SupportType/development> <https://spdx.org/rdf/3.0.1/terms/Core/SupportType/endOfSupport> <https://spdx.org/rdf/3.0.1/terms/Core/SupportType/limitedSupport> <https://spdx.org/rdf/3.0.1/terms/Core/SupportType/noAssertion> <https://spdx.org/rdf/3.0.1/terms/Core/SupportType/noSupport> <https://spdx.org/rdf/3.0.1/terms/Core/SupportType/support> ) ;
            sh:order 28 ;
            sh:path core:supportLevel ],
        [ sh:description "Provides additional purpose information of the software artifact." ;
            sh:or ( [ sh:in ( <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/application> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/archive> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/bom> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/configuration> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/container> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/data> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/device> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/deviceDriver> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/diskImage> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/documentation> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/evidence> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/executable> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/file> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/filesystemImage> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/firmware> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/framework> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/install> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/library> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/manifest> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/model> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/module> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/operatingSystem> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/other> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/patch> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/platform> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/requirement> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/source> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/specification> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/test> ) ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 22 ;
            sh:path software:additionalPurpose ],
        [ sh:class core:CreationInfo ;
            sh:description "Provides information about the creation of the Element." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 40 ;
            sh:path core:creationInfo ],
        [ sh:datatype xsd:string ;
            sh:description """Records any relevant background information or additional comments
about the origin of the package.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path software:sourceInfo ],
        [ sh:class core:IntegrityMethod ;
            sh:description """Provides an IntegrityMethod with which the integrity of an Element can be
asserted.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 37 ;
            sh:path core:verifiedUsing ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Specifies the time an artifact was built." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 26 ;
            sh:path core:builtTime ;
            sh:pattern "^\\d\\d\\d\\d-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$" ],
        [ sh:datatype xsd:string ;
            sh:description "Describes relevant information about different steps of the training process." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path ai:informationAboutTraining ],
        [ sh:class core:DictionaryEntry ;
            sh:description """Captures the threshold that was used for computation of a metric described in
the metric field.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path ai:metricDecisionThreshold ],
        [ sh:datatype xsd:dateTime ;
            sh:description """Specifies until when the artifact can be used before its usage needs to be
reassessed.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 27 ;
            sh:path core:validUntilTime ;
            sh:pattern "^\\d\\d\\d\\d-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$" ],
        [ sh:class core:ExternalIdentifier ;
            sh:description """Provides a reference to a resource outside the scope of SPDX-3.0 content
that uniquely identifies an Element.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 32 ;
            sh:path core:externalIdentifier ],
        [ sh:description "Provides information about the primary purpose of the software artifact." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:in ( <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/application> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/archive> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/bom> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/configuration> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/container> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/data> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/device> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/deviceDriver> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/diskImage> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/documentation> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/evidence> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/executable> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/file> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/filesystemImage> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/firmware> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/framework> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/install> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/library> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/manifest> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/model> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/module> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/operatingSystem> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/other> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/patch> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/platform> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/requirement> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/source> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/specification> <https://spdx.org/rdf/3.0.1/terms/Software/SoftwarePurpose/test> ) ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 21 ;
            sh:path software:primaryPurpose ],
        [ sh:class core:Agent ;
            sh:description "Identifies from where or whom the Element originally came." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 30 ;
            sh:path core:originatedBy ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Specifies the time an artifact was released." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 31 ;
            sh:path core:releaseTime ;
            sh:pattern "^\\d\\d\\d\\d-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$" ],
        [ sh:datatype xsd:string ;
            sh:description "The name of a relevant standard that may apply to an artifact." ;
            sh:nodeKind sh:Literal ;
            sh:order 25 ;
            sh:path core:standardName ],
        [ sh:datatype xsd:string ;
            sh:description "Records the type of the model used in the AI software." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path ai:typeOfModel ],
        [ sh:datatype xsd:string ;
            sh:description "Provides a detailed description of the Element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 35 ;
            sh:path core:description ],
        [ sh:datatype xsd:string ;
            sh:description "Identify the version of a package." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path software:packageVersion ],
        [ sh:datatype xsd:string ;
            sh:description "Describes methods that can be used to explain the results from the AI model." ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path ai:modelExplainability ],
        [ sh:datatype xsd:string ;
            sh:description """Provides relevant information about the AI software, not including the model
description.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path ai:informationAboutApplication ],
        [ sh:datatype xsd:anyURI ;
            sh:description """Identifies the download Uniform Resource Identifier for the package at the time
that the document was created.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path software:downloadLocation ],
        [ sh:datatype xsd:anyURI ;
            sh:description """Provides a place for the SPDX data creator to record the package URL string
(in accordance with the Package URL specification) for a software Package.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path software:packageUrl ] ;
    sh:targetClass ai:AIPackage .

build:Build a sh:NodeShape ;
    rdfs:comment "Class that describes a build instance of software/artifacts." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:anyURI ;
            sh:description "Property that describes the URI of the build configuration source file." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path build:configSourceUri ],
        [ sh:class core:ExternalRef ;
            sh:description """Points to a resource outside the scope of the SPDX-3.0 content
that provides additional characteristics of an Element.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path core:externalRef ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Property that describes the time at which a build stops." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path build:buildEndTime ;
            sh:pattern "^\\d\\d\\d\\d-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$" ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Property describing the start time of a build." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path build:buildStartTime ;
            sh:pattern "^\\d\\d\\d\\d-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$" ],
        [ sh:class extension:Extension ;
            sh:description "Specifies an Extension characterization of some aspect of an Element." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path core:extension ],
        [ sh:datatype xsd:string ;
            sh:description "Identifies the name of an Element as designated by the creator." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path core:name ],
        [ sh:datatype xsd:string ;
            sh:description "Property describes the invocation entrypoint of a build." ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path build:configSourceEntrypoint ],
        [ sh:datatype xsd:string ;
            sh:description """Provide consumers with comments by the creator of the Element about the
Element.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path core:comment ],
        [ sh:class core:Hash ;
            sh:description """Property that describes the digest of the build configuration file used to
invoke a build.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path build:configSourceDigest ],
        [ sh:class core:CreationInfo ;
            sh:description "Provides information about the creation of the Element." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path core:creationInfo ],
        [ sh:datatype xsd:string ;
            sh:description "A short description of an Element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path core:summary ],
        [ sh:datatype xsd:string ;
            sh:description """A buildId is a locally unique identifier used by a builder to identify a unique
instance of a build produced by it.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path build:buildId ],
        [ sh:class core:IntegrityMethod ;
            sh:description """Provides an IntegrityMethod with which the integrity of an Element can be
asserted.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path core:verifiedUsing ],
        [ sh:class core:DictionaryEntry ;
            sh:description "Property describing the session in which a build is invoked." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path build:environment ],
        [ sh:datatype xsd:string ;
            sh:description "Provides a detailed description of the Element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path core:description ],
        [ sh:class core:DictionaryEntry ;
            sh:description "Property describing a parameter used in an instance of a build." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path build:parameter ],
        [ sh:datatype xsd:anyURI ;
            sh:description """A buildType is a hint that is used to indicate the toolchain, platform, or
infrastructure that the build was invoked on.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path build:buildType ],
        [ sh:class core:ExternalIdentifier ;
            sh:description """Provides a reference to a resource outside the scope of SPDX-3.0 content
that uniquely identifies an Element.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path core:externalIdentifier ] ;
    sh:targetClass build:Build .

core:Annotation a sh:NodeShape ;
    rdfs:comment "An assertion made in relation to one or more elements." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Provide consumers with comments by the creator of the Element about the
Element.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path core:comment ],
        [ sh:datatype xsd:string ;
            sh:description "Identifies the name of an Element as designated by the creator." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path core:name ],
        [ sh:datatype xsd:string ;
            sh:description "Commentary on an assertion that an annotator has made." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path core:statement ],
        [ sh:class extension:Extension ;
            sh:description "Specifies an Extension characterization of some aspect of an Element." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path core:extension ],
        [ sh:datatype xsd:string ;
            sh:description "Provides information about the content type of an Element or a Property." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path core:contentType ;
            sh:pattern "^[^\\/]+\\/[^\\/]+$" ],
        [ sh:class core:CreationInfo ;
            sh:description "Provides information about the creation of the Element." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path core:creationInfo ],
        [ sh:datatype xsd:string ;
            sh:description "A short description of an Element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path core:summary ],
        [ sh:class core:Element ;
            sh:description "An Element an annotator has made an assertion about." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path core:subject ],
        [ sh:class core:ExternalIdentifier ;
            sh:description """Provides a reference to a resource outside the scope of SPDX-3.0 content
that uniquely identifies an Element.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path core:externalIdentifier ],
        [ sh:class core:IntegrityMethod ;
            sh:description """Provides an IntegrityMethod with which the integrity of an Element can be
asserted.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path core:verifiedUsing ],
        [ sh:description "Describes the type of annotation." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:or ( [ sh:in ( <https://spdx.org/rdf/3.0.1/terms/Core/AnnotationType/other> <https://spdx.org/rdf/3.0.1/terms/Core/AnnotationType/review> ) ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 3 ;
            sh:path core:annotationType ],
        [ sh:datatype xsd:string ;
            sh:description "Provides a detailed description of the Element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path core:description ],
